# Lo que Godot vuelve a crear solo (caché de importación)
.godot/
# Lo que crea Godot al exportar
/exportar/*
!/exportar/.gdignore
# Fotos de prueba sacadas con --captura (scripts/pruebas/captura.gd): van a capturas/. Solo va en git su .gdignore,
# para que Godot no las importe como si fueran dibujos del juego
capturas/*
!capturas/.gdignore
# (las que quedaron en la raíz de antes)
captura*.png
captura*.png.import
# Python
__pycache__/
# Los efectos de sonido grabados para escucharlos (tools/probar_sonido.gd)
tools/efectos/
# La foto de tools/ver_dibujos.tscn
tools/dibujos.png
tools/dibujos.png.import
tools/objetos16.png
tools/objetos16.png.import
# La web exportada: la exporta y publica GitHub en cada push (.github/workflows/web.yml). Solo va en git el
# .gdignore, para que el editor no importe lo que se exporte aquí para probar
web/*
!web/.gdignore
# Lo que crea la herramienta de Vercel
.vercel/
