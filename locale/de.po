msgstr "Verdoppelt die Nahkampfreichweite"

#: scripts/talentos.gd
msgid "Mirilla"
msgstr "Visier"

#: scripts/talentos.gd
msgid "Uno de cada 3 disparos es un crítico seguro (doble daño)"
msgstr "Jeder 3. Schuss ist sicher kritisch (doppelter Schaden)"

#: scripts/talentos.gd
msgid "Fabricante"
msgstr "Bombenbauer"

#: scripts/talentos.gd
msgid "Fuego y explosiones más grandes, y el fuego dura más"
msgstr "Größere Flammen und Explosionen, und das Feuer brennt länger"

#: scripts/talentos.gd
msgid "Frenesí"
msgstr "Raserei"

#: scripts/talentos.gd
msgid "Golpeas cuerpo a cuerpo un 10 % más rápido por punto"
msgstr "Im Nahkampf schlägst du pro Punkt 10 % schneller zu"

#: scripts/talentos.gd
msgid "Gatillo fácil"
msgstr "Schießwütig"

#: scripts/talentos.gd
msgid "Disparas un 10 % más rápido y recargas un 10 % antes por punto"
msgstr "Du schießt 10 % schneller und lädst 10 % schneller nach, pro Punkt"

