msgid "¡Gracias! ¡Sácame de aquí!"
msgstr "Danke! Hol mich hier raus!"

#: scripts/supervivientes.gd
msgid "¡%s se une al equipo! %s"
msgstr "Neu im Team: %s! %s"

#: scripts/supervivientes.gd
msgid "¡Gracias! Sigo con la cerradura"
msgstr "Danke! Weiter mit dem Schloss"

#: scripts/supervivientes.gd
msgid "¡La puerta se ha cerrado! Aguanta mientras %s fuerza la cerradura"
msgstr "Die Tür ist zu! Halte durch: %s knackt das Schloss"

#: scripts/supervivientes.gd
msgid "¡YA ESTÁ! ¡CORRE!"
msgstr "GESCHAFFT! LAUF!"

#: scripts/supervivientes.gd
msgid "¡Puerta abierta! Salid de aquí"
msgstr "Tür offen! Raus hier"

#: scripts/supervivientes.gd
msgid "%s te acompaña · %s"
msgstr "Begleitet dich: %s · %s"

#: scripts/supervivientes.gd
msgctxt "superviviente"
msgid "¡%s ha caído!"
msgstr "%s am Boden!"

#: scripts/supervivientes.gd
msgid "%s fuerza la cerradura · %d:%02d"
msgstr "%s knackt das Schloss · %d:%02d"

#: scripts/supervivientes.gd
msgid "Policía"
msgstr "Polizist"

#: scripts/supervivientes.gd
msgid "Dispara con su pistola cada 0,8 s"
msgstr "Schießt alle 0,8 s mit der Pistole"

#: scripts/supervivientes.gd
msgid "Médica"
msgstr "Ärztin"

#: scripts/supervivientes.gd
msgid "Te cura 5 cada 6 s y 10 al limpiar cada piso"
msgstr "Heilt dich alle 6 s um 5 und um 10 für jede gesäuberte Wohnung"

#: scripts/supervivientes.gd
msgid "Lanza ráfagas de 3 balas cada 2,5 s"
msgstr "Feuert alle 2,5 s Salven mit 3 Schuss"

#: scripts/supervivientes.gd
msgid "Ferretero"
msgstr "Handwerker"

#: scripts/supervivientes.gd
msgid "¡Estoy en el almacén!"
msgstr "Ich bin im Lager!"

#: scripts/supervivientes.gd
msgid "¡Aquí dentro!"
msgstr "Hier drin!"

#: scripts/supervivientes.gd
msgid "¡He atrancado la puerta!"
msgstr "Ich hab die Tür verrammelt!"

#: scripts/supervivientes.gd
msgid "¡Que alguien me oiga!"
msgstr "Hört mich jemand?!"

#: scripts/supervivientes.gd
msgid "¡Fuera tablas! Gracias, chaval. Vámonos de aquí"
msgstr "Bretter weg! Danke, Junge. Nichts wie raus hier"

#: scripts/supervivientes.gd
msgid "Va a por los zombis que ve y les da martillazos (8 de daño)"
msgstr "Geht auf Zombies in Sicht los und haut mit dem Hammer zu (8 Schaden)"

#: scripts/supervivientes.gd
msgid "Farmacéutica"
msgstr "Apothekerin"

#: scripts/supervivientes.gd
msgid "¡Estoy en la rebotica!"
msgstr "Ich bin im Hinterzimmer!"

#: scripts/supervivientes.gd
msgid "¡Estoy herida!"
msgstr "Ich bin verletzt!"

#: scripts/supervivientes.gd
msgid "¡Ayuda, por favor!"
msgstr "Hilfe, bitte!"

#: scripts/supervivientes.gd
msgid "¡Aquí detrás!"
msgstr "Hier hinten!"

#: scripts/supervivientes.gd
msgid "¡Me han mordido la pierna! No puedo correr"
msgstr "Mein Bein ist zerbissen! Ich kann nicht rennen"

#: scripts/supervivientes.gd
msgid "Los charcos de veneno y ácido te hacen la mitad"
msgstr "Gift- und Säurepfützen machen dir nur halben Schaden"

#: scripts/supervivientes.gd
msgid "Cada partida empiezas con un botiquín en la mochila"
msgstr "Du startest jede Runde mit einem Medikit im Rucksack"

#: scripts/supervivientes.gd
msgid "Técnico"
msgstr "Techniker"

#: scripts/supervivientes.gd
msgid "¡No toquéis el agua!"
msgstr "Nicht ins Wasser!"

#: scripts/supervivientes.gd
msgid "¡Que alguien me saque!"
msgstr "Holt mich hier raus!"

#: scripts/supervivientes.gd
msgid "¡Gracias! Antes de irnos tengo que arreglar ese cable pelado"
msgstr "Danke! Bevor wir gehen, muss ich das blanke Kabel da flicken"

#: scripts/supervivientes.gd
msgid "Cada 3 s, una descarga deja quieto 1,5 s al zombi más cercano"
msgstr "Alle 3 s lähmt ein Stromstoß den nächsten Zombie für 1,5 s"

#: scripts/supervivientes.gd
msgid "Arregla las cámaras de seguridad: el minimapa enseña los zombis"
msgstr "Repariert die Überwachungskameras: Die Minikarte zeigt die Zombies"

#: scripts/supervivientes.gd
msgid "¡Estoy en el baño!"
msgstr "Ich bin im Bad!"

#: scripts/supervivientes.gd
msgid "¡Está atascada! ¡Cúbreme!"
msgstr "Klemmt! Gib mir Deckung!"

#: scripts/supervivientes.gd
msgid "Esta cerradura está oxidada… dame tiempo"
msgstr "Das Schloss ist verrostet… gib mir Zeit"

#: scripts/supervivientes.gd
msgid "Vale… creo que ya noto el muelle"
msgstr "Okay… ich glaub, ich spür die Feder"

#: scripts/supervivientes.gd
msgid "¡Toma, he encontrado esto!"
msgstr "Hier, das hab ich gefunden!"

#: scripts/supervivientes.gd
msgid "¡Se me ha caído la horquilla!… vale, ya la tengo"
msgstr "Haarnadel runtergefallen!… okay, hab sie"

#: scripts/supervivientes.gd
msgid "Ya casi lo tengo…"
msgstr "Gleich hab ich's…"

#: scripts/supervivientes.gd
msgid "el salón"
msgstr "das Wohnzimmer"

#: scripts/supervivientes.gd
msgid "la cocina"
msgstr "die Küche"

#: scripts/supervivientes.gd
msgid "el dormitorio"
msgstr "das Schlafzimmer"

#: scripts/supervivientes.gd
msgid "el baño"
msgstr "das Bad"

#: scripts/supervivientes.gd
msgid "el pasillo"
msgstr "den Flur"

#: scripts/supervivientes.gd
msgid "la tienda"
msgstr "den Laden"

#: scripts/supervivientes.gd
msgid "el almacén"
msgstr "das Lager"

#: scripts/supervivientes.gd
msgid "la cámara"
msgstr "den Kühlraum"

#: scripts/supervivientes.gd
msgid "el taller"
msgstr "die Werkstatt"

#: scripts/supervivientes.gd
msgid "las taquillas"
msgstr "den Spindraum"

#: scripts/supervivientes.gd
msgid "los probadores"
msgstr "die Anprobe"

#: scripts/supervivientes.gd
msgid "la rebotica"
msgstr "das Hinterzimmer"

