msgstr "+%s %% Schaden und Reichweite"

#: scripts/talentos.gd
msgid "+%s %% cuerpo a cuerpo"
msgstr "+%s %% Nahkampf"

#: scripts/talentos.gd
msgid "+%s %% a distancia"
msgstr "+%s %% Fernkampf"

#: scripts/talentos.gd
msgid "+%d en cada montón de lanzables"
