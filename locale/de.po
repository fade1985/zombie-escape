msgstr "Assistiert"

#: scripts/johnny.gd
msgid "Apuntar libre"
msgstr "Freies Zielen"

#: scripts/joyeria.gd
msgid "Has cogido la tarjeta dorada: abre la cámara acorazada de la Joyería"
msgstr "Du hast die goldene Karte: Sie öffnet den Tresorraum beim Juwelier"

#: scripts/joyeria.gd
msgid "¡Clac! Se acabó la cuenta: la cámara acorazada se ha abierto"
msgstr "Klack! Die Zeit ist um: Der Tresorraum ist offen"

#: scripts/joyeria.gd
msgid "Abres la cámara acorazada con la tarjeta dorada"
msgstr "Du öffnest den Tresorraum mit der goldenen Karte"

#: scripts/joyeria.gd
msgid "Aguanta: la cámara se abre en %d segundo"
msgid_plural "Aguanta: la cámara se abre en %d segundos"
msgstr[0] "Halte durch: Der Tresor geht in %d Sekunde auf"
msgstr[1] "Halte durch: Der Tresor geht in %d Sekunden auf"

#: scripts/joyeria.gd
msgid "Lector de tarjetas. Sin la tarjeta dorada del guardia solo queda la apertura de emergencia: vuelve a arrimarte para disparar la alarma"
msgstr "Kartenleser. Ohne die goldene Karte des Wächters bleibt nur die Notöffnung: Geh noch mal ran, um den Alarm auszulösen"

#: scripts/joyeria.gd
msgid "¡ALARMA!"
msgstr "ALARM!"

#: scripts/joyeria.gd
msgid "Apertura de emergencia: la cámara se abre en %d segundos. ¡Aguanta!"
msgstr "Notöffnung: Der Tresor geht in %d Sekunden auf. Halte durch!"

#: scripts/joyeria.gd
msgid "¡Has disparado la alarma! Vienen a por ti: aguanta %d segundos sin salir de la joyería"
msgstr "Du hast den Alarm ausgelöst! Sie kommen dich holen: Halte %d Sekunden durch, ohne den Juwelier zu verlassen"

#: scripts/joyeria.gd
msgid "¡%s! Ya la llevas en la mano. Y un fajo de billetes: +$%d"
msgstr "%s! Jetzt in deiner Hand. Dazu ein Bündel Scheine: +$%d"

#: scripts/joyeria.gd
msgid "¡%s! Ya la llevas en la mano; %s se queda en el suelo. Y un fajo de billetes: +$%d"
msgstr "%s! Jetzt in deiner Hand; %s bleibt am Boden. Dazu ein Bündel Scheine: +$%d"

#: scripts/joyeria.gd
msgid "Apertura de emergencia · %d:%02d"
msgstr "Notöffnung · %d:%02d"

