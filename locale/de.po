#: scripts/armas.gd scripts/objetos.gd
msgid "Bidón de ácido"
msgstr "Säurefass"

#: scripts/armas.gd
msgid "¡Sin ácido!"
msgstr "Keine Säure!"

#: scripts/armas.gd
msgid "el lanza ácido"
