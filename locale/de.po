msgstr "Bring eine Waffe oder Wurfwaffe an der Werkbank auf Episch."

#: scripts/logros.gd
msgid "Arsenal completo"
msgstr "Volles Arsenal"

#: scripts/logros.gd
msgid "Mata un zombi con cada arma: la fregona y todas las de la tienda."
msgstr "Erledige einen Zombie mit jeder Waffe: dem Mopp und allen aus dem Waffenladen."

#: scripts/logros.gd
msgid "Especialista"
msgstr "Spezialist"

#: scripts/logros.gd
msgid "Llena una rama entera del árbol de talentos."
msgstr "Füll einen ganzen Zweig des Talentbaums."

#: scripts/logros.gd
msgid "Conserje total"
msgstr "Hausmeister pur"

#: scripts/logros.gd
msgid "Llena el árbol de talentos entero."
msgstr "Füll den ganzen Talentbaum."

#: scripts/logros.gd
msgid "Buen vecino"
msgstr "Guter Nachbar"

#: scripts/logros.gd
msgid "Rescata a un superviviente: aguanta la horda mientras fuerza la cerradura."
msgstr "Rette einen Überlebenden: Halte die Horde auf, während das Schloss geknackt wird."

#: scripts/logros.gd
msgid "Comunidad de vecinos"
msgstr "Hausgemeinschaft"

#: scripts/logros.gd
msgid "Rescata a los 3 supervivientes de los Apartamentos."
msgstr "Rette die 3 Überlebenden im Mietshaus."

#: scripts/logros.gd
msgid "Plantilla completa"
msgstr "Volle Belegschaft"

#: scripts/logros.gd
