#: scripts/talentos.gd
msgid "+%s %% con ácido"
msgstr "+%s %% mit Säure"

#: scripts/talentos.gd
msgid "+%s s congelados"
msgstr "+%s s eingefroren"

#: scripts/talentos.gd
msgid "+%s %% de rapidez cuerpo a cuerpo"
msgstr "+%s %% Nahkampftempo"

#: scripts/talentos.gd
msgid "+%s %% de rapidez y recarga"
msgstr "+%s %% Feuer- und Nachladetempo"

#: scripts/talentos.gd
msgid "suelta %d más"
msgstr "verteilt %d mehr"

#: scripts/talentos.gd
msgid "escudo de %d"
msgstr "Schild von %d"

#: scripts/talentos.gd
msgid "esquiva un %s %% antes"
msgstr "Ausweichen %s %% früher"

#: scripts/talentos.gd
msgid "+%d de vida por planta"
msgstr "+%d Leben pro Stock"

#: scripts/talentos.gd
msgid "+%s s de fuego"
msgstr "+%s s Feuer"

#: scripts/talentos.gd
msgid "%s %% más lentos con ácido"
msgstr "%s %% langsamer mit Säure"

#: scripts/talentos.gd
msgid "salta a %d más"
msgstr "springt auf %d mehr"

#: scripts/talentos.gd
msgid "Militar"
msgstr "Militär"

#: scripts/talentos.gd
msgid "Superviviente"
msgstr "Überlebender"

#: scripts/talentos.gd
msgid "Químico"
msgstr "Chemiker"

#: scripts/talentos.gd
msgid "Ataque"
msgstr "Angriff"

#: scripts/talentos.gd
msgid "+5 % de daño por punto"
msgstr "+5 % Schaden pro Punkt"

#: scripts/talentos.gd
msgid "Puntería"
msgstr "Zielen"

#: scripts/talentos.gd
msgid "+5 % de daño y de alcance al utilizar un lanzable por punto"
msgstr "+5 % Schaden und Reichweite beim Einsatz einer Wurfwaffe pro Punkt"

#: scripts/talentos.gd
msgid "Camorrista"
msgstr "Raufbold"

#: scripts/talentos.gd
msgid "+5 % de daño cuerpo a cuerpo por punto"
msgstr "+5 % Nahkampfschaden pro Punkt"

#: scripts/talentos.gd
msgid "Tirador"
msgstr "Schütze"

#: scripts/talentos.gd
msgid "+5 % de daño con armas a distancia por punto"
msgstr "+5 % Schaden mit Fernkampfwaffen pro Punkt"

#: scripts/talentos.gd
msgid "Artificiero"
msgstr "Feuerwerker"

#: scripts/talentos.gd
msgid "+1 lanzable en cada montón por punto"
msgstr "+1 Wurfwaffe in jedem Stapel pro Punkt"

#: scripts/talentos.gd
msgid "Larguirucho"
msgstr "Lulatsch"

#: scripts/talentos.gd
msgid "Aumenta un 50 % el alcance cuerpo a cuerpo"
msgstr "Erhöht die Nahkampfreichweite um 50 %"

#: scripts/talentos.gd
msgid "Mirilla"
msgstr "Visier"

#: scripts/talentos.gd
msgid "Uno de cada 6 disparos es un crítico seguro (doble daño)"
msgstr "Jeder 6. Schuss ist sicher kritisch (doppelter Schaden)"

#: scripts/talentos.gd
msgid "Fabricante"
msgstr "Bombenbauer"

#: scripts/talentos.gd
msgid "Fuego y explosiones más grandes, y el fuego dura más"
msgstr "Größere Flammen und Explosionen, und das Feuer brennt länger"

#: scripts/talentos.gd
msgid "Frenesí"
msgstr "Raserei"

#: scripts/talentos.gd
msgid "Golpeas cuerpo a cuerpo un 5 % más rápido por punto"
msgstr "Im Nahkampf schlägst du pro Punkt 5 % schneller zu"

#: scripts/talentos.gd
msgid "Gatillo fácil"
msgstr "Schießwütig"

#: scripts/talentos.gd
msgid "Disparas un 5 % más rápido y recargas un 5 % antes por punto"
msgstr "Du schießt 5 % schneller und lädst 5 % schneller nach, pro Punkt"

#: scripts/talentos.gd
msgid "Racimo"
msgstr "Splitter"

#: scripts/talentos.gd
msgid "Los lanzables sueltan 1 más pequeño alrededor por punto"
msgstr "Wurfwaffen werfen pro Punkt 1 kleinen Ableger ringsum ab"

#: scripts/talentos.gd
msgid "Veterano"
msgstr "Veteran"

#: scripts/talentos.gd
msgid "Críticos del 5 % al 10 % de las veces, y cada uno hace 2,5 veces el daño"
msgstr "Kritische Treffer in 10 % statt 5 % der Fälle, und jeder macht 2,5-fachen Schaden"

#: scripts/talentos.gd
msgid "Corpulento"
msgstr "Stämmig"

#: scripts/talentos.gd
msgid "+5 % de vida máxima por punto"
msgstr "+5 % maximales Leben pro Punkt"

#: scripts/talentos.gd
msgid "Ajolote"
msgstr "Axolotl"

#: scripts/talentos.gd
msgid "Regeneras 1 de vida cada 10 segundos por punto, hasta la mitad de tu vida"
msgstr "Du regenerierst pro Punkt 1 Leben alle 10 Sekunden, bis zur Hälfte deines Lebens"

#: scripts/talentos.gd
msgid "Durito"
msgstr "Dickfell"

#: scripts/talentos.gd
msgid "Cada golpe que recibes quita 2 menos por punto"
msgstr "Jeder Treffer gegen dich zieht pro Punkt 2 weniger ab"

#: scripts/talentos.gd
msgid "Reflejos"
msgstr "Reflexe"

#: scripts/talentos.gd
msgid "Esquivas el próximo golpe que vayas a recibir cada 10 s (0,5 s menos por cada punto más)"
msgstr "Alle 10 s weichst du dem nächsten Treffer von selbst aus (0,5 s weniger pro Extrapunkt)"

#: scripts/talentos.gd
msgid "Sanitario"
msgstr "Sanitäter"

#: scripts/talentos.gd
msgid "Los botiquines y las vendas curan 5 más por punto"
msgstr "Medikits und Verbände heilen pro Punkt 5 mehr"

#: scripts/talentos.gd
msgid "Acero"
msgstr "Stahl"

#: scripts/talentos.gd
msgid "Cada planta, un escudo de 25 que se gasta antes que la vida"
msgstr "Auf jedem Stock ein Schild von 25, der vor dem Leben verbraucht wird"

#: scripts/talentos.gd
msgid "Ninja"
msgstr "Ninja"

#: scripts/talentos.gd
msgid "Al acabar una esquiva, golpe en área que mata a los durmientes (como mucho cada 5 s)"
msgstr "Nach dem Ausweichen ein Flächenschlag, der Schläfer tötet (höchstens alle 5 s)"

#: scripts/talentos.gd
msgid "Desfibrilador"
msgstr "Defibrillator"

#: scripts/talentos.gd
msgid "Una vez por edificio, si caes, resucitas con la mitad de la vida"
msgstr "Einmal pro Gebäude: Fällst du, stehst du mit halbem Leben wieder auf"

#: scripts/talentos.gd
msgid "Blindaje"
msgstr "Panzerung"

#: scripts/talentos.gd
msgid "El escudo de Acero tiene 5 más por punto"
msgstr "Der Schild von Stahl hat pro Punkt 5 mehr"

#: scripts/talentos.gd
msgid "Sombra"
msgstr "Schatten"

#: scripts/talentos.gd
msgid "La esquiva se recarga un 7,5 % antes por punto"
msgstr "Ausweichen lädt pro Punkt 7,5 % schneller auf"

#: scripts/talentos.gd
msgid "Segundo aliento"
msgstr "Zweite Luft"

#: scripts/talentos.gd
msgid "Una vez por planta, al bajar de un tercio de la vida, te curas 7 por punto"
msgstr "Einmal pro Stock: Fällst du unter ein Drittel Leben, heilst du dich um 7 pro Punkt"

#: scripts/talentos.gd
msgid "Adrenalina"
msgstr "Adrenalin"

#: scripts/talentos.gd
msgid "Por debajo de la mitad de la vida, +15 % de daño y +10 % de velocidad"
msgstr "Unter halbem Leben +15 % Schaden und +10 % Tempo"

#: scripts/talentos.gd
msgid "Catalizador"
msgstr "Katalysator"

#: scripts/talentos.gd
msgid "+5 % de daño de fuego, ácido, rayo y frío por punto"
msgstr "+5 % Feuer-, Säure-, Blitz- und Kälteschaden pro Punkt"

#: scripts/talentos.gd
msgid "Guantes de goma"
msgstr "Gummihandschuhe"

#: scripts/talentos.gd
msgid "Fuego, ácido, venenos y frío te hacen un 5 % menos por punto"
msgstr "Feuer, Säure, Gift und Kälte machen dir pro Punkt 5 % weniger"

#: scripts/talentos.gd
msgid "Incendiario"
msgstr "Brandstifter"

#: scripts/talentos.gd
msgid "Los durmientes que prendes arden 0,25 s más por punto"
msgstr "Schläfer, die du anzündest, brennen pro Punkt 0,25 s länger"

#: scripts/talentos.gd
msgid "Desatascador"
msgstr "Rohrreiniger"

#: scripts/talentos.gd
msgid "Con ácido encima, todo les quita un 5 % más por punto"
msgstr "Schläfer mit Säure nehmen pro Punkt 5 % mehr Schaden"

#: scripts/talentos.gd
msgid "Criogenia"
msgstr "Kryogenik"

#: scripts/talentos.gd
msgid "Congelan 0,25 s más por punto"
msgstr "Eisbomben frieren pro Punkt 0,25 s länger ein"

#: scripts/talentos.gd
msgid "Reacción en cadena"
msgstr "Kettenreaktion"

#: scripts/talentos.gd
msgid "Los durmientes que mueren ardiendo revientan y prenden a los de al lado"
msgstr "Schläfer, die brennend sterben, platzen und zünden ihre Nachbarn an"

#: scripts/talentos.gd
msgid "Residuo tóxico"
msgstr "Giftmüll"

#: scripts/talentos.gd
msgid "Los durmientes que mueren con ácido dejan un charco de ácido que afecta a todos"
msgstr "Schläfer, die mit Säure sterben, hinterlassen eine Säurepfütze, die allen schadet"

#: scripts/talentos.gd
msgid "Pararrayos"
msgstr "Blitzableiter"

#: scripts/talentos.gd
msgid "Al durmiente que te golpea le salta un rayo que lo aturde y pasa a otro (como mucho cada 3 s)"
msgstr "Wer dich schlägt, kriegt einen Blitz ab, der betäubt und weiterspringt (höchstens alle 3 s)"

#: scripts/talentos.gd
msgid "Napalm"
msgstr "Napalm"

#: scripts/talentos.gd
msgid "El fuego del molotov dura 0,5 s más por punto"
msgstr "Das Feuer des Molotows brennt pro Punkt 0,5 s länger"

#: scripts/talentos.gd
msgid "Pegajoso"
msgstr "Klebrig"

#: scripts/talentos.gd
msgid "Los durmientes con ácido van un 5 % más lentos por punto"
msgstr "Schläfer mit Säure sind pro Punkt 5 % langsamer"

#: scripts/talentos.gd
msgid "Alto voltaje"
msgstr "Hochspannung"

#: scripts/talentos.gd
msgid "El rayo del lanza rayos y el de Pararrayos saltan a 1 durmiente más por punto"
msgstr "Die Blitze von Blitzwerfer und Blitzableiter springen pro Punkt auf 1 Schläfer mehr über"

#: scripts/talentos.gd
msgid "Mezcla explosiva"
msgstr "Explosive Mischung"

#: scripts/talentos.gd
msgid "Los durmientes que mueren con dos efectos a la vez (fuego, ácido, rayo o frío) explotan"
msgstr "Schläfer, die mit zwei Effekten zugleich sterben (Feuer, Säure, Blitz oder Kälte), explodieren"

#: scripts/tornos.gd
msgid "¡Se han cerrado las puertas! Protege a la %s mientras abre los tornos"
msgstr "Die Türen sind zu! Beschütze die %s, während sie die Drehkreuze öffnet"

#: scripts/tornos.gd
msgid "¡Gracias! Sigo con los tornos"
msgstr "Danke! Weiter mit den Drehkreuzen"

#: scripts/tornos.gd
msgid "¡Abiertos! Ya podemos subir"
msgstr "Offen! Jetzt können wir hoch"

#: scripts/tornos.gd
msgid "¡La %s ha abierto los tornos!"
msgstr "Die %s hat die Drehkreuze geöffnet!"

#: scripts/tornos.gd
msgid "Aguanta: la %s está abriendo los tornos"
msgstr "Halte durch: Die %s öffnet die Drehkreuze"

#: scripts/tornos.gd
msgid "La %s abre los tornos · %d:%02d"
msgstr "Die %s öffnet die Drehkreuze · %d:%02d"

#: scripts/tornos.gd
msgid "¡La %s ha caído!"
msgstr "Die %s ist am Boden!"

#: scripts/tornos.gd
msgid "Los tornos se han bloqueado. ¡Cúbreme mientras los abro!"
msgstr "Die Drehkreuze sind blockiert. Gib mir Deckung, während ich sie öffne!"

#: scripts/tornos.gd
msgid "Tarjeta… rechazada. Otra vez"
msgstr "Karte … abgelehnt. Noch mal"

#: scripts/tornos.gd
msgid "¡Mira, se atascan con los tornos!"
msgstr "Schau, die bleiben in den Drehkreuzen hängen!"

#: scripts/tornos.gd
msgid "¡Toma, esto estaba en objetos perdidos!"
msgstr "Hier, das war im Fundbüro!"

#: scripts/tornos.gd
msgid "«Acceso restringido: planta 40»… ¿qué hay ahí arriba?"
msgstr "„Zutritt verboten: Stockwerk 40“ … was ist da oben?"

#: scripts/tutoriales.gd
msgid "Apunta y ataca con {apuntar}."
msgstr "Ziele und greife mit {apuntar} an."

#: scripts/tutoriales.gd
msgid "Apunta con {apuntar} y ataca con {atacar}."
msgstr "Ziele mit {apuntar} und greife mit {atacar} an."

#: scripts/tutoriales.gd
msgid "Si prefieres que Johnny apunte solo, en Opciones → Ayudas está «Disparo asistido»."
msgstr "Soll Johnny lieber selbst zielen: Unter Optionen → Hilfen gibt es \"Assistiertes Schießen\"."

#: scripts/tutoriales.gd
msgid "Johnny apunta y ataca solo al durmiente más cercano: tú preocúpate de moverte."
msgstr "Johnny zielt und schlägt von selbst auf den nächsten Schläfer: Du musst nur laufen."

#: scripts/tutoriales.gd
msgid "el joystick (toca y arrastra en la mitad izquierda)"
msgstr "dem Joystick (links tippen und ziehen)"

#: scripts/tutoriales.gd
msgid "el stick izquierdo"
msgstr "dem linken Stick"

#: scripts/tutoriales.gd
msgid "el joystick de abajo a la derecha"
msgstr "dem Joystick unten rechts"

#: scripts/tutoriales.gd
msgid "el stick derecho"
msgstr "dem rechten Stick"

#: scripts/tutoriales.gd
msgid "el ratón"
msgstr "der Maus"

#: scripts/tutoriales.gd
msgid "%s o %s"
msgstr "%s oder %s"

#: scripts/tutoriales.gd
msgid "Lo básico"
msgstr "Grundlagen"

#: scripts/tutoriales.gd scripts/ui/inventario.gd scripts/ui/menus.gd scripts/ui/opciones.gd
msgid "Armas"
msgstr "Waffen"

#: scripts/tutoriales.gd
msgid "Plantas y jefes"
msgstr "Etagen und Bosse"

#: scripts/tutoriales.gd
msgid "Eventos sorpresa"
msgstr "Zwischenfälle"

#: scripts/tutoriales.gd
msgid "Sala de mantenimiento"
msgstr "Wartungsraum"

#: scripts/tutoriales.gd
msgid "Más edificios"
msgstr "Weitere Gebäude"

#: scripts/tutoriales.gd
msgid "Cómo se juega"
msgstr "So geht's"

#: scripts/tutoriales.gd
msgid "Al empezar"
msgstr "Zum Start"

#: scripts/tutoriales.gd
msgid "Muévete con {moverse} y esquiva con {esquivar}: mientras esquivas, no te hacen daño."
msgstr "Beweg dich mit {moverse} und weiche mit {esquivar} aus: Während du ausweichst, passiert dir nichts."

#: scripts/tutoriales.gd
msgid "{atacar_modo}"
msgstr "{atacar_modo}"

#: scripts/tutoriales.gd
msgid "Abre y cierra muebles y puertas con {usar}, cuando estés delante y se marquen en amarillo."
msgstr "Öffne und schließe Möbel und Türen mit {usar}, wenn du davorstehst und sie gelb markiert sind."

#: scripts/tutoriales.gd
msgid "Pausa el juego con {pausa}."
msgstr "Pausiere mit {pausa}."

#: scripts/tutoriales.gd
msgid "Moverse y esquivar"
msgstr "Bewegen und Ausweichen"

#: scripts/tutoriales.gd
msgid "Al empezar la primera partida"
msgstr "Zu Beginn der ersten Runde"

#: scripts/tutoriales.gd
msgid "Muévete con {moverse}."
msgstr "Beweg dich mit {moverse}."

#: scripts/tutoriales.gd
msgid "Esquiva con {esquivar}: un acelerón corto en el que no te hacen daño. Se recarga en menos de un segundo."
msgstr "Weiche mit {esquivar} aus: ein kurzer Sprint, bei dem dir nichts passiert. Er lädt sich in unter einer Sekunde wieder auf."

#: scripts/tutoriales.gd scripts/ui/opciones.gd
msgid "Atacar"
msgstr "Angreifen"

#: scripts/tutoriales.gd
msgid "En la primera pelea"
msgstr "Im ersten Kampf"

#: scripts/tutoriales.gd
msgid "Limpia los apartamentos"
msgstr "Säubere die Wohnungen"

#: scripts/tutoriales.gd
msgid "Al salir al pasillo"
msgstr "Im Flur"

#: scripts/tutoriales.gd
msgid "Al entrar en un apartamento, la puerta se cierra hasta que no quede ni un durmiente."
msgstr "Betrittst du eine Wohnung, schließt sich die Tür, bis kein Schläfer mehr übrig ist."

#: scripts/tutoriales.gd
msgid "La sala del jefe está cerrada con llave: la lleva un durmiente de algún apartamento. Al caer la suelta: pasa por encima para cogerla."
msgstr "Der Bossraum ist abgeschlossen: Den Schlüssel trägt ein Schläfer aus irgendeiner Wohnung. Wenn er fällt, lässt er ihn fallen: Lauf drüber, um ihn aufzuheben."

#: scripts/tutoriales.gd
msgid "Vence al jefe y se abren las escaleras a la planta siguiente."
msgstr "Besiege den Boss, dann öffnet sich die Treppe zum nächsten Stock."

#: scripts/tutoriales.gd
msgid "La vida en tercios"
msgstr "Leben in Dritteln"

#: scripts/tutoriales.gd
msgid "Al perder un tercio de vida"
msgstr "Ein Drittel verloren"

#: scripts/tutoriales.gd
msgid "Tu vida va en tres tercios. El que pierdes se oscurece y las vendas ya no lo llenan."
msgstr "Dein Leben besteht aus drei Dritteln. Ein verlorenes Drittel wird dunkel, und Verbände füllen es nicht mehr auf."

#: scripts/tutoriales.gd
msgid "Por cada tercio perdido andas más lento, y no se recupera al subir de planta."
msgstr "Mit jedem verlorenen Drittel wirst du langsamer, und es kommt auch beim Aufstieg in den nächsten Stock nicht zurück."

#: scripts/tutoriales.gd
msgid "Solo el botiquín te devuelve uno (y la mutación Segundo aliento, una vez por planta)."
msgstr "Nur das Medikit gibt dir eins zurück (und die Mutation Zweite Luft, einmal pro Stock)."

#: scripts/tutoriales.gd
msgid "¿Se te hace cuesta arriba? En Opciones → Ayudas está «Vida entera»."
msgstr "Wird es dir zu schwer? Unter Optionen → Hilfen findest du \"Ganzes Leben\"."

#: scripts/tutoriales.gd
msgid "Vendas y botiquines"
msgstr "Verbände und Medikits"

#: scripts/tutoriales.gd
msgid "Al abrir el primer armarito o coger la primera cura"
msgstr "Beim ersten Öffnen eines Badschränkchens oder beim ersten Heilmittel"

#: scripts/tutoriales.gd
msgid "Abre los armaritos de los baños con {usar}: dan unas vendas o un botiquín."
msgstr "Öffne die Schränkchen in den Bädern mit {usar}: Sie geben dir Verbände oder ein Medikit."

#: scripts/tutoriales.gd
msgid "Vendas, con {usar_vendas}: curan 25, sin pasar del tercio en el que estás."
msgstr "Verbände mit {usar_vendas}: Sie heilen 25, aber nicht über dein aktuelles Drittel hinaus."

#: scripts/tutoriales.gd
msgid "Botiquín, con {usar_botiquin}: cura 40 y te devuelve un tercio perdido. Guárdalo para entonces."
msgstr "Medikit mit {usar_botiquin}: Es heilt 40 und bringt ein verlorenes Drittel zurück. Heb es dafür auf."

#: scripts/tutoriales.gd
msgid "Llevas como mucho 3 vendas y 2 botiquines."
msgstr "Du trägst höchstens 3 Verbände und 2 Medikits."

#: scripts/tutoriales.gd
msgid "Inventario y mochila"
msgstr "Inventar und Rucksack"

#: scripts/tutoriales.gd
msgid "Al coger el primer objeto"
msgstr "Beim ersten Gegenstand"

#: scripts/tutoriales.gd
msgid "Abre el inventario con {inventario}: tus armas, la munición, los lanzables y la mochila."
msgstr "Öffne das Inventar mit {inventario}: deine Waffen, die Munition, die Wurfwaffen und der Rucksack."

#: scripts/tutoriales.gd
msgid "Elige una casilla para ver qué es y qué puedes hacer con ella."
msgstr "Wähl einen Platz aus, um zu sehen, was es ist und was du damit machen kannst."

#: scripts/tutoriales.gd
msgid "Si caes o abandonas, pierdes lo de la mochila; si completas el edificio, pasa al baúl."
msgstr "Wenn du fällst oder aufgibst, verlierst du den Inhalt des Rucksacks; schließt du das Gebäude ab, wandert er in die Truhe."

#: scripts/tutoriales.gd
msgid "Dólares"
msgstr "Dollar"

#: scripts/tutoriales.gd
msgid "Al coger el primer billete"
msgstr "Beim ersten Geldschein"

#: scripts/tutoriales.gd
msgid "Los durmientes sueltan billetes al caer, y los jefes, muchos: pasa por encima para cogerlos."
msgstr "Schläfer lassen beim Fallen Scheine fallen, Bosse jede Menge: Lauf drüber, um sie aufzuheben."

#: scripts/tutoriales.gd
msgid "Si completas el edificio te los quedas todos; si caes o abandonas, la mitad."
msgstr "Schließt du das Gebäude ab, behältst du alle; wenn du fällst oder aufgibst, die Hälfte."

#: scripts/tutoriales.gd
msgid "Se gastan en la tienda de armas del ordenador de la sala de mantenimiento."
msgstr "Du gibst sie im Waffenladen am Computer im Wartungsraum aus."

#: scripts/tutoriales.gd
msgid "Mutágeno"
msgstr "Mutagen"

#: scripts/tutoriales.gd
msgid "Al coger el primer mutágeno"
msgstr "Beim ersten Mutagen"

#: scripts/tutoriales.gd
msgid "Al caer, los durmientes sueltan mutágeno: pasa por encima para cogerlo."
msgstr "Beim Fallen lassen Schläfer Mutagen fallen: Lauf drüber, um es aufzuheben."

#: scripts/tutoriales.gd
msgid "Solo te lo quedas si completas el edificio: si caes o abandonas, pierdes el de esa partida."
msgstr "Du behältst es nur, wenn du das Gebäude abschließt: Wenn du fällst oder aufgibst, verlierst du das aus dieser Runde."

#: scripts/tutoriales.gd
msgid "Se gasta en Mutaciones, en el ordenador: mejoras para Johnny que duran para siempre."
msgstr "Du gibst es bei Mutationen am Computer aus: Verbesserungen für Johnny, die für immer bleiben."

#: scripts/tutoriales.gd scripts/ui/opciones.gd
msgid "Cambiar de arma"
msgstr "Waffe wechseln"

#: scripts/tutoriales.gd
msgid "Al llevar la primera arma a distancia"
msgstr "Bei der ersten Fernwaffe"

#: scripts/tutoriales.gd
msgid "Ahora llevas dos armas en la mano: una de cuerpo a cuerpo, como la fregona, y otra a distancia, como la pistola."
msgstr "Jetzt hast du zwei Waffen in der Hand: eine für den Nahkampf, wie den Mopp, und eine für den Fernkampf, wie die Pistole."

#: scripts/tutoriales.gd
msgid "Cambia de una a otra con {cambiar_arma}."
msgstr "Du wechselst mit {cambiar_arma}."

#: scripts/tutoriales.gd
msgid "Armas nuevas"
msgstr "Neue Waffen"

#: scripts/tutoriales.gd
msgid "Al llevar otra arma"
msgstr "Bei der zweiten Waffe"

#: scripts/tutoriales.gd
msgid "Llevas dos armas en la mano (cuerpo a cuerpo y a distancia: cambias con {cambiar_arma}) y una de repuesto de cada tipo."
msgstr "Du hast zwei Waffen in der Hand (Nahkampf und Fernkampf: Du wechselst mit {cambiar_arma}) und je eine Ersatzwaffe pro Art."

#: scripts/tutoriales.gd
msgid "Las de repuesto se cambian en el inventario ({inventario})."
msgstr "Die Ersatzwaffen tauschst du im Inventar (öffnen mit {inventario})."

#: scripts/tutoriales.gd
msgid "El color del borde es su calidad: gris Normal, verde Poco común, azul Rara y morado Épica. Cuanto mejor, más partidas dura."
msgstr "Die Farbe des Rands zeigt die Qualität: grau Normal, grün Ungewöhnlich, blau Selten und lila Episch. Je besser, desto mehr Runden hält sie."

#: scripts/tutoriales.gd
msgid "Munición y recarga"
msgstr "Munition und Nachladen"

#: scripts/tutoriales.gd
msgid "Al recargar"
msgstr "Beim Nachladen"

#: scripts/tutoriales.gd
msgid "Recarga con {recargar}; al vaciarse el cargador, recarga solo."
msgstr "Lade mit {recargar} nach; ein leeres Magazin wird von selbst nachgeladen."

#: scripts/tutoriales.gd
msgid "Cada arma gasta su munición. Una caja de munición del suelo te da un cargador."
msgstr "Jede Waffe verbraucht ihre eigene Munition. Eine Munitionskiste vom Boden gibt dir ein Magazin."

#: scripts/tutoriales.gd
msgid "Sin munición, Johnny saca el arma de cuerpo a cuerpo."
msgstr "Ohne Munition zieht Johnny die Nahkampfwaffe."

#: scripts/tutoriales.gd
msgid "¡Ojo! Disparar dentro de un apartamento despierta a todos los durmientes."
msgstr "Vorsicht! Wer in einer Wohnung schießt, weckt alle Schläfer."

#: scripts/tutoriales.gd scripts/ui/inventario.gd scripts/ui/tienda_armas.gd
msgid "Lanzables"
msgstr "Wurfwaffen"

#: scripts/tutoriales.gd
msgid "Al conseguir el primer lanzable"
msgstr "Bei der ersten Wurfwaffe"

#: scripts/tutoriales.gd
msgid "Se compran en la tienda de armas del ordenador y van al baúl: sácalos de allí para llevarlos."
msgstr "Du kaufst sie im Waffenladen am Computer, und sie landen in der Truhe: Hol sie dort heraus, um sie mitzunehmen."

#: scripts/tutoriales.gd
msgid "Mantén {lanzar} para apuntar y suelta para lanzar. Cambia de lanzable con {cambiar_lanzable}."
msgstr "Halte {lanzar} gedrückt, um zu zielen, und lass los, um zu werfen. Die Wurfwaffe wechselst du mit {cambiar_lanzable}."

#: scripts/tutoriales.gd
msgid "Molotov: fuego. Granada: explota. Atraedora: llama a los durmientes y explota. Congeladora: los congela."
msgstr "Molotow: Feuer. Granate: explodiert. Köder: lockt die Schläfer an und explodiert. Eisbombe: friert sie ein."

#: scripts/tutoriales.gd
msgid "¡Ojo! El fuego y las explosiones también te hacen daño a ti."
msgstr "Vorsicht! Feuer und Explosionen verletzen auch dich."

#: scripts/tutoriales.gd
msgid "Materiales de fabricación"
msgstr "Herstellungsmaterial"

#: scripts/tutoriales.gd
msgid "Al coger el primer material"
msgstr "Beim ersten Material"

#: scripts/tutoriales.gd
msgid "Sirven para mejorar armas y lanzables en el banco de trabajo de la sala de mantenimiento."
msgstr "Mit ihnen verbesserst du Waffen und Wurfwaffen an der Werkbank im Wartungsraum."

#: scripts/tutoriales.gd
msgid "Están en armarios, mesillas, escritorios, cajas registradoras, archivadores... Ponte delante y ábrelos con {usar}. No todos tienen."
msgstr "Sie liegen in Schränken, Nachttischen, Schreibtischen, Kassen, Aktenschränken ... Stell dich davor und öffne sie mit {usar}. Nicht in allen ist etwas."

#: scripts/tutoriales.gd
msgid "Van en la mochila: si completas el edificio, pasan al baúl; si caes, se pierden."
msgstr "Sie kommen in den Rucksack: Schließt du das Gebäude ab, wandern sie in die Truhe; wenn du fällst, sind sie weg."

#: scripts/tutoriales.gd
msgid "Al llegar al primer jefe"
msgstr "Beim ersten Boss"

#: scripts/tutoriales.gd
msgid "Cada planta tiene su jefe. A media vida se enfada y se vuelve más peligroso."
msgstr "Jeder Stock hat seinen Boss. Bei halbem Leben wird er wütend und gefährlicher."

#: scripts/tutoriales.gd
msgid "Avisa antes de atacar, casi siempre con una marca en el suelo: ¡sal de ella o esquiva con {esquivar}!"
msgstr "Er warnt vor dem Angriff, fast immer mit einer Markierung am Boden: Geh raus oder weiche mit {esquivar} aus!"

#: scripts/tutoriales.gd
msgid "Algunos tienen cerca cosas para usar contra ellos con {usar}, como los bidones."
msgstr "Bei manchen liegen Dinge herum, die du mit {usar} gegen sie einsetzen kannst, wie die Fässer."

#: scripts/tutoriales.gd
msgid "Al caer suelta muchos dólares y se abren las escaleras."
msgstr "Beim Fallen lässt er viele Dollar fallen, und die Treppe öffnet sich."

#: scripts/tutoriales.gd scripts/ui/menus.gd
msgid "Efectos secundarios"
msgstr "Nebenwirkungen"

#: scripts/tutoriales.gd
msgid "Antes del primer efecto secundario"
msgstr "Vor der ersten Nebenwirkung"

#: scripts/tutoriales.gd
msgid "Al vencer a un jefe, el virus te cambia: elige una de las dos cartas."
msgstr "Besiegst du einen Boss, verändert dich das Virus: Wähl eine der zwei Karten."

#: scripts/tutoriales.gd
msgid "Cada una te da un poder hasta que acaba la partida. Llevas como mucho 4."
msgstr "Jede gibt dir eine Kraft bis zum Ende der Runde. Du trägst höchstens 4."

#: scripts/tutoriales.gd
msgid "El ascensor"
msgstr "Der Aufzug"

#: scripts/tutoriales.gd
msgid "Al arreglar el ascensor"
msgstr "Aufzug repariert"

#: scripts/tutoriales.gd
msgid "Al vencer al jefe, Johnny arregla el ascensor del pasillo: baja a la sala de mantenimiento y te devuelve a esta planta."
msgstr "Nach dem Sieg über den Boss repariert Johnny den Aufzug im Flur: Er fährt in den Wartungsraum hinunter und bringt dich zurück in diesen Stock."

#: scripts/tutoriales.gd
msgid "Úsalo para comprar, mejorar o sacar cosas del baúl a mitad de partida."
msgstr "Nutze ihn, um mitten in der Runde etwas zu kaufen, zu verbessern oder aus der Truhe zu holen."

#: scripts/tutoriales.gd
msgid "En cada planta nueva vuelve a estar averiado hasta que cae su jefe."
msgstr "In jedem neuen Stock ist er wieder defekt, bis dessen Boss fällt."

#: scripts/tutoriales.gd
msgid "La azotea"
msgstr "Das Dach"

#: scripts/tutoriales.gd
msgid "Al llegar a la azotea"
msgstr "Beim Erreichen des Dachs"

#: scripts/tutoriales.gd
msgid "El último jefe del edificio te espera en el helipuerto: entra en las líneas blancas para empezar la pelea."
msgstr "Der letzte Boss des Gebäudes wartet auf dem Hubschrauberlandeplatz: Tritt in die weißen Linien, um den Kampf zu beginnen."

#: scripts/tutoriales.gd
msgid "Al vencerlo llega un helicóptero: arrímate a su escalera para escapar."
msgstr "Nach seiner Niederlage kommt ein Hubschrauber: Geh zu seiner Leiter, um zu entkommen."

#: scripts/tutoriales.gd
msgid "Al oír al primero pedir socorro"
msgstr "Beim ersten Hilferuf"

#: scripts/tutoriales.gd
msgid "Si en la planta hay un superviviente encerrado, se le oye pedir socorro y sale un «!» en el minimapa."
msgstr "Ist in einem Stock ein Überlebender eingesperrt, hörst du ihn um Hilfe rufen, und auf der Minikarte erscheint ein \"!\"."

#: scripts/tutoriales.gd
msgid "Ve a por él y protégelo mientras hace lo suyo para salir. Si cae, quédate a su lado para levantarlo."
msgstr "Hol ihn und beschütze ihn, während er sich um den Ausgang kümmert. Wenn er fällt, bleib neben ihm, um ihn aufzuhelfen."

#: scripts/tutoriales.gd
msgid "Si completas el edificio con él, se muda a los trasteros y podrá acompañarte."
msgstr "Schließt du das Gebäude mit ihm ab, zieht er in die Keller und kann dich begleiten."

#: scripts/tutoriales.gd
msgid "Rescate en los apartamentos"
msgstr "Rettung im Mietshaus"

#: scripts/tutoriales.gd
msgid "Al encontrar al primero de los apartamentos"
msgstr "Beim ersten Überlebenden im Mietshaus"

#: scripts/tutoriales.gd
msgid "Al salir del piso con él, la puerta se cierra de golpe: se pone a forzar la cerradura y entran durmientes por las habitaciones."
msgstr "Wenn du die Wohnung mit ihm verlässt, fällt die Tür zu: Er macht sich daran, das Schloss aufzubrechen, und Schläfer dringen durch die Zimmer ein."

#: scripts/tutoriales.gd
msgid "Quédate cerca y protégelo. Si lo tumban, la cerradura no avanza: ponte a su lado para levantarlo."
msgstr "Bleib in der Nähe und beschütze ihn. Wird er umgeworfen, kommt das Schloss nicht voran: Stell dich neben ihn, um ihm aufzuhelfen."

#: scripts/tutoriales.gd
msgid "El ferretero"
msgstr "Der Handwerker"

#: scripts/tutoriales.gd
msgid "Al encontrar al ferretero"
msgstr "Beim Fund des Handwerkers"

#: scripts/tutoriales.gd
msgid "Se ha atrincherado en el almacén: al limpiar la tienda, se pone a quitar las tablas y entran durmientes."
msgstr "Er hat sich im Lager verschanzt: Sobald der Laden gesäubert ist, entfernt er die Bretter, und Schläfer strömen herein."

#: scripts/tutoriales.gd
msgid "Defiende su puerta: mientras haya un durmiente pegado a ella, no avanza."
msgstr "Verteidige seine Tür: Solange ein Schläfer an ihr klebt, kommt er nicht voran."

#: scripts/tutoriales.gd
msgid "La farmacéutica"
msgstr "Die Apothekerin"

#: scripts/tutoriales.gd
msgid "Al encontrar a la farmacéutica"
msgstr "Beim Fund der Apothekerin"

#: scripts/tutoriales.gd
msgid "Está herida y va cojeando: llévala hasta la puerta de las escaleras de la planta."
msgstr "Sie ist verletzt und humpelt: Bring sie zur Treppentür des Stocks."

#: scripts/tutoriales.gd
msgid "Por el camino salen durmientes. No te alejes de ella: si se queda sola, van a por ella."
msgstr "Unterwegs tauchen Schläfer auf. Entfern dich nicht von ihr: Wenn sie allein bleibt, gehen sie auf sie los."

#: scripts/tutoriales.gd
msgid "El técnico"
msgstr "Der Techniker"

#: scripts/tutoriales.gd
msgid "Al encontrar al técnico"
msgstr "Beim Fund des Technikers"

#: scripts/tutoriales.gd
msgid "No se va sin arreglar el cable pelado, pero con corriente no puede: ponte delante del cuadro eléctrico de la tienda para bajar la palanca."
msgstr "Er geht nicht, ohne das blanke Kabel zu reparieren, aber unter Strom kann er das nicht: Stell dich vor den Sicherungskasten des Ladens, um den Hebel umzulegen."

#: scripts/tutoriales.gd
msgid "Se queda todo a oscuras y entran durmientes: protégelo hasta que acabe."
msgstr "Alles wird dunkel, und Schläfer dringen ein: Beschütze ihn, bis er fertig ist."

#: scripts/tutoriales.gd
msgid "El informático joven"
msgstr "Der IT-Azubi"

#: scripts/tutoriales.gd
msgid "Al encontrar al informático joven"
msgstr "Beim Fund des IT-Azubis"

#: scripts/tutoriales.gd
msgid "No se va sin copiar los archivos de Velaria: la puerta se cierra y entran durmientes. Protégelo hasta que acabe."
msgstr "Er geht nicht, ohne die Velaria-Dateien zu kopieren: Die Tür schließt sich, und Schläfer dringen ein. Beschütze ihn, bis er fertig ist."

#: scripts/tutoriales.gd
msgid "Mientras copia, saltan las cámaras de la sala: rómpelas antes de un tiro y te ahorras escoltas."
msgstr "Während er kopiert, schlagen die Kameras des Raums an: Zerschieß sie vorher mit einem Schuss, und du ersparst dir Leibwächter."

#: scripts/tutoriales.gd
msgid "La limpiadora de noche"
msgstr "Die Nachtputzfrau"

#: scripts/tutoriales.gd
msgid "Al encontrar a la limpiadora de noche"
msgstr "Beim Fund der Nachtputzfrau"

#: scripts/tutoriales.gd
msgid "Está encerrada en el cuarto de la limpieza, lleno de gas. Para abrirlo, cierra las tres válvulas del departamento: ponte delante de cada una."
msgstr "Sie ist in der Putzkammer eingesperrt, die voller Gas ist. Um sie zu öffnen, schließ die drei Ventile der Abteilung: Stell dich vor jedes einzelne."

#: scripts/tutoriales.gd
msgid "Cada válvula silba al cerrarse y despierta frenéticos a los durmientes de cerca."
msgstr "Jedes Ventil pfeift beim Schließen und weckt die Schläfer in der Nähe in Raserei."

#: scripts/tutoriales.gd
msgid "La recepcionista"
msgstr "Die Empfangsdame"

#: scripts/tutoriales.gd
msgid "Al encontrar a la recepcionista"
msgstr "Beim Fund der Empfangsdame"

#: scripts/tutoriales.gd
msgid "Quiere abrir los tornos de la entrada con su tarjeta: mientras tanto, entran durmientes por las puertas del vestíbulo."
msgstr "Sie will die Drehkreuze am Eingang mit ihrer Karte öffnen: Währenddessen dringen Schläfer durch die Türen der Eingangshalle ein."

#: scripts/tutoriales.gd
msgid "Protégela hasta que acabe. Si la tumban, ponte a su lado para levantarla."
msgstr "Beschütze sie, bis sie fertig ist. Wird sie umgeworfen, stell dich neben sie, um ihr aufzuhelfen."

#: scripts/tutoriales.gd
msgid "En el primer apagón"
msgstr "Beim ersten Stromausfall"

#: scripts/tutoriales.gd
msgid "Se ha ido la luz en toda la planta: solo ves lo que alumbra tu linterna, hacia donde miras."
msgstr "Auf dem ganzen Stock ist der Strom weg: Du siehst nur, was deine Taschenlampe vor dir anleuchtet."

#: scripts/tutoriales.gd
msgid "En la sala del jefe todo sigue como siempre."
msgstr "Im Bossraum bleibt alles wie immer."

#: scripts/tutoriales.gd
msgid "Al subir a la planta siguiente, te llevas un premio en dólares y munición."
msgstr "Beim Aufstieg in den nächsten Stock bekommst du eine Belohnung in Dollar und Munition."

#: scripts/tutoriales.gd
msgid "En la primera alarma de incendios"
msgstr "Beim ersten Feueralarm"

#: scripts/tutoriales.gd
msgid "Los aspersores llenan el suelo de charcos que resbalan."
msgstr "Die Sprinkler setzen den Boden voller rutschiger Pfützen."

#: scripts/tutoriales.gd
msgid "En algunos cae un cable pelado que da calambrazos a ti y a los durmientes: ¡llévalos hasta él! Esquivando lo cruzas sin daño."
msgstr "In manchen fällt ein blankes Kabel herab, das dir und den Schläfern Stromschläge verpasst: Lock sie dorthin! Wenn du ausweichst, kommst du schadlos hindurch."

#: scripts/tutoriales.gd
msgid "En la primera horda"
msgstr "Bei der ersten Horde"

#: scripts/tutoriales.gd
msgid "Una horda enorme llena el pasillo y va a por ti."
msgstr "Eine riesige Horde füllt den Flur und will an dich ran."

#: scripts/tutoriales.gd
msgid "Si te metes en un piso, los que queden te esperan fuera. Aquí los lanzables vienen de perlas."
msgstr "Gehst du in eine Wohnung, warten die übrigen draußen. Hier sind Wurfwaffen Gold wert."

#: scripts/tutoriales.gd
msgid "Al acabar con todos, te deja dólares y munición."
msgstr "Wenn du alle erledigt hast, lässt er dir Dollar und Munition da."

#: scripts/tutoriales.gd
msgid "El ordenador"
msgstr "Der Computer"

#: scripts/tutoriales.gd
msgid "Al encender el ordenador"
msgstr "Am Computer"

#: scripts/tutoriales.gd
msgid "Gasta el mutágeno en Mutaciones (mejoras para siempre) y los dólares en la Tienda de armas."
msgstr "Gib das Mutagen bei Mutationen aus (Verbesserungen für immer) und die Dollar im Waffenladen."

#: scripts/tutoriales.gd
msgid "También están los Logros, que dan premio, el Dosier, los Vídeos y Sujetos."
msgstr "Außerdem gibt es die Erfolge, die Belohnungen bringen, die Akte, die Videos und die Probanden."

#: scripts/tutoriales.gd
msgid "La taquilla"
msgstr "Der Spind"

#: scripts/tutoriales.gd
msgid "Al abrir la taquilla"
msgstr "Am Spind"

#: scripts/tutoriales.gd
msgid "Aquí eliges la ropa de Johnny. Cada traje nuevo tiene su ventaja."
msgstr "Hier wählst du Johnnys Kleidung. Jeder neue Anzug hat seinen Vorteil."

#: scripts/tutoriales.gd
msgid "Se consiguen venciendo a cada jefe por primera vez: los que te faltan salen con «???»."
msgstr "Du bekommst sie, indem du jeden Boss zum ersten Mal besiegst: Die fehlenden stehen mit \"???\" da."

#: scripts/tutoriales.gd
msgid "El banco de trabajo"
msgstr "Die Werkbank"

#: scripts/tutoriales.gd
msgid "Al usar el banco de trabajo"
msgstr "An der Werkbank"

#: scripts/tutoriales.gd
msgid "Mejora tus armas y lanzables con los materiales de su familia (los de la mochila y los del baúl)."
msgstr "Verbessere deine Waffen und Wurfwaffen mit den Materialien ihrer Familie (aus dem Rucksack und aus der Truhe)."

#: scripts/tutoriales.gd
msgid "Normal, Poco común, Rara y Épica: cada mejora dura una partida más, y la Épica trae un truco."
msgstr "Normal, Ungewöhnlich, Selten und Episch: Jede Verbesserung hält eine Runde länger, und die epische bringt einen Trick mit."

#: scripts/tutoriales.gd
msgid "Elige la casilla y pulsa «Mejorar»."
msgstr "Wähle den Platz und drück \"Verbessern\"."

#: scripts/tutoriales.gd
msgid "El baúl"
msgstr "Die Truhe"

#: scripts/tutoriales.gd
msgid "Al abrir el baúl"
msgstr "An der Truhe"

#: scripts/tutoriales.gd
msgid "Lo que guardas en el baúl no se pierde nunca: armas, lanzables, munición y objetos."
msgstr "Was du in der Truhe verstaust, geht nie verloren: Waffen, Wurfwaffen, Munition und Gegenstände."

#: scripts/tutoriales.gd
msgid "Cada vez que sacas un arma o un lanzable, gasta una partida de su durabilidad. Con 0, se destruye al acabar esa partida."
msgstr "Jedes Mal, wenn du eine Waffe oder Wurfwaffe herausholst, verbraucht sie eine Runde ihrer Haltbarkeit. Bei 0 wird sie am Ende dieser Runde zerstört."

#: scripts/tutoriales.gd
msgid "Al acabar la partida, lo que aún dura vuelve solo al baúl. Elige una casilla o arrástrala para pasarla."
msgstr "Nach der Runde kehrt alles, was noch hält, von selbst in die Truhe zurück. Wähl einen Platz aus oder zieh ihn, um ihn zu verschieben."

#: scripts/tutoriales.gd
msgid "La tienda de armas"
msgstr "Der Waffenladen"

#: scripts/tutoriales.gd
msgid "Al abrir la tienda de armas"
msgstr "Beim Öffnen des Waffenladens"

#: scripts/tutoriales.gd
msgid "Lo que compras va al baúl: sácalo de allí para llevarlo. Si el baúl está lleno, haz sitio antes."
msgstr "Was du kaufst, landet in der Truhe: Hol es dort heraus, um es mitzunehmen. Ist die Truhe voll, mach vorher Platz."

#: scripts/tutoriales.gd
msgid "Todo es Normal: dura solo la partida en la que lo sacas. Las armas a distancia traen munición."
msgstr "Alles ist Normal: Es hält nur die Runde, in der du es herausholst. Fernkampfwaffen kommen mit Munition."

#: scripts/tutoriales.gd
msgid "Johnny empieza solo con la fregona: la primera pistola es un regalo, y también un molotov, una granada y una atraedora."
msgstr "Johnny beginnt nur mit dem Mopp: Die erste Pistole ist ein Geschenk, ebenso ein Molotow, eine Granate und ein Köder."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Mutaciones"
msgstr "Mutationen"

#: scripts/tutoriales.gd
msgid "Al abrir Mutaciones"
msgstr "Beim Öffnen der Mutationen"

#: scripts/tutoriales.gd
msgid "Gasta el mutágeno en mejoras para siempre, en tres ramas: Militar, Superviviente y Químico."
msgstr "Gib das Mutagen für dauerhafte Verbesserungen aus, in drei Zweigen: Militär, Überlebender und Chemiker."

#: scripts/tutoriales.gd
msgid "Para abrir una mutación hay que llenar antes la que tiene encima."
msgstr "Um eine Mutation freizuschalten, musst du erst die darüber füllen."

#: scripts/tutoriales.gd
msgid "«Resetear mutaciones» las quita para repartirlas otra vez, pero el mutágeno gastado se pierde."
msgstr "\"Mutationen zurücksetzen\" entfernt sie, damit du sie neu verteilen kannst, aber das ausgegebene Mutagen ist weg."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Logros"
msgstr "Erfolge"

#: scripts/tutoriales.gd
msgid "Al abrir Logros"
msgstr "Beim Öffnen der Erfolge"

#: scripts/tutoriales.gd
msgid "Aquí están los retos del juego. Al conseguir uno, vuelve aquí a cobrar su premio en dólares."
msgstr "Hier stehen die Aufgaben des Spiels. Hast du eine geschafft, komm hierher zurück und hol dir die Belohnung in Dollar ab."

#: scripts/tutoriales.gd
msgid "Si el premio no cabe en el máximo de dólares (MAX), lo que sobra se pierde."
msgstr "Passt die Belohnung nicht in das Dollar-Maximum (MAX), verfällt der Rest."

#: scripts/tutoriales.gd
msgid "Con una Ayuda encendida, esa partida no da logros."
msgstr "Ist eine Hilfe eingeschaltet, gibt diese Runde keine Erfolge."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Dosier VD-7"
msgstr "Akte VD-7"

#: scripts/tutoriales.gd
msgid "Al abrir el Dosier"
msgstr "Beim Öffnen der Akte"

#: scripts/tutoriales.gd
msgid "Mientras te falten páginas, en alguna planta hay un muerto con una. Cógela y se queda aquí para siempre."
msgstr "Solange dir Seiten fehlen, liegt in irgendeinem Stock ein Toter mit einer. Heb sie auf, und sie bleibt für immer hier."

#: scripts/tutoriales.gd
msgid "Completar el dosier es una de las tres cosas que pide el edificio siguiente para abrirse."
msgstr "Die Akte zu vervollständigen ist eine von drei Bedingungen, damit sich das nächste Gebäude öffnet."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Sujetos"
msgstr "Probanden"

#: scripts/tutoriales.gd
msgid "Al abrir Sujetos"
msgstr "Beim Öffnen der Probanden"

#: scripts/tutoriales.gd
msgid "Aquí se apuntan los durmientes y los jefes que te encuentras, con lo que hacen y dónde salen. Los que faltan, con «???»."
msgstr "Hier werden die Schläfer und Bosse notiert, denen du begegnest, mit ihren Fähigkeiten und Fundorten. Die fehlenden stehen mit \"???\" da."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Vídeos"
msgstr "Videos"

#: scripts/tutoriales.gd
msgid "Al abrir Vídeos"
msgstr "Beim Öffnen der Videos"

#: scripts/tutoriales.gd
msgid "Al coger la página del dosier de una planta, en algún apartamento se enciende una tele con las noticias de Canal 8: ponte delante y pulsa {usar}."
msgstr "Wenn du die Aktenseite eines Stocks aufhebst, geht in irgendeiner Wohnung ein Fernseher mit den Nachrichten von Kanal 8 an: Stell dich davor und drück {usar}."

#: scripts/tutoriales.gd
msgid "Si la ves entera, se guarda aquí. Ver todos los de un edificio también cuenta para abrir el siguiente."
msgstr "Siehst du sie ganz an, wird sie hier gespeichert. Alle eines Gebäudes zu sehen zählt auch dafür, dass sich das nächste öffnet."

#: scripts/tutoriales.gd
msgid "Los trasteros"
msgstr "Die Keller"

#: scripts/tutoriales.gd
msgid "Al entrar en los trasteros"
msgstr "Beim Betreten der Keller"

#: scripts/tutoriales.gd
msgid "Aquí viven los supervivientes que rescatas, cada uno en su trastero."
msgstr "Hier wohnen die Überlebenden, die du rettest, jeder in seinem Keller."

#: scripts/tutoriales.gd
msgid "Arrímate a uno y te acompañará en las partidas siguientes (solo uno a la vez). Algunos te ayudan aunque no vengan contigo."
msgstr "Geh zu einem, und er begleitet dich in den nächsten Runden (immer nur einer). Manche helfen dir auch, wenn sie nicht mitkommen."

#: scripts/tutoriales.gd
msgid "El centro comercial"
msgstr "Das Einkaufszentrum"

#: scripts/tutoriales.gd
msgid "Al llegar al centro comercial"
msgstr "Bei der Ankunft im Einkaufszentrum"

#: scripts/tutoriales.gd
msgid "La sala del jefe se abre con una tarjeta: la lleva el guardia de seguridad que hace la ronda."
msgstr "Der Bossraum öffnet sich mit einer Karte: Sie trägt der Wachmann, der seine Runde dreht."

#: scripts/tutoriales.gd
msgid "Si te ve, toca el silbato y llegan refuerzos. Corre mucho, pero se cansa: atrápalo cuando pare a respirar."
msgstr "Wenn er dich sieht, pfeift er, und Verstärkung kommt. Er rennt schnell, wird aber müde: Schnapp ihn dir, wenn er zum Verschnaufen stehen bleibt."

#: scripts/tutoriales.gd
msgid "Peligros de las tiendas"
msgstr "Gefahren in den Läden"

#: scripts/tutoriales.gd
msgid "En la primera tienda con peligro"
msgstr "Im ersten gefährlichen Laden"

#: scripts/tutoriales.gd
msgid "La cámara frigorífica te frena y te hiela, la cocina quema y el agua de Electrónica da calambres (su cuadro eléctrico la apaga)."
msgstr "Der Kühlraum bremst dich und lässt dich erfrieren, die Küche verbrennt dich, und das Wasser in der Elektronik gibt Stromschläge (ihr Sicherungskasten schaltet es ab)."

#: scripts/tutoriales.gd
msgid "También dañan a los durmientes: ¡llévalos hasta ellos! Esquivando los cruzas sin daño."
msgstr "Sie verletzen auch die Schläfer: Lock sie dorthin! Wenn du ausweichst, kommst du schadlos hindurch."

#: scripts/tutoriales.gd
msgid "Al oír su primer grito"
msgstr "Wenn du sie zum ersten Mal schreien hörst"

#: scripts/tutoriales.gd
msgid "No te ataca: se escapa y grita. Su grito pone a todos los durmientes de la tienda una burbuja dorada que los protege de todo."
msgstr "Sie greift dich nicht an: Sie flieht und schreit. Ihr Schrei hüllt alle Schläfer des Ladens in eine goldene Blase, die sie vor allem schützt."

#: scripts/tutoriales.gd
msgid "La burbuja no se va hasta que cae ella: ve primero a por la dependienta. Es flojita, pero corre: acorrálala o lánzale algo."
msgstr "Die Blase verschwindet erst, wenn sie fällt: Geh zuerst auf die Verkäuferin los. Sie ist schwach, aber schnell: Treib sie in die Enge oder wirf etwas nach ihr."

#: scripts/tutoriales.gd
msgid "La joyería"
msgstr "Der Juwelier"

#: scripts/tutoriales.gd
msgid "Al entrar en la joyería"
msgstr "Beim Betreten des Juweliers"

#: scripts/tutoriales.gd
msgid "La cámara acorazada guarda un arma Épica. Se abre con la tarjeta dorada que lleva el guardia de seguridad."
msgstr "Der Tresorraum birgt eine epische Waffe. Er öffnet sich mit der goldenen Karte, die der Wachmann trägt."

#: scripts/tutoriales.gd
msgid "Sin la tarjeta, ponte delante del lector dos veces: salta la alarma y tienes que aguantar dentro de la joyería hasta que se abra."
msgstr "Ohne die Karte stell dich zweimal vor das Lesegerät: Der Alarm geht los, und du musst im Juwelier durchhalten, bis sich die Tür öffnet."

#: scripts/tutoriales.gd
msgid "Al llegar a Torre Velaria"
msgstr "Bei der Ankunft im Velaria-Turm"

#: scripts/tutoriales.gd
msgid "La sala del jefe se abre con un código de tres cifras. Cada cifra está en un ordenador encendido (brilla en verde) de algún departamento."
msgstr "Der Bossraum öffnet sich mit einem dreistelligen Code. Jede Ziffer steckt in einem eingeschalteten Computer (er leuchtet grün) in irgendeiner Abteilung."

#: scripts/tutoriales.gd
msgid "Ponte delante para leerla, pero salta el «control de productividad» y se despiertan los durmientes."
msgstr "Stell dich davor, um sie zu lesen, aber die \"Leistungskontrolle\" schlägt an, und die Schläfer wachen auf."

#: scripts/tutoriales.gd
msgid "Peligros de la torre"
msgstr "Gefahren im Turm"

#: scripts/tutoriales.gd
msgid "En el primer departamento con peligro"
msgstr "In der ersten gefährlichen Abteilung"

#: scripts/tutoriales.gd
msgid "Los ventanales rotos te arrastran hacia fuera: crúzalos pegado a las mesas. Los durmientes que llegan al borde salen volando."
msgstr "Die zerbrochenen Fensterfronten ziehen dich nach draußen: Geh dicht an den Tischen vorbei. Schläfer, die den Rand erreichen, fliegen hinaus."

#: scripts/tutoriales.gd
msgid "Si una cámara te ve, salta la alarma y llegan escoltas: rómpela de un tiro antes."
msgstr "Wenn dich eine Kamera sieht, geht der Alarm los und Leibwächter kommen: Zerschieß sie vorher mit einem Schuss."

#: scripts/tutoriales.gd
msgid "El gas duerme a los durmientes, pero despiertan frenéticos. A ti no te hace nada; una válvula lo corta."
msgstr "Das Gas schläfert die Schläfer ein, aber sie wachen rasend wieder auf. Dir tut es nichts; ein Ventil dreht es ab."

#: scripts/tutoriales.gd
msgid "Alerta y Reto del día"
msgstr "Alarm und Tagesaufgabe"

#: scripts/tutoriales.gd
msgid "Al completar el primer edificio"
msgstr "Nach dem ersten geschafften Gebäude"

#: scripts/tutoriales.gd
msgid "Debajo de cada edificio completado eliges la alerta con < y >: más difícil, más dólares. Complétalo en la más alta para abrir la siguiente."
msgstr "Unter jedem abgeschlossenen Gebäude wählst du den Alarm mit < und >: schwerer, mehr Dollar. Schließ es auf der höchsten Stufe ab, um die nächste zu öffnen."

#: scripts/tutoriales.gd
msgid "El Reto del día es un edificio con una regla rara, el mismo para todos. Se juega una vez al día y, si lo completas, da $10."
msgstr "Die Tagesaufgabe ist ein Gebäude mit einer seltsamen Regel, für alle dasselbe. Sie wird einmal am Tag gespielt und gibt dir $10, wenn du sie abschließt."

#: scripts/tutoriales.gd
msgid "el botón de esquivar"
msgstr "dem Ausweich-Knopf"

#: scripts/tutoriales.gd
msgid "el botón de la otra arma"
msgstr "dem Knopf der anderen Waffe"

#: scripts/tutoriales.gd
msgid "el botón del arma a distancia, con ella en la mano"
msgstr "dem Knopf der Fernkampfwaffe, wenn du sie in der Hand hast"

#: scripts/tutoriales.gd
msgid "el botón de lanzar"
msgstr "dem Wurf-Knopf"

#: scripts/tutoriales.gd
msgid "el botoncito de al lado de lanzar"
msgstr "dem kleinen Knopf neben dem Wurf-Knopf"

#: scripts/tutoriales.gd
msgid "el botón de las vendas, arriba a la derecha"
msgstr "dem Verband-Knopf oben rechts"

#: scripts/tutoriales.gd
