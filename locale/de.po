msgid "Racimo"
msgstr "Splitter"

#: scripts/talentos.gd
msgid "El molotov y la granada sueltan 1 más pequeño alrededor por punto"
msgstr "Molotow und Granate werfen pro Punkt 1 kleinen Ableger ringsum ab"

#: scripts/talentos.gd
msgid "Veterano"
msgstr "Veteran"

#: scripts/talentos.gd
msgid "Críticos del 5 % al 15 % de las veces, y cada uno hace el triple de daño"
msgstr "Kritische Treffer in 15 % statt 5 % der Fälle, und jeder macht dreifachen Schaden"

#: scripts/talentos.gd
msgid "Corpulento"
msgstr "Stämmig"

#: scripts/talentos.gd
msgid "+10 % de vida máxima por punto"
msgstr "+10 % maximales Leben pro Punkt"

#: scripts/talentos.gd
msgid "Ajolote"
msgstr "Axolotl"

#: scripts/talentos.gd
msgid "Regeneras 1 de vida cada 5 segundos por punto, hasta la mitad de tu vida"
msgstr "Du regenerierst pro Punkt 1 Leben alle 5 Sekunden, bis zur Hälfte deines Lebens"

#: scripts/talentos.gd
msgid "Durito"
msgstr "Dickfell"

#: scripts/talentos.gd
msgid "Cada golpe que recibes quita 1 menos por punto"
msgstr "Jeder Treffer gegen dich zieht pro Punkt 1 weniger ab"

#: scripts/talentos.gd
msgid "Reflejos"
msgstr "Reflexe"

#: scripts/talentos.gd
msgid "Esquivas solo un golpe cada 10 s (1 s menos por cada punto más)"
msgstr "Alle 10 s weichst du einem Treffer von selbst aus (1 s weniger pro Extrapunkt)"

#: scripts/talentos.gd
msgid "Sanitario"
msgstr "Sanitäter"

#: scripts/talentos.gd
msgid "Los botiquines y las vendas curan 10 más por punto"
msgstr "Medikits und Verbände heilen pro Punkt 10 mehr"

#: scripts/talentos.gd
msgid "Acero"
msgstr "Stahl"

#: scripts/talentos.gd
msgid "Cada planta, un escudo de 50 que se gasta antes que la vida"
msgstr "Auf jedem Stock ein Schild von 50, der vor dem Leben verbraucht wird"

#: scripts/talentos.gd
msgid "Ninja"
msgstr "Ninja"

#: scripts/talentos.gd
msgid "Al acabar una esquiva, golpe en área que mata a los zombis (como mucho cada 5 s)"
msgstr "Nach dem Ausweichen ein Flächenschlag, der Zombies tötet (höchstens alle 5 s)"

#: scripts/talentos.gd
msgid "Desfibrilador"
msgstr "Defibrillator"

#: scripts/talentos.gd
msgid "Una vez por edificio, si caes, resucitas con toda la vida"
msgstr "Einmal pro Gebäude: Fällst du, stehst du mit vollem Leben wieder auf"

#: scripts/talentos.gd
msgid "Blindaje"
msgstr "Panzerung"

#: scripts/talentos.gd
msgid "El escudo de Acero tiene 25 más por punto"
msgstr "Der Schild von Stahl hat pro Punkt 25 mehr"

#: scripts/talentos.gd
msgid "Sombra"
msgstr "Schatten"

#: scripts/talentos.gd
msgid "La esquiva se recarga un 15 % antes por punto"
msgstr "Ausweichen lädt pro Punkt 15 % schneller auf"

#: scripts/talentos.gd
msgid "Segundo aliento"
msgstr "Zweite Luft"

#: scripts/talentos.gd
msgid "Una vez por planta, al bajar de un tercio de la vida, te curas 15 por punto"
msgstr "Einmal pro Stock: Fällst du unter ein Drittel Leben, heilst du dich um 15 pro Punkt"

#: scripts/talentos.gd
msgid "Adrenalina"
msgstr "Adrenalin"

#: scripts/talentos.gd
msgid "Por debajo de la mitad de la vida, +30 % de daño y +20 % de velocidad"
msgstr "Unter halbem Leben +30 % Schaden und +20 % Tempo"

#: scripts/talentos.gd
msgid "Catalizador"
msgstr "Katalysator"

#: scripts/talentos.gd
msgid "+10 % de daño de fuego, ácido, rayo y frío por punto"
msgstr "+10 % Feuer-, Säure-, Blitz- und Kälteschaden pro Punkt"

#: scripts/talentos.gd
msgid "Guantes de goma"
msgstr "Gummihandschuhe"

#: scripts/talentos.gd
msgid "Fuego, ácido, venenos y frío te hacen un 10 % menos por punto"
msgstr "Feuer, Säure, Gift und Kälte machen dir pro Punkt 10 % weniger"

#: scripts/talentos.gd
msgid "Incendiario"
msgstr "Brandstifter"

#: scripts/talentos.gd
msgid "Los zombis que prendes arden 0,5 s más por punto"
msgstr "Zombies, die du anzündest, brennen pro Punkt 0,5 s länger"

#: scripts/talentos.gd
msgid "Desatascador"
msgstr "Rohrreiniger"

#: scripts/talentos.gd
msgid "Con ácido encima, todo les quita un 10 % más por punto"
msgstr "Zombies mit Säure nehmen pro Punkt 10 % mehr Schaden"

#: scripts/talentos.gd
msgid "Criogenia"
msgstr "Kryogenik"

#: scripts/talentos.gd
msgid "+1 congeladora por punto, y congelan 0,5 s más por punto"
msgstr "+1 Eisbombe pro Punkt, und sie frieren pro Punkt 0,5 s länger ein"

#: scripts/talentos.gd
msgid "Reacción en cadena"
msgstr "Kettenreaktion"

#: scripts/talentos.gd
msgid "Los zombis que mueren ardiendo revientan y prenden a los de al lado"
msgstr "Zombies, die brennend sterben, platzen und zünden ihre Nachbarn an"

#: scripts/talentos.gd
msgid "Residuo tóxico"
msgstr "Giftmüll"

#: scripts/talentos.gd
msgid "Los zombis que mueren con ácido dejan un charco de ácido (a ti no te hace nada)"
msgstr "Zombies, die mit Säure sterben, hinterlassen eine Säurepfütze (dir tut sie nichts)"

#: scripts/talentos.gd
msgid "Pararrayos"
msgstr "Blitzableiter"

#: scripts/talentos.gd
msgid "Al zombi que te golpea le salta un rayo que lo aturde y pasa a otro (como mucho cada 3 s)"
msgstr "Wer dich schlägt, kriegt einen Blitz ab, der betäubt und weiterspringt (höchstens alle 3 s)"

#: scripts/talentos.gd
msgid "Napalm"
msgstr "Napalm"

#: scripts/talentos.gd
msgid "El fuego del molotov dura 1 s más por punto"
msgstr "Das Feuer des Molotows brennt pro Punkt 1 s länger"

#: scripts/talentos.gd
msgid "Pegajoso"
msgstr "Klebrig"

#: scripts/talentos.gd
msgid "Los zombis con ácido van un 10 % más lentos por punto"
msgstr "Zombies mit Säure sind pro Punkt 10 % langsamer"

#: scripts/talentos.gd
msgid "Alto voltaje"
msgstr "Hochspannung"

#: scripts/talentos.gd
msgid "El rayo del lanza rayos y el de Pararrayos saltan a 1 zombi más por punto"
msgstr "Die Blitze von Blitzwerfer und Blitzableiter springen pro Punkt auf 1 Zombie mehr über"

#: scripts/talentos.gd
msgid "Mezcla explosiva"
msgstr "Explosive Mischung"

#: scripts/talentos.gd
msgid "Los zombis que mueren con dos efectos a la vez (fuego, ácido, rayo o frío) explotan (a ti no te hace nada)"
msgstr "Zombies, die mit zwei Effekten zugleich sterben (Feuer, Säure, Blitz oder Kälte), explodieren (dir tut das nichts)"

#: scripts/tutoriales.gd
msgid "Apunta y ataca con {apuntar}."
msgstr "Ziele und greife mit {apuntar} an."

#: scripts/tutoriales.gd
msgid "Apunta con {apuntar} y ataca con {atacar}."
msgstr "Ziele mit {apuntar} und greife mit {atacar} an."

#: scripts/tutoriales.gd
msgid "Johnny apunta y ataca solo al zombi más cercano: tú preocúpate de moverte."
msgstr "Johnny zielt und schlägt von selbst auf den nächsten Zombie: Du musst nur laufen."

#: scripts/tutoriales.gd
msgid "el joystick (toca y arrastra en la mitad izquierda)"
msgstr "dem Joystick (links tippen und ziehen)"

#: scripts/tutoriales.gd
msgid "el stick izquierdo"
msgstr "dem linken Stick"

#: scripts/tutoriales.gd
msgid "el joystick de abajo a la derecha"
msgstr "dem Joystick unten rechts"

#: scripts/tutoriales.gd
msgid "el stick derecho"
msgstr "dem rechten Stick"

#: scripts/tutoriales.gd
msgid "el ratón"
msgstr "der Maus"

#: scripts/tutoriales.gd
msgid "%s o %s"
msgstr "%s oder %s"

#: scripts/tutoriales.gd
msgid "Lo básico"
msgstr "Grundlagen"

#: scripts/tutoriales.gd scripts/ui/inventario.gd scripts/ui/menus.gd scripts/ui/opciones.gd
msgid "Armas"
msgstr "Waffen"

#: scripts/tutoriales.gd
msgid "Plantas y jefes"
msgstr "Etagen und Bosse"

#: scripts/tutoriales.gd
msgid "Eventos sorpresa"
msgstr "Zwischenfälle"

#: scripts/tutoriales.gd
msgid "Sala de mantenimiento"
msgstr "Wartungsraum"

#: scripts/tutoriales.gd
msgid "Más edificios"
msgstr "Weitere Gebäude"

#: scripts/tutoriales.gd
msgid "Cómo se juega"
msgstr "So geht's"

#: scripts/tutoriales.gd
msgid "Al empezar"
msgstr "Zum Start"

#: scripts/tutoriales.gd
msgid "Muévete con {moverse}."
msgstr "Beweg dich mit {moverse}."

#: scripts/tutoriales.gd
msgid "{atacar_modo} El modo de atacar se cambia con {cambiar_modo}."
msgstr "{atacar_modo} Den Angriffsmodus wechselst du mit {cambiar_modo}."

#: scripts/tutoriales.gd
msgid "Esquiva con {esquivar}: un acelerón corto en el que no te hacen daño."
msgstr "Weiche mit {esquivar} aus: ein kurzer Sprint, bei dem dir nichts passiert."

#: scripts/tutoriales.gd
msgid "Cambia entre la fregona y la pistola con {cambiar_arma}, y pausa el juego con {pausa}."
msgstr "Wechsle mit {cambiar_arma} zwischen Mopp und Pistole, und pausiere mit {pausa}."

#: scripts/tutoriales.gd
msgid "Limpia los apartamentos"
msgstr "Säubere die Wohnungen"

#: scripts/tutoriales.gd
msgid "Al salir al pasillo"
msgstr "Im Flur"

#: scripts/tutoriales.gd
msgid "Al entrar en un apartamento, la puerta se cierra detrás de ti y no se abre hasta que no queda ni un zombi."
msgstr "Betrittst du eine Wohnung, fällt die Tür zu und geht erst auf, wenn kein Zombie mehr übrig ist."

#: scripts/tutoriales.gd
msgid "La sala del jefe de la planta está cerrada con llave: la lleva un zombi de otro apartamento y la suelta al caer."
msgstr "Der Bossraum ist abgeschlossen: Ein Zombie in einer anderen Wohnung hat den Schlüssel und lässt ihn beim Sterben fallen."

#: scripts/tutoriales.gd
msgid "Vence al jefe y se abren las escaleras a la planta siguiente."
msgstr "Besiege den Boss, dann öffnet sich die Treppe zum nächsten Stock."

#: scripts/tutoriales.gd
msgid "La vida en tercios"
msgstr "Leben in Dritteln"

#: scripts/tutoriales.gd
msgid "Al perder un tercio de vida"
msgstr "Ein Drittel verloren"

#: scripts/tutoriales.gd
msgid "Tu vida está partida en tres tercios. El que pierdes ya no se cura con vendas, y por cada uno andas más lento."
msgstr "Dein Leben ist in drei Drittel geteilt. Ein verlorenes heilen Verbände nicht mehr, und mit jedem bist du langsamer."

#: scripts/tutoriales.gd
msgid "Solo el botiquín devuelve un tercio perdido."
msgstr "Nur Medikits bringen ein Drittel zurück."

#: scripts/tutoriales.gd
msgid "Si se te hace cuesta arriba, en Opciones → Ayudas está «Vida entera»."
msgstr "Wird es dir zu schwer: Unter Optionen → Hilfen gibt es \"Ganzes Leben\"."

#: scripts/tutoriales.gd scripts/ui/opciones.gd
msgid "Vendas y botiquín"
msgstr "Verbände und Medikit"

#: scripts/tutoriales.gd
msgid "Al coger la primera cura"
msgstr "Beim ersten Heilmittel"

#: scripts/tutoriales.gd
msgid "Las vendas se usan con {usar_vendas}: curan 25, sin pasar del tercio en el que estás."
msgstr "Verbände mit {usar_vendas}: Sie heilen 25, aber nicht über dein aktuelles Drittel hinaus."

#: scripts/tutoriales.gd
msgid "El botiquín, con {usar_botiquin}: devuelve un tercio perdido y cura 50."
msgstr "Das Medikit mit {usar_botiquin}: bringt ein Drittel zurück und heilt 50."

#: scripts/tutoriales.gd
msgid "Caben 3 vendas y 2 botiquines. Los armaritos de los baños se abren al acercarte y sueltan lo suyo."
msgstr "Platz für 3 Verbände und 2 Medikits. Badschränkchen öffnen sich vor dir und geben ihren Inhalt frei."

#: scripts/tutoriales.gd
msgid "Inventario y mochila"
msgstr "Inventar und Rucksack"

#: scripts/tutoriales.gd
msgid "Al coger el primer objeto"
msgstr "Beim ersten Gegenstand"

#: scripts/tutoriales.gd
msgid "Lo que recoges va a la mochila. El inventario se abre con {inventario}: tus armas, la munición, los lanzables y la mochila."
msgstr "Was du aufhebst, kommt in den Rucksack. Inventar öffnen mit {inventario}: Waffen, Munition, Wurfwaffen und Rucksack."

#: scripts/tutoriales.gd
msgid "Elige una casilla para ver su ficha y sus botones (usar, ponérmela, tirar...)."
msgstr "Wähle einen Platz für seine Karte und Knöpfe (benutzen, ausrüsten, wegwerfen...)."

#: scripts/tutoriales.gd
msgid "Si caes, lo que llevas se pierde; si completas el edificio, pasa al baúl."
msgstr "Fällst du, ist dein Gepäck weg; schaffst du das Gebäude, kommt es in die Truhe."

#: scripts/tutoriales.gd
msgid "Dólares"
msgstr "Dollar"

#: scripts/tutoriales.gd
msgid "Al coger el primer billete"
msgstr "Beim ersten Geldschein"

#: scripts/tutoriales.gd
msgid "Los zombis a veces sueltan billetes, y los jefes muchos: pasa por encima para cogerlos."
msgstr "Zombies lassen manchmal Scheine fallen, Bosse sogar viele: Lauf drüber, um sie einzusammeln."

#: scripts/tutoriales.gd
msgid "Se guardan al acabar la partida: todos si completas el edificio y la mitad si caes o abandonas."
msgstr "Am Rundenende werden sie gespeichert: alle bei Erfolg, die Hälfte, wenn du fällst oder aufgibst."

#: scripts/tutoriales.gd
msgid "Se gastan en el ordenador de la sala de mantenimiento."
msgstr "Ausgeben kannst du sie am Computer im Wartungsraum."

#: scripts/tutoriales.gd
msgid "Armas nuevas"
msgstr "Neue Waffen"

#: scripts/tutoriales.gd
msgid "Al llevar otra arma"
msgstr "Bei der zweiten Waffe"

#: scripts/tutoriales.gd
msgid "Llevas dos armas en la mano: una de cuerpo a cuerpo y otra a distancia. Cambias de una a otra con {cambiar_arma}."
msgstr "Du hast zwei Waffen in der Hand: eine für den Nahkampf, eine für den Fernkampf. Du wechselst mit {cambiar_arma}."

#: scripts/tutoriales.gd
msgid "Las demás van de repuesto, una de cada tipo, y se cambian en el inventario ({inventario})."
msgstr "Die anderen sind Ersatz, eine pro Art, und werden im Inventar getauscht (öffnen mit {inventario})."

#: scripts/tutoriales.gd
msgid "El color del borde es su calidad: gris Normal, verde Poco común, azul Rara y morado Épica."
msgstr "Die Randfarbe zeigt die Qualität: grau Normal, grün Ungewöhnlich, blau Selten und lila Episch."

#: scripts/tutoriales.gd
msgid "Munición y recarga"
msgstr "Munition und Nachladen"

#: scripts/tutoriales.gd
msgid "Al recargar"
msgstr "Beim Nachladen"

#: scripts/tutoriales.gd
msgid "Recarga con {recargar}; al vaciarse el cargador, recarga solo."
msgstr "Lade mit {recargar} nach; ein leeres Magazin wird von selbst nachgeladen."

#: scripts/tutoriales.gd
msgid "Cada arma gasta la suya (balas, cartuchos...). Una caja de munición del suelo te da un cargador."
msgstr "Jede Waffe braucht ihre eigene (Kugeln, Patronen...). Eine Munitionskiste am Boden gibt dir ein Magazin."

#: scripts/tutoriales.gd
msgid "Sin munición, Johnny saca el arma de cuerpo a cuerpo."
msgstr "Ohne Munition zieht Johnny die Nahkampfwaffe."

#: scripts/tutoriales.gd
msgid "Lanzables"
msgstr "Wurfwaffen"

#: scripts/tutoriales.gd
msgid "En la primera pelea"
msgstr "Im ersten Kampf"

#: scripts/tutoriales.gd
msgid "Lanza con {lanzar}: mantén para apuntar y suelta para lanzar."
msgstr "Wirf mit {lanzar}: halten zum Zielen, loslassen zum Werfen."

#: scripts/tutoriales.gd
msgid "Lo que lanzas se cambia con {cambiar_lanzable}: el molotov prende fuego y la granada explota. Llevas 3 a mano y hasta 8 de repuesto."
msgstr "Was du wirfst, wechselst du mit {cambiar_lanzable}: Der Molotow setzt Feuer, die Granate explodiert. Du hast 3 griffbereit und bis zu 8 in Reserve."

#: scripts/tutoriales.gd
msgid "¡Ojo! La explosión también te hace daño a ti."
msgstr "Achtung! Die Explosion trifft auch dich."

#: scripts/tutoriales.gd
msgid "Piezas de mejora"
msgstr "Verbesserungsteile"

#: scripts/tutoriales.gd
msgid "Al coger la primera pieza"
msgstr "Beim ersten Teil"

#: scripts/tutoriales.gd
msgid "Con las piezas se sube la calidad de las armas y los lanzables, en el banco de trabajo de la sala de mantenimiento."
msgstr "Mit Teilen verbesserst du Waffen und Wurfwaffen an der Werkbank im Wartungsraum."

#: scripts/tutoriales.gd
msgid "Hay de cuatro familias: cuerpo a cuerpo, a distancia, especiales y arrojables. Las sueltan los zombis de vez en cuando y los jefes."
msgstr "Es gibt vier Arten: Nahkampf, Fernkampf, Spezial und Wurfwaffen. Zombies lassen sie ab und zu fallen, Bosse auch."

#: scripts/tutoriales.gd
msgid "Van en la mochila: si completas el edificio, pasan al baúl."
msgstr "Ab in den Rucksack; schaffst du das Gebäude, in die Truhe."

#: scripts/tutoriales.gd
msgid "Al llegar al primer jefe"
msgstr "Beim ersten Boss"

#: scripts/tutoriales.gd
msgid "Cada planta tiene su jefe, con su barra de vida arriba. A media vida se enfada y se vuelve más peligroso."
msgstr "Jeder Stock hat seinen Boss, mit Lebensleiste oben. Bei halbem Leben wird er wütend und gefährlicher."

#: scripts/tutoriales.gd
msgid "Antes de cada ataque marca el suelo: ¡sal de la marca o esquívala!"
msgstr "Vor jedem Angriff markiert er den Boden: Raus da oder ausweichen!"

#: scripts/tutoriales.gd
msgid "Al caer suelta dólares, munición y piezas, y se abren las escaleras."
msgstr "Besiegt hinterlässt er Dollar, Munition und Teile, und die Treppe geht auf."

#: scripts/tutoriales.gd scripts/ui/menus.gd
msgid "Mutaciones"
msgstr "Mutationen"

#: scripts/tutoriales.gd
msgid "Antes de la primera mutación"
msgstr "Vor der ersten Mutation"

#: scripts/tutoriales.gd
msgid "Al vencer a un jefe, el virus te cambia: elige una de las dos cartas (también con 1 y 2)."
msgstr "Nach jedem Boss verändert dich das Virus: Wähle eine von zwei Karten (auch mit 1 und 2)."

#: scripts/tutoriales.gd
msgid "Cada mutación te da algo bueno y, a veces, algo malo."
msgstr "Jede Mutation bringt Gutes und manchmal auch Schlechtes."

#: scripts/tutoriales.gd
msgid "Duran hasta que acaba la partida, y llevas como mucho 4."
msgstr "Sie halten bis zum Ende der Runde, und du hast höchstens 4."

#: scripts/tutoriales.gd
msgid "El ascensor"
msgstr "Der Aufzug"

#: scripts/tutoriales.gd
msgid "Al arreglar el ascensor"
msgstr "Aufzug repariert"

#: scripts/tutoriales.gd
msgid "Johnny ha arreglado el ascensor del pasillo: baja a la sala de mantenimiento y vuelve a esta misma planta."
msgstr "Johnny hat den Aufzug im Flur repariert: Er fährt runter in den Wartungsraum und zurück auf diesen Stock."

#: scripts/tutoriales.gd
msgid "Úsalo para ir al ordenador, al banco de trabajo o al baúl en mitad de la partida."
msgstr "Damit kommst du mitten in der Runde zum Computer, zur Werkbank oder zur Truhe."

#: scripts/tutoriales.gd
msgid "Al rescatar al primero"
msgstr "Bei der ersten Rettung"

#: scripts/tutoriales.gd
msgid "Se une al equipo: te acompaña y te ayuda a su manera."
msgstr "Gerettete kommen ins Team und helfen dir auf ihre Art."

#: scripts/tutoriales.gd
msgid "Cada uno tiene su rescate. No te alejes de él y, si cae, quédate a su lado para levantarlo."
msgstr "Jede Rettung läuft anders. Bleib in der Nähe; geht jemand zu Boden, bleib daneben, um aufzuhelfen."

#: scripts/tutoriales.gd
msgid "Si completas el edificio con él, se muda a las viviendas (la puerta de la derecha de la sala de mantenimiento) y podrá acompañarte."
msgstr "Schaffst du das Gebäude gemeinsam, zieht die Person in die Unterkünfte (rechte Tür im Wartungsraum) und kann dich begleiten."

#: scripts/tutoriales.gd
msgid "En el primer apagón"
msgstr "Beim ersten Stromausfall"

#: scripts/tutoriales.gd
msgid "Se ha ido la luz en toda la planta: solo ves lo que alumbra tu linterna, hacia donde miras."
msgstr "Auf dem ganzen Stock ist der Strom weg: Du siehst nur, was deine Taschenlampe vor dir anleuchtet."

#: scripts/tutoriales.gd
msgid "En la sala del jefe todo sigue como siempre."
msgstr "Im Bossraum bleibt alles wie immer."

#: scripts/tutoriales.gd
msgid "Al subir a la planta siguiente, te llevas un premio en dólares."
msgstr "Erreichst du den nächsten Stock, gibt es einen Dollar-Bonus."

#: scripts/tutoriales.gd
msgid "En la primera alarma de incendios"
msgstr "Beim ersten Feueralarm"

#: scripts/tutoriales.gd
msgid "Los aspersores llenan el suelo de charcos que resbalan."
msgstr "Die Sprinkler setzen den Boden voller rutschiger Pfützen."

#: scripts/tutoriales.gd
msgid "En algunos cae un cable pelado que da calambrazos a Johnny y a los zombis: ¡llévalos hasta él! Esquivando cruzas sin daño."
msgstr "In manche fällt ein blankes Kabel, das Johnny und die Zombies schockt: Lock sie hin! Ausweichend kommst du heil durch."

#: scripts/tutoriales.gd
msgid "En la primera horda"
msgstr "Bei der ersten Horde"

#: scripts/tutoriales.gd
msgid "Una horda enorme llena el pasillo y va a por ti."
msgstr "Eine riesige Horde füllt den Flur und will an dich ran."

#: scripts/tutoriales.gd
msgid "Si te metes en un piso, los que queden te esperan fuera. Aquí los lanzables vienen de perlas."
msgstr "Gehst du in eine Wohnung, warten die übrigen draußen. Hier sind Wurfwaffen Gold wert."

#: scripts/tutoriales.gd
msgid "Al acabar con todos, te deja dólares y una caja de munición."
msgstr "Sind alle erledigt, gibt es Dollar und eine Kiste Munition."

#: scripts/tutoriales.gd
msgid "El ordenador"
msgstr "Der Computer"

#: scripts/tutoriales.gd
msgid "Al encender el ordenador"
msgstr "Am Computer"

#: scripts/tutoriales.gd
msgid "Gasta los dólares ahorrados: puntos de talento (mejoras para siempre) y armas y lanzables para la partida."
msgstr "Gib deine gesparten Dollar aus: Talentpunkte (dauerhafte Verbesserungen) sowie Waffen und Wurfwaffen für die Runde."

#: scripts/tutoriales.gd
msgid "También están los logros, que dan premio, el Dosier, las Noticias y las Colecciones."
msgstr "Dazu Erfolge mit Belohnung, die Akte, die Nachrichten und die Sammlungen."

#: scripts/tutoriales.gd
msgid "La taquilla"
msgstr "Der Spind"

#: scripts/tutoriales.gd
msgid "Al abrir la taquilla"
msgstr "Am Spind"

#: scripts/tutoriales.gd
msgid "Aquí eliges la ropa de Johnny. Cada una tiene su ventaja."
msgstr "Hier wählst du Johnnys Outfit. Jedes hat seinen Vorteil."

#: scripts/tutoriales.gd
msgid "Se consiguen venciendo a ciertos jefes: las que te faltan salen con «???» y cómo conseguirlas."
msgstr "Du bekommst sie, indem du bestimmte Bosse besiegst: Fehlende stehen mit \"???\" da, samt dem Weg dorthin."

#: scripts/tutoriales.gd
msgid "El banco de trabajo"
msgstr "Die Werkbank"

#: scripts/tutoriales.gd
msgid "Al usar el banco de trabajo"
msgstr "An der Werkbank"

#: scripts/tutoriales.gd
msgid "Sube la calidad de tus armas y lanzables, nivel a nivel, con las piezas de su familia (las de la mochila y las del baúl)."
msgstr "Verbessere Waffen und Wurfwaffen Stufe für Stufe mit Teilen ihrer Art (aus Rucksack und Truhe)."

#: scripts/tutoriales.gd
msgid "Normal, Poco común, Rara y Épica: la Épica trae además un truco."
msgstr "Normal, Ungewöhnlich, Selten und Episch: Episch bringt dazu einen Trick."

#: scripts/tutoriales.gd
msgid "Elige la casilla y pulsa «Mejorar»."
msgstr "Wähle den Platz und drück \"Verbessern\"."

#: scripts/tutoriales.gd
msgid "El baúl"
msgstr "Die Truhe"

#: scripts/tutoriales.gd
msgid "Al abrir el baúl"
msgstr "An der Truhe"

#: scripts/tutoriales.gd
msgid "Lo que guardas aquí no se pierde aunque caigas: objetos, armas y lanzables mejorados."
msgstr "Was hier liegt, ist sicher, auch wenn du fällst: Gegenstände, verbesserte Waffen und Wurfwaffen."

#: scripts/tutoriales.gd
msgid "Elige una casilla o arrástrala para pasarla entre lo que llevas y el baúl."
msgstr "Wähle oder zieh einen Platz, um ihn zwischen Gepäck und Truhe zu verschieben."

#: scripts/tutoriales.gd
msgid "Al completar el edificio, lo que llevas pasa solo al baúl."
msgstr "Schaffst du das Gebäude, landet dein Gepäck von selbst hier."

#: scripts/tutoriales.gd
msgid "El centro comercial"
msgstr "Das Einkaufszentrum"

#: scripts/tutoriales.gd
msgid "Al llegar al centro comercial"
msgstr "Bei der Ankunft im Einkaufszentrum"

#: scripts/tutoriales.gd
msgid "La sala del jefe se abre con una tarjeta de acceso: la lleva el guardia de seguridad que hace la ronda."
msgstr "Der Bossraum geht mit einer Zugangskarte auf: Die hat der Wächter, der seine Runden dreht."

#: scripts/tutoriales.gd
msgid "Si te ve, toca el silbato, llegan refuerzos y él huye: ¡que no se escape!"
msgstr "Sieht er dich, pfeift er nach Verstärkung und flieht: Lass ihn nicht entwischen!"

#: scripts/tutoriales.gd
msgid "Peligros de las tiendas"
msgstr "Gefahren in den Läden"

#: scripts/tutoriales.gd
msgid "En la primera tienda con peligro"
msgstr "Im ersten gefährlichen Laden"

#: scripts/tutoriales.gd
msgid "La cámara frigorífica congela, la cocina quema y el agua de la tienda de electrónica da calambres (su cuadro eléctrico corta la corriente)."
msgstr "Der Kühlraum friert ein, die Küche verbrennt, und das Wasser im Elektronikladen steht unter Strom (der Sicherungskasten dort schaltet ihn ab)."

#: scripts/tutoriales.gd
msgid "También hacen daño a los zombis despiertos: ¡llévalos hasta ellos!"
msgstr "Wache Zombies trifft es auch: Lock sie hinein!"

#: scripts/tutoriales.gd
msgid "Esquivando los cruzas sin daño."
msgstr "Ausweichend kommst du heil durch."

#: scripts/tutoriales.gd
msgid "Alerta y Reto del día"
msgstr "Alarm und Tagesaufgabe"

#: scripts/tutoriales.gd
msgid "Al completar el primer edificio"
msgstr "Nach dem ersten geschafften Gebäude"

#: scripts/tutoriales.gd
msgid "Debajo de cada edificio completado eliges la alerta con < y >: más difícil, más dólares. Completarlo con la más alta abre la siguiente."
msgstr "Unter jedem geschafften Gebäude wählst du den Alarm mit < und >: schwerer, mehr Dollar. Wer die höchste schafft, schaltet die nächste frei."

#: scripts/tutoriales.gd
msgid "El Reto del día es el mismo edificio para todo el mundo ese día, con una regla rara. Completarlo la primera vez cada día da $10."
msgstr "Die Tagesaufgabe ist an dem Tag für alle dasselbe Gebäude, mit einer seltsamen Regel. Das erste Mal pro Tag bringt $10."

#: scripts/tutoriales.gd
msgid "el botón de esquivar"
msgstr "dem Ausweich-Knopf"

#: scripts/tutoriales.gd
msgid "el botón de la otra arma"
msgstr "dem Knopf der anderen Waffe"

#: scripts/tutoriales.gd
msgid "el botón del arma a distancia, con ella en la mano"
msgstr "dem Knopf der Fernkampfwaffe, wenn du sie in der Hand hast"

#: scripts/tutoriales.gd
msgid "el botón de lanzar"
msgstr "dem Wurf-Knopf"

#: scripts/tutoriales.gd
msgid "el botoncito de al lado de lanzar"
msgstr "dem kleinen Knopf neben dem Wurf-Knopf"

#: scripts/tutoriales.gd
msgid "el botón de las vendas, bajo el minimapa"
msgstr "dem Verbands-Knopf unter der Minikarte"

#: scripts/tutoriales.gd
msgid "el botón del botiquín, bajo el minimapa"
msgstr "dem Medikit-Knopf unter der Minikarte"

#: scripts/tutoriales.gd
msgid "el botón de la mochila, bajo el minimapa"
msgstr "dem Rucksack-Knopf unter der Minikarte"

#: scripts/tutoriales.gd
msgid "el botón de pausa, bajo el minimapa"
msgstr "dem Pause-Knopf unter der Minikarte"

#: scripts/tutoriales.gd
msgid "el botón del modo, bajo el minimapa"
msgstr "dem Modus-Knopf unter der Minikarte"

