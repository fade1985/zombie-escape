# Traducción al alemán de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alarm %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Kein Alarm"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Wie immer"

#: scripts/alerta.gd
msgid ""
"%s\n"
"+%d %% de dólares"
msgstr ""
"%s\n"
"+%d %% Dollar"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de materiales"
msgstr ""
"%s%s\n"
"+%d %% Dollar und Material"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (und die davor)"

#: scripts/alerta.gd
msgid "+25 % de durmientes"
msgstr "+25 % Schläfer"

#: scripts/alerta.gd
msgid "Durmientes un 10 % más rápidos"
msgstr "Schläfer 10 % schneller"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Bosse mit +25 % Leben, und sie werden früher wütend"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Medikits, Verbände und Axolotl heilen nur halb so viel"

#: scripts/alerta.gd
msgid "El guardia (o el durmiente de la llave) aguanta el doble y los durmientes te oyen más lejos"
msgstr "Der Wächter (oder der Schlüsselschläfer) hält doppelt so viel aus, und Schläfer hören dich von weiter weg"

#: scripts/alerta.gd
msgid "Cada ordenador del código llama a dos escoltas y los durmientes te oyen más lejos"
msgstr "Jeder Code-Computer ruft zwei Leibwächter, und Schläfer hören dich von weiter weg"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "Hinter dir!"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Bleib nah dran, um aufzuhelfen"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Darf ich mit?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "PFIIIII!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "ZURÜCK!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "DU BIST VERHAFTET!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "KLONK!"

#: scripts/armas.gd
msgid "Durabilidad: %d"
msgstr "Haltbarkeit: %d"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "Schlag %d %% länger und breiter"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "Magazin %d %% größer und Nachladen %d %% schneller"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d durmiente más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d durmientes más"
msgstr[0] "Tank %d %% größer und die Entladung springt auf %d weiteren Schläfer über"
msgstr[1] "Tank %d %% größer und die Entladung springt auf %d weitere Schläfer über"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "Tank %d %% größer"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "Radius %d %% größer und %d mehr pro Stapel"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: Schaden +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Trick: Von je %d Treffern ist einer kritisch (doppelter Schaden)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un durmiente y siguen."
msgstr "Trick: Die Kugeln durchschlagen einen Schläfer und fliegen weiter."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d durmientes y siguen."
msgstr "Trick: Die Kugeln durchschlagen %d Schläfer und fliegen weiter."

#: scripts/armas.gd
msgid "Truco: los durmientes que mata revientan y pasan su efecto a los de al lado."
msgstr "Trick: Schläfer, die damit sterben, platzen und geben ihren Effekt an die Nachbarn weiter."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Trick: Zerbricht und verteilt %d kleinere ringsum."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Trick: Explodiert und verteilt %d kleinere ringsum."

