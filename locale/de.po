# Traducción al alemán de Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Zombie Escape\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alarm %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Kein Alarm"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Wie immer"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"+%d %% Dollar und Teile"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (und die davor)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % Zombies"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Zombies 10 % schneller"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Bosse mit +25 % Leben, und sie werden früher wütend"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Medikits, Verbände und Axolotl heilen nur halb so viel"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "Der Wächter (oder der Schlüsselzombie) hält doppelt so viel aus, und Zombies hören dich von weiter weg"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Bleib nah dran, um aufzuhelfen"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Hilfe!"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "Nimm mich mit!"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Darf ich mit?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "PFIIIII!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "ZURÜCK!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "DU BIST VERHAFTET!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "KLONK!"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "Schlag %d %% länger und breiter"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "Magazin %d %% größer und Nachladen %d %% schneller"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "Tank %d %% größer und die Entladung springt auf %d weiteren Zombie über"
msgstr[1] "Tank %d %% größer und die Entladung springt auf %d weitere Zombies über"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "Tank %d %% größer"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "Radius %d %% größer und %d mehr pro Stapel"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: Schaden +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Trick: Von je %d Treffern ist einer kritisch (doppelter Schaden)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Trick: Die Kugeln durchschlagen einen Zombie und fliegen weiter."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Trick: Die Kugeln durchschlagen %d Zombies und fliegen weiter."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Trick: Zombies, die damit sterben, platzen und geben ihren Effekt an die Nachbarn weiter."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Trick: Zerbricht und verteilt %d kleinere ringsum."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Trick: Explodiert und verteilt %d kleinere ringsum."

