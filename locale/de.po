msgstr "%d Leben alle 10 s"

#: scripts/talentos.gd
msgid "%d menos por golpe"
msgstr "%d weniger pro Treffer"

#: scripts/talentos.gd
msgid "una esquiva sola cada %s s"
msgstr "Auto-Ausweichen alle %s s"

#: scripts/talentos.gd
msgid "+%d de cura"
msgstr "+%d Heilung"

#: scripts/talentos.gd
