msgstr "In der Truhe"

#: scripts/ui/inventario.gd
msgid "Armas y lanzables"
msgstr "Waffen und Wurfwaffen"

#: scripts/ui/inventario.gd
msgid "Tienes %d"
msgstr "Du hast %d"

#: scripts/ui/inventario.gd
msgid "Hay %d en el baúl: se mejora un montón, %d"
msgstr "%d in der Truhe: Verbessert wird ein Stapel mit %d"

#: scripts/ui/inventario.gd
msgid "Sube a %s"
msgstr "Steigt auf %s"

#: scripts/ui/inventario.gd
msgid "Cuesta %s."
msgstr "Kostet %s."

#: scripts/ui/inventario.gd
msgid "Ya es Épica"
msgstr "Schon Episch"

#: scripts/ui/inventario.gd
msgid "Mejorar a %s"
msgstr "Auf %s verbessern"

#: scripts/ui/inventario.gd
msgid "No llevas arma a distancia que mejorar."
msgstr "Du hast keine Fernkampfwaffe zum Verbessern."

#: scripts/ui/inventario.gd
msgid "Ya es Épica: no se puede mejorar más."
msgstr "Schon Episch: Mehr geht nicht."

#: scripts/ui/inventario.gd
msgid "Ya llevas a mano otro montón %s y juntos no caben (como mucho, %d)."
msgstr "Du hast schon einen Stapel der Stufe %s in der Hand, und zusammen passen sie nicht (höchstens %d)."

#: scripts/ui/inventario.gd
msgid "El baúl está lleno: haz sitio para el montón mejorado."
msgstr "Die Truhe ist voll: Mach Platz für den verbesserten Stapel."

