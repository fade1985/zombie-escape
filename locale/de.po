msgstr "Wegwerfen"

#: scripts/ui/inventario.gd
msgid "Si la tiras, la de repuesto pasa a la mano."
msgstr "Wirfst du sie weg, kommt die Ersatzwaffe in die Hand."

#: scripts/ui/inventario.gd scripts/ui/menus.gd
msgid "Daño"
msgstr "Schaden"

#: scripts/ui/inventario.gd
msgid "Ritmo"
msgstr "Tempo"

#: scripts/ui/inventario.gd scripts/ui/menus.gd
msgid "Alcance"
msgstr "Distanz"

#: scripts/ui/inventario.gd
msgid "Barrido"
msgstr "Breite"

#: scripts/ui/inventario.gd
msgid "Recarga"
msgstr "Ladezeit"

#: scripts/ui/inventario.gd
msgid "Para curar"
msgstr "Heilung"

#: scripts/ui/inventario.gd
msgid "Pieza · Mejora armas"
msgstr "Teil · Verbessert Waffen"

#: scripts/ui/inventario.gd
msgid "Objeto · Común"
msgstr "Gegenstand · Gewöhnlich"

#: scripts/ui/inventario.gd scripts/ui/ordenador.gd
msgid "Llevas %d"
msgstr "Du hast %d"

#: scripts/ui/inventario.gd
msgid "Te devuelve un tercio de vida perdido y te cura %d."
msgstr "Bringt ein verlorenes Drittel zurück und heilt dich um %d."

#: scripts/ui/inventario.gd
msgid "Te cura %d de vida, sin pasar del tercio en el que estás."
msgstr "Heilt dich um %d, aber nicht über dein aktuelles Drittel hinaus."

#: scripts/ui/inventario.gd
msgid "Sin abrir el inventario, se usa con la tecla %s. Se llevan como mucho %d. Si caes, se pierde (en el baúl queda a salvo)."
msgstr "Ohne Inventar benutzt du es mit der Taste %s. Du trägst höchstens %d. Fällst du, ist es weg (in der Truhe ist es sicher)."

#: scripts/ui/inventario.gd
msgid "Usar"
msgstr "Benutzen"

#: scripts/ui/inventario.gd
msgid "Destruir"
msgstr "Zerstören"

#: scripts/ui/inventario.gd
msgid "Si caes, se pierde (en el baúl queda a salvo)."
msgstr "Fällst du, ist es weg (in der Truhe ist es sicher)."

#: scripts/ui/inventario.gd
msgid "Sirve para mejorar %s en el banco de trabajo del taller."
msgstr "Damit verbesserst du %s an der Werkbank in der Werkstatt."

#: scripts/ui/inventario.gd
msgid "Munición"
msgstr "Munition"

#: scripts/ui/inventario.gd
msgid "%d en este hueco · llevas %d"
msgstr "%d auf diesem Platz · du hast %d"

#: scripts/ui/inventario.gd
msgid "La gastan %s (caben %d en cada hueco). Al tirarlo, el hueco entero se queda en el suelo en una caja."
msgstr "Munition für %s (%d pro Platz). Wirfst du sie weg, bleibt der ganze Platz als Kiste am Boden."

#: scripts/ui/inventario.gd
msgid "Llena %s (caben %d en cada hueco). Se tira de uno en uno."
msgstr "Füllt %s (%d pro Platz). Wird einzeln weggeworfen."

#: scripts/ui/inventario.gd
msgid "Arrojable · %s"
msgstr "Wurfwaffe · %s"

#: scripts/ui/inventario.gd
msgid "A mano"
msgstr "In der Hand"

#: scripts/ui/inventario.gd
msgid "Te quedan %d de %d · %d en total"
msgstr "Noch %d von %d · %d insgesamt"

#: scripts/ui/inventario.gd
msgid "Te quedan %d de %d"
msgstr "Noch %d von %d"

#: scripts/ui/inventario.gd
msgid "Es lo que lanzas ahora."
msgstr "Das wirfst du gerade."

#: scripts/ui/inventario.gd
msgid "Con F lo eliges para lanzarlo."
msgstr "Mit F wählst du es zum Werfen."

#: scripts/ui/inventario.gd
msgid "Cuando se acabe, entra otro montón de los de repuesto."
msgstr "Ist er leer, rückt ein Ersatzstapel nach."

#: scripts/ui/inventario.gd
msgid "Al repuesto"
msgstr "Zum Ersatz"

#: scripts/ui/inventario.gd
msgid "Ya llevas a mano un montón lleno de estos: entrará cuando se acabe."
msgstr "Du hast schon einen vollen Stapel davon in der Hand: Der hier rückt nach, wenn er leer ist."

#: scripts/ui/inventario.gd
msgid "«A la mano» llena con estos el montón que llevas a mano."
msgstr "\"In die Hand\" füllt damit den Stapel in deiner Hand auf."

#: scripts/ui/inventario.gd
msgid "«A la mano» lo cambia por %s, que pasa aquí."
msgstr "\"In die Hand\" tauscht die Stapel: %s kommt hierher."

#: scripts/ui/inventario.gd
msgid "A la mano"
msgstr "In die Hand"

#: scripts/ui/inventario.gd
msgid "Te has curado %d de vida."
msgstr "Du hast dich um %d geheilt."

#: scripts/ui/inventario.gd
msgid "Baúl"
msgstr "Truhe"

#: scripts/ui/inventario.gd
msgid "Lo que llevas"
msgstr "Dein Gepäck"

#: scripts/ui/inventario.gd
msgid "Arrojables de repuesto  %d / %d"
msgstr "Ersatz-Wurfwaffen  %d / %d"

#: scripts/ui/inventario.gd
msgid "Baúl  %d / %d"
msgstr "Truhe  %d / %d"

#: scripts/ui/inventario.gd
msgid "Objetos, armas y arrojables"
msgstr "Gegenstände, Waffen und Wurfwaffen"

