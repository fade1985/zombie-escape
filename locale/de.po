#: scripts/armas.gd scripts/objetos.gd
msgid "Batería"
msgstr "Batterie"

#: scripts/armas.gd
msgid "¡Sin batería!"
msgstr "Batterie leer!"

#: scripts/armas.gd
msgid "el lanza rayos"
