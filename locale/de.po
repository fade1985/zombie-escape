#: scripts/ui/inventario.gd
msgid "Ratón o dedo: tocar o arrastrar"
msgstr "Maus oder Finger: tippen oder ziehen"

#: scripts/ui/inventario.gd
msgid "Depósito: %d de %d s"
msgstr "Tank: %d von %d s"

