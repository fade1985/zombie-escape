#: scripts/partida.gd
msgid "¡JURARÍA QUE ME ESTABAN MORDIENDO!"
msgstr "ICH SCHWÖRE, DIE HABEN MICH GEBISSEN!"

#: scripts/partida.gd
msgid "¡OTRA VEZ ESE SUEÑO DE DURMIENTES!"
msgstr "SCHON WIEDER DIESER SCHLÄFERTRAUM!"

#: scripts/peligros/agua.gd
msgid "¡Ha vuelto la corriente!"
msgstr "Der Strom ist wieder da!"

#: scripts/peligros/agua.gd
msgid "¡Clac! Se ha ido la luz de la tienda"
msgstr "Klack! Im Laden ist der Strom weg"

#: scripts/peligros/agua.gd
msgid "¡Ojo! El agua tiene corriente"
msgstr "Achtung! Das Wasser steht unter Strom"

#: scripts/peligros/bidones.gd
msgid "Empujar"
msgstr "Schieben"

#: scripts/peligros/camaras.gd
msgid "¡Una cámara! Si me ve, saltará la alarma"
msgstr "Eine Kamera! Wenn sie mich sieht, geht der Alarm los"

#: scripts/peligros/camaras.gd
msgid "¡Me han visto! Ya vienen..."
msgstr "Sie haben mich gesehen! Jetzt kommen sie..."

#: scripts/peligros/cerco.gd
msgid "¡La habitación está en llamas! Lejos de las paredes"
msgstr "Das Zimmer brennt! Weg von den Wänden"

#: scripts/peligros/frio.gd
msgid "¡Brrr! Qué frío hace en la cámara"
msgstr "Brrr! Ist das kalt hier drin"

#: scripts/peligros/fuego.gd
msgid "¡La cocina está ardiendo!"
msgstr "Die Küche brennt!"

#: scripts/peligros/gas.gd
msgid "Gas cortado"
msgstr "Gas abgedreht"

#: scripts/peligros/gas.gd
msgid "Gas abierto otra vez"
msgstr "Gas wieder an"

#: scripts/peligros/gas.gd scripts/peligros/laboratorio.gd
msgid "Huele raro... pero a mí no me hace nada"
msgstr "Riecht komisch... aber mir macht das nichts"

#: scripts/peligros/laboratorio.gd
msgid "¡La presidenta huye hacia el helipuerto! El laboratorio se queda en automático"
msgstr "Die Präsidentin flieht zum Landeplatz! Das Labor läuft jetzt automatisch"

#: scripts/peligros/porqueria.gd
msgid "¡Qué peste! El suelo está lleno de mierda con ácido: no la pises"
msgstr "Was für ein Gestank! Der Boden ist voller Säurescheiße: Tritt nicht rein"

#: scripts/peligros/tropiezos.gd
msgid "Cuidado con las mancuernas del suelo: si piso una, me la pego"
msgstr "Vorsicht mit den Hanteln am Boden: Wenn ich auf eine trete, leg ich mich lang"

#: scripts/peligros/tropiezos.gd
msgid "Cuidado con los cubos del suelo: si tropiezo con uno, me la pego"
msgstr "Vorsicht mit den Eimern am Boden: Wenn ich über einen stolpere, leg ich mich lang"

#: scripts/peligros/viento.gd
msgid "¡Qué corriente! Si me acerco al ventanal, me lleva"
msgstr "Was für ein Luftzug! Wenn ich ans Fenster komme, zieht er mich raus"

#: scripts/peligros/viento.gd
msgid "¡Uf! Casi me caigo por la ventana"
msgstr "Puh! Fast wäre ich aus dem Fenster gefallen"

#: scripts/portera.gd
msgid "¡VECINOS!"
msgstr "MIETER!"

#: scripts/portera.gd
msgid "¡LEJÍA!"
msgstr "CHLOR!"

#: scripts/portera.gd
msgid "¡ÁCIDO!"
msgstr "SÄURE!"

#: scripts/portera.gd
msgid "¡A BARRER!"
msgstr "KEHRWOCHE!"

#: scripts/portera.gd
msgid "¡QUE ACABO DE FREGAR!"
msgstr "FRISCH GEWISCHT!"

#: scripts/presentador.gd
msgid "¡UN APLAUSO!"
msgstr "APPLAUS, BITTE!"

#: scripts/presentador.gd
msgid "¡SORPRESA!"
msgstr "ÜBERRASCHUNG!"

#: scripts/presentador.gd
msgid "¡¿ME OÍS AL FONDO?!"
msgstr "HÖRT IHR MICH DA HINTEN?!"

#: scripts/presentador.gd
msgid "¡Cegado!"
msgstr "Geblendet!"

#: scripts/presentador.gd
msgid "¡EN PIE, PÚBLICO!"
msgstr "ALLE AUFSTEHEN!"

#: scripts/reto.gd
msgid "Reto del día · %s: %s"
msgstr "Tagesaufgabe · %s: %s"

#: scripts/reto.gd
msgid "Reto: %s"
msgstr "Aufgabe: %s"

#: scripts/reto.gd
msgid "Completado en %d:%02d"
msgstr "Geschafft in %d:%02d"

#: scripts/reto.gd
msgid "sin marca"
msgstr "kein Rekord"

#: scripts/reto.gd
msgid "Sin marca"
msgstr "Kein Rekord"

#: scripts/reto.gd
msgid "planta %d"
msgstr "Ebene %d"

#: scripts/reto.gd
msgid "Has llegado a la planta %d"
msgstr "Du hast Ebene %d erreicht"

#: scripts/reto.gd
msgid "Solo cuerpo a cuerpo"
msgstr "Nur Nahkampf"

#: scripts/reto.gd
msgid "la pistola va vacía y no cae munición, ni molotovs ni granadas"
msgstr "Pistole leer, und weder Munition noch Molotows noch Granaten fallen"

#: scripts/reto.gd
msgid "Todo a oscuras"
msgstr "Alles dunkel"

#: scripts/reto.gd
msgid "todas las plantas como en un apagón: solo se ve con la linterna"
msgstr "alle Stockwerke wie bei einem Stromausfall: Sicht nur mit der Taschenlampe"

#: scripts/reto.gd
msgid "Sin curas"
msgstr "Keine Heilung"

#: scripts/reto.gd
msgid "los armaritos están vacíos y no cae, ni se vende, ni te preparan nada que cure"
msgstr "leere Medizinschränke, und nichts Heilendes fällt, wird verkauft oder für dich gemacht"

#: scripts/reto.gd
msgid "Durmientes rápidos"
msgstr "Schnelle Schläfer"

#: scripts/reto.gd
msgid "todos un 35 % más rápidos (los jefes, no)"
msgstr "alle 35 % schneller (Bosse nicht)"

#: scripts/reto.gd
msgid "De cristal"
msgstr "Aus Glas"

#: scripts/reto.gd
msgid "Johnny con la mitad de vida"
msgstr "Johnny mit halbem Leben"

#: scripts/reto.gd
msgid "Casa llena"
msgstr "Volles Haus"

#: scripts/reto.gd
msgid "el doble de durmientes en cada sitio"
msgstr "doppelt so viele Schläfer überall"

#: scripts/reto.gd
msgid "Oído fino"
msgstr "Feines Gehör"

#: scripts/reto.gd
msgid "hasta los golpes cuerpo a cuerpo despiertan a todo el apartamento"
msgstr "sogar Nahkampfschläge wecken die ganze Wohnung"

#: scripts/skins.gd
msgid "Conserje"
msgstr "Hausmeister"

#: scripts/skins.gd
msgid "El portero"
msgstr "Der Portier"

#: scripts/skins.gd
msgid "La fregona hace un 100 % más de daño."
msgstr "Der Mopp macht 100 % mehr Schaden."

#: scripts/skins.gd
msgid "Mata a la portera por primera vez."
msgstr "Erledige die Portierin zum ersten Mal."

#: scripts/skins.gd
msgid "El glotón"
msgstr "Der Vielfraß"

#: scripts/skins.gd
msgid "Quien te hace daño lo paga: un durmiente muere y un jefe pierde un 3 % de vida."
msgstr "Wer dir wehtut, zahlt dafür: Ein Schläfer stirbt, ein Boss verliert 3 % Leben."

#: scripts/skins.gd
msgid "Mata al Glotón por primera vez."
msgstr "Erledige den Vielfraß zum ersten Mal."

#: scripts/skins.gd
msgid "El gymbro"
msgstr "Der Gymbro"

#: scripts/skins.gd
msgid "Las armas cuerpo a cuerpo hacen un 50 % más de daño."
msgstr "Nahkampfwaffen machen 50 % mehr Schaden."

#: scripts/skins.gd
msgid "Mata al Gymbro por primera vez."
msgstr "Erledige den Gymbro zum ersten Mal."

#: scripts/skins.gd
msgid "El bombero"
msgstr "Der Feuerwehrmann"

#: scripts/skins.gd
msgid "Las armas que queman hacen un 50 % más de daño y el fuego no te quema."
msgstr "Waffen mit Feuer machen 50 % mehr Schaden, und Feuer kann dir nichts anhaben."

#: scripts/skins.gd
msgid "Mata al jefe de bomberos por primera vez."
msgstr "Erledige den Feuerwehrchef zum ersten Mal."

#: scripts/skins.gd
msgid "Un 50 % de las veces, cada durmiente suelta otro billete o más munición."
msgstr "In 50 % der Fälle lässt jeder Schläfer einen weiteren Schein oder mehr Munition fallen."

#: scripts/skins.gd
msgid "Mata al doctor Salas por primera vez."
msgstr "Erledige Dr. Salas zum ersten Mal."

#: scripts/skins.gd
msgid "Las vendas y los botiquines curan un 50 % más."
msgstr "Verbände und Medikits heilen 50 % mehr."

#: scripts/skins.gd
msgid "Mata al cocinero por primera vez."
msgstr "Erledige den Koch zum ersten Mal."

#: scripts/skins.gd
msgid "Tras un golpe, tardas más en poder recibir otro (de 0,7 a 1,2 s) y nada te tira al suelo."
msgstr "Nach einem Treffer dauert es länger, bis du wieder getroffen werden kannst (von 0,7 auf 1,2 s), und nichts wirft dich um."

#: scripts/skins.gd
msgid "Mata al antidisturbios por primera vez."
msgstr "Erledige den Einsatzpolizisten zum ersten Mal."

#: scripts/skins.gd
msgid "Los durmientes no se despiertan al entrar en su habitación y te ven a la mitad de distancia."
msgstr "Schläfer wachen nicht auf, wenn du ihr Zimmer betrittst, und sehen dich erst aus halber Entfernung."

#: scripts/skins.gd
msgid "Mata a la modista por primera vez."
msgstr "Erledige die Schneiderin zum ersten Mal."

#: scripts/skins.gd
msgid "Andas un 15 % más rápido."
msgstr "Du läufst 15 % schneller."

#: scripts/skins.gd
msgid "Mata a la mascota por primera vez."
msgstr "Erledige das Maskottchen zum ersten Mal."

#: scripts/skins.gd
msgid "La mitad de los billetes que coges valen el doble."
msgstr "Die Hälfte der Scheine, die du aufhebst, ist doppelt so viel wert."

#: scripts/skins.gd
msgid "Mata al gerente por primera vez."
msgstr "Erledige den Manager zum ersten Mal."

#: scripts/skins.gd
msgid "La directora"
msgstr "Die Personalchefin"

#: scripts/skins.gd
msgid "«Despido»: el primer golpe a un durmiente que sigue dormido lo mata (a los jefes, no)."
msgstr "\"Kündigung\": Dein erster Treffer tötet einen Schläfer, der noch schläft (Bosse nicht)."

#: scripts/skins.gd
msgid "Mata a la directora de Recursos Humanos por primera vez."
msgstr "Erledige die Personalchefin zum ersten Mal."

#: scripts/skins.gd
msgid "Las cámaras de seguridad no te ven y la linterna alumbra un 50 % más lejos."
msgstr "Überwachungskameras sehen dich nicht, und deine Taschenlampe leuchtet 50 % weiter."

#: scripts/skins.gd
msgid "Mata al informático por primera vez."
msgstr "Erledige den IT-Typen zum ersten Mal."

#: scripts/skins.gd
msgid "Las cajas de munición te dan un 30 % más."
msgstr "Munitionskisten geben dir 30 % mehr."

#: scripts/skins.gd
msgid "Mata al presentador por primera vez."
msgstr "Erledige den Moderator zum ersten Mal."

#: scripts/skins.gd
msgid "«Copia de seguridad»: una vez por partida, al caer, te levantas con 25 de vida."
msgstr "\"Backup\": Einmal pro Runde stehst du nach einem Sturz mit 25 Leben wieder auf."

#: scripts/skins.gd
msgid "Mata al becario por primera vez."
msgstr "Erledige den Praktikanten zum ersten Mal."

#: scripts/skins.gd
msgid "Empiezas cada partida con un efecto secundario: eliges uno de dos al llegar."
msgstr "Du startest jede Runde mit einer Nebenwirkung: Bei der Ankunft wählst du eine von zwei."

#: scripts/skins.gd
msgid "Mata al Sujeto 1 por primera vez."
msgstr "Erledige Proband 1 zum ersten Mal."

#: scripts/sujeto_1.gd
msgid "¡NO AGUANTA!"
msgstr "ES ZERREISST IHN!"

#: scripts/supervivientes.gd
msgctxt "superviviente"
msgid "Militar"
msgstr "Soldat"

#: scripts/supervivientes.gd
msgid "La recepcionista: la llave está en el suelo de %s"
msgstr "Die Empfangsdame: Der Schlüssel liegt auf dem Boden von %s"

#: scripts/supervivientes.gd
msgid "La recepcionista: la llave la lleva un durmiente de %s"
msgstr "Die Empfangsdame: Ein Schläfer in %s hat den Schlüssel"

#: scripts/supervivientes.gd
msgid "La recepcionista: la tarjeta la lleva el guardia de seguridad, que ronda el pasillo"
msgstr "Die Empfangsdame: Der Kartenwächter hat die Zugangskarte, er dreht seine Runden im Flur"

#: scripts/supervivientes.gd
msgid "La recepcionista: las cifras del código están en %s"
msgstr "Die Empfangsdame: Die Ziffern des Codes sind in %s"

#: scripts/supervivientes.gd
msgid "¡%s se une al equipo! %s"
msgstr "Neu im Team: %s! %s"

#: scripts/supervivientes.gd
msgid "¡La puerta se ha cerrado! Aguanta mientras %s fuerza la cerradura"
msgstr "Die Tür ist zu! Halte durch: %s knackt das Schloss"

#: scripts/supervivientes.gd
msgid "¡Puerta abierta! Salid de aquí"
msgstr "Tür offen! Raus hier"

#: scripts/supervivientes.gd
msgid "%s te acompaña · %s"
msgstr "Begleitet dich: %s · %s"

#: scripts/supervivientes.gd
msgctxt "superviviente"
msgid "¡%s ha caído!"
msgstr "%s am Boden!"

#: scripts/supervivientes.gd
msgid "%s fuerza la cerradura · %d:%02d"
msgstr "%s knackt das Schloss · %d:%02d"

#: scripts/supervivientes.gd
msgid "¡SOY POLICÍA!"
msgstr "ICH BIN POLIZIST!"

#: scripts/supervivientes.gd
msgid "Policía"
msgstr "Polizist"

#: scripts/supervivientes.gd
msgid "Dispara con su pistola cada 0,8 s"
msgstr "Schießt alle 0,8 s mit der Pistole"

#: scripts/supervivientes.gd
msgid "¡SOY MÉDICA!"
msgstr "ICH BIN ÄRZTIN!"

#: scripts/supervivientes.gd
msgid "Médica"
msgstr "Ärztin"

#: scripts/supervivientes.gd
msgid "Te cura 5 cada 6 s y 10 al limpiar cada piso"
msgstr "Heilt dich alle 6 s um 5 und um 10 für jede gesäuberte Wohnung"

#: scripts/supervivientes.gd
msgid "¡SOY MILITAR!"
msgstr "ICH BIN SOLDAT!"

#: scripts/supervivientes.gd
msgid "Lanza ráfagas de 3 balas cada 2,5 s"
msgstr "Feuert alle 2,5 s Salven mit 3 Schuss"

#: scripts/supervivientes.gd
msgid "¡SOY FERRETERO!"
msgstr "ICH BIN HANDWERKER!"

#: scripts/supervivientes.gd
msgid "Ferretero"
msgstr "Handwerker"

#: scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Hilfe!"

#: scripts/supervivientes.gd
msgid "¡Estoy en el almacén!"
msgstr "Ich bin im Lager!"

#: scripts/supervivientes.gd
msgid "¡Aquí dentro!"
msgstr "Hier drin!"

#: scripts/supervivientes.gd
msgid "¡He atrancado la puerta!"
msgstr "Ich hab die Tür verrammelt!"

#: scripts/supervivientes.gd
msgid "¡Que alguien me oiga!"
msgstr "Hört mich jemand?!"

#: scripts/supervivientes.gd
msgid "¡Fuera tablas! Gracias, chaval. Vámonos de aquí"
msgstr "Bretter weg! Danke, Junge. Nichts wie raus hier"

#: scripts/supervivientes.gd
msgid "Va a por los durmientes que ve y les da martillazos (8 de daño)"
msgstr "Geht auf Schläfer in Sicht los und haut mit dem Hammer zu (8 Schaden)"

#: scripts/supervivientes.gd
msgid "¡SOY FARMACÉUTICA!"
msgstr "ICH BIN APOTHEKERIN!"

#: scripts/supervivientes.gd
msgid "Farmacéutica"
msgstr "Apothekerin"

#: scripts/supervivientes.gd
msgid "¡Estoy en la rebotica!"
msgstr "Ich bin im Hinterzimmer!"

#: scripts/supervivientes.gd
msgid "¡Estoy herida!"
msgstr "Ich bin verletzt!"

#: scripts/supervivientes.gd
msgid "¡Ayuda, por favor!"
msgstr "Hilfe, bitte!"

#: scripts/supervivientes.gd
msgid "¡Aquí detrás!"
msgstr "Hier hinten!"

#: scripts/supervivientes.gd
msgid "¡Me han mordido la pierna! No puedo correr"
msgstr "Mein Bein ist zerbissen! Ich kann nicht rennen"

#: scripts/supervivientes.gd
msgid "Los charcos de veneno y ácido te hacen la mitad"
msgstr "Gift- und Säurepfützen machen dir nur halben Schaden"

#: scripts/supervivientes.gd
msgid "Cada partida empiezas con un botiquín en la mochila"
msgstr "Du startest jede Runde mit einem Medikit im Rucksack"

#: scripts/supervivientes.gd
msgid "¡SOY TÉCNICO!"
msgstr "ICH BIN TECHNIKER!"

#: scripts/supervivientes.gd
msgid "Técnico"
msgstr "Techniker"

#: scripts/supervivientes.gd
msgid "¡No toquéis el agua!"
msgstr "Nicht ins Wasser!"

#: scripts/supervivientes.gd
msgid "¡Que alguien me saque!"
msgstr "Holt mich hier raus!"

#: scripts/supervivientes.gd
msgid "¡Gracias! Antes de irnos tengo que arreglar ese cable pelado"
msgstr "Danke! Bevor wir gehen, muss ich das blanke Kabel da flicken"

#: scripts/supervivientes.gd
msgid "Cada 3 s, una descarga deja quieto 1,5 s al durmiente más cercano"
msgstr "Alle 3 s lähmt ein Stromstoß den nächsten Schläfer für 1,5 s"

#: scripts/supervivientes.gd
msgid "Arregla las cámaras de seguridad: el minimapa enseña los durmientes"
msgstr "Repariert die Überwachungskameras: Die Minikarte zeigt die Schläfer"

#: scripts/supervivientes.gd
msgid "¡SOY INFORMÁTICO!"
msgstr "ICH BIN INFORMATIKER!"

#: scripts/supervivientes.gd
msgid "Informático joven"
msgstr "IT-Azubi"

#: scripts/supervivientes.gd
msgid "¡Estoy en la sala de servidores!"
msgstr "Ich bin im Serverraum!"

#: scripts/supervivientes.gd
msgid "¡No me dejéis aquí!"
msgstr "Lasst mich nicht hier!"

#: scripts/supervivientes.gd
msgid "¡Gracias! Pero no me voy sin los archivos de Velaria"
msgstr "Danke! Aber ohne Velarias Dateien gehe ich nicht"

#: scripts/supervivientes.gd
msgid "Cada 4 s, se cuela en el cerebro del durmiente más cercano y lo deja quieto 1 s; las cámaras no le ven"
msgstr "Alle 4 s hackt er das Hirn des nächsten Schläfers und friert ihn 1 s ein; Kameras sehen ihn nicht"

#: scripts/supervivientes.gd
msgid "Precio de empleado: la tienda del ordenador, un 15 % más barata"
msgstr "Mitarbeiterrabatt: Der Computerladen ist 15 % billiger"

#: scripts/supervivientes.gd
msgid "¡SOY LIMPIADORA!"
msgstr "ICH BIN PUTZFRAU!"

#: scripts/supervivientes.gd
msgid "Limpiadora de noche"
msgstr "Nachtputzfrau"

#: scripts/supervivientes.gd
msgid "¡Cerrad el gas!"
msgstr "Dreht das Gas ab!"

#: scripts/supervivientes.gd
msgid "¡Las válvulas!"
msgstr "Die Ventile!"

#: scripts/supervivientes.gd
msgid "¡Aquí dentro! *cof, cof*"
msgstr "Hier drin! *hust, hust*"

#: scripts/supervivientes.gd
msgid "¡No puedo respirar!"
msgstr "Ich krieg keine Luft!"

#: scripts/supervivientes.gd
msgid "¡Aire! Gracias, chico. Yo también limpio este edificio de noche"
msgstr "Luft! Danke, Junge. Ich putze dieses Gebäude auch nachts"

#: scripts/supervivientes.gd
msgid "Friega por donde pasa: quita los charcos de veneno, de ácido y los que resbalan"
msgstr "Wischt, wo sie langgeht: entfernt Gift-, Säure- und rutschige Pfützen"

#: scripts/supervivientes.gd
msgid "Te arregla la fregona: el fregonazo barre más ancho"
msgstr "Repariert deinen Mopp: Mopp-Hiebe fegen breiter"

#: scripts/supervivientes.gd
msgid "¡SOY RECEPCIONISTA!"
msgstr "ICH BIN EMPFANGSDAME!"

#: scripts/supervivientes.gd
msgid "Recepcionista"
msgstr "Empfangsdame"

#: scripts/supervivientes.gd
msgid "¡Estoy en recepción!"
msgstr "Ich bin am Empfang!"

#: scripts/supervivientes.gd
msgid "¡Detrás del mostrador!"
msgstr "Hinter dem Tresen!"

#: scripts/supervivientes.gd
msgid "¡No puedo subir la persiana!"
msgstr "Ich krieg das Rollgitter nicht hoch!"

#: scripts/supervivientes.gd
msgid "¡Por fin alguien vivo! Abro los tornos y nos vamos"
msgstr "Endlich jemand Lebendiges! Ich öffne die Drehkreuze, und wir hauen ab"

#: scripts/supervivientes.gd
msgid "Te avisa con un «¡Detrás!» cuando un durmiente va a pegarte por la espalda"
msgstr "Ruft „Hinter dir!“, wenn dich ein Schläfer von hinten erwischen will"

#: scripts/supervivientes.gd
msgid "Al llegar a cada planta, te dice dónde está lo que abre la sala del jefe"
msgstr "Sagt dir auf jedem Stockwerk, wo das ist, was den Bossraum öffnet"

#: scripts/supervivientes.gd
msgid "¡NO ME DEJES AQUÍ!"
msgstr "LASS MICH NICHT HIER!"

#: scripts/supervivientes.gd
msgid "¡Estoy en el baño!"
msgstr "Ich bin im Bad!"

#: scripts/supervivientes.gd
msgid "¡YA FALTA POCO!"
msgstr "GLEICH GESCHAFFT!"

#: scripts/supervivientes.gd
msgid "¡MALDITA PUERTA!"
msgstr "VERDAMMTE TÜR!"

#: scripts/supervivientes.gd
msgid "¡CASI LO TENGO!"
msgstr "FAST HAB ICH ES!"

#: scripts/supervivientes.gd
msgid "¡PROTÉGEME, ABRIRÉ LA PUERTA!"
msgstr "BESCHÜTZ MICH, ICH ÖFFNE DIE TÜR!"

#: scripts/supervivientes.gd
msgid "¡LO CONSEGUÍ, VÁMONOS!"
msgstr "GESCHAFFT, WEG HIER!"

#: scripts/supervivientes.gd
msgid "¡JOHNNY, VUELVE!"
msgstr "JOHNNY, ZURÜCK!"

#: scripts/supervivientes.gd
msgid "¡AYÚDAME!"
msgstr "HILF MIR!"

#: scripts/supervivientes.gd
msgid "el salón"
msgstr "das Wohnzimmer"

#: scripts/supervivientes.gd
msgid "la cocina"
msgstr "die Küche"

#: scripts/supervivientes.gd
msgid "el dormitorio"
msgstr "das Schlafzimmer"

#: scripts/supervivientes.gd
msgid "el baño"
msgstr "das Bad"

#: scripts/supervivientes.gd
msgid "el pasillo"
msgstr "den Flur"

#: scripts/supervivientes.gd
msgid "la tienda"
msgstr "den Laden"

#: scripts/supervivientes.gd
msgid "el almacén"
msgstr "das Lager"

#: scripts/supervivientes.gd
msgid "la cámara"
msgstr "den Kühlraum"

#: scripts/supervivientes.gd
msgid "el taller"
msgstr "die Werkstatt"

#: scripts/supervivientes.gd
msgid "las taquillas"
msgstr "den Spindraum"

#: scripts/supervivientes.gd
msgid "los probadores"
msgstr "die Anprobe"

#: scripts/supervivientes.gd
msgid "la rebotica"
msgstr "das Hinterzimmer"

