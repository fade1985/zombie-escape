#: scripts/logros.gd
msgid "Derrota a 25 jefes, sumando todas tus partidas."
msgstr "Besiege 25 Bosse, über alle Runden gezählt."

#: scripts/logros.gd
msgid "Fregona de oro"
msgstr "Goldener Mopp"

#: scripts/logros.gd
msgid "Mata 10 zombis a fregonazos en una misma partida."
msgstr "Erledige 10 Zombies mit dem Mopp in einer einzigen Runde."

#: scripts/logros.gd
msgid "Exterminador"
msgstr "Kammerjäger"

#: scripts/logros.gd
msgid "Mata 100 zombis, sumando todas tus partidas."
msgstr "Erledige 100 Zombies, über alle Runden gezählt."

#: scripts/logros.gd
msgid "Limpieza general"
msgstr "Frühjahrsputz"

#: scripts/logros.gd
msgid "Mata 1.000 zombis, sumando todas tus partidas."
msgstr "Erledige 1.000 Zombies, über alle Runden gezählt."

#: scripts/logros.gd
msgid "Pirómano"
msgstr "Pyromane"

#: scripts/logros.gd
msgid "Prende fuego a 5 zombis con un mismo molotov."
msgstr "Zünde 5 Zombies mit einem einzigen Molotow an."

#: scripts/logros.gd
msgid "Racha imparable"
msgstr "Nicht zu stoppen"

#: scripts/logros.gd
msgid "Mata 30 zombis seguidos sin perder vida."
msgstr "Erledige 30 Zombies am Stück, ohne Leben zu verlieren."

#: scripts/logros.gd
msgid "Intocable"
msgstr "Unberührt"

#: scripts/logros.gd
msgid "Pasa una planta entera, de la llegada a las escaleras, sin perder vida."
msgstr "Schaff einen ganzen Stock, von der Ankunft bis zur Treppe, ohne Leben zu verlieren."

#: scripts/logros.gd
msgid "Sin tiritas"
msgstr "Ohne Pflaster"

#: scripts/logros.gd
msgid "Gana una partida sin curarte con vendas ni botiquín."
msgstr "Gewinne eine Runde, ohne dich mit Verbänden oder Medikit zu heilen."

#: scripts/logros.gd
msgid "Manitas"
