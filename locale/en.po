#: scripts/talentos.gd
msgid "Camorrista"
msgstr "Brawler"

#: scripts/talentos.gd
msgid "+10 % de daño cuerpo a cuerpo por punto"
msgstr "+10% melee damage per point"

#: scripts/talentos.gd
msgid "Tirador"
msgstr "Gunner"

#: scripts/talentos.gd
msgid "+10 % de daño con armas a distancia por punto"
msgstr "+10% damage with ranged weapons per point"

#: scripts/talentos.gd
msgid "Artificiero"
msgstr "Demolitions"

#: scripts/talentos.gd
msgid "+1 molotov y +1 granada por punto"
msgstr "+1 molotov and +1 grenade per point"

#: scripts/talentos.gd
msgid "Larguirucho"
msgstr "Lanky"

#: scripts/talentos.gd
msgid "Duplica el alcance cuerpo a cuerpo"
msgstr "Doubles your melee range"

#: scripts/talentos.gd
msgid "Mirilla"
msgstr "Scope"

#: scripts/talentos.gd
msgid "Uno de cada 3 disparos es un crítico seguro (doble daño)"
msgstr "Every 3rd shot is a guaranteed crit (double damage)"

#: scripts/talentos.gd
msgid "Fabricante"
msgstr "Bomb Maker"

#: scripts/talentos.gd
msgid "Fuego y explosiones más grandes, y el fuego dura más"
msgstr "Bigger fire and explosions, and the fire lasts longer"

#: scripts/talentos.gd
msgid "Frenesí"
msgstr "Frenzy"

#: scripts/talentos.gd
msgid "Golpeas cuerpo a cuerpo un 10 % más rápido por punto"
msgstr "You attack 10% faster in melee per point"

#: scripts/talentos.gd
msgid "Gatillo fácil"
msgstr "Trigger Happy"

#: scripts/talentos.gd
msgid "Disparas un 10 % más rápido y recargas un 10 % antes por punto"
msgstr "You shoot 10% faster and reload 10% faster per point"

#: scripts/talentos.gd
msgid "Racimo"
msgstr "Cluster"

#: scripts/talentos.gd
msgid "El molotov y la granada sueltan 1 más pequeño alrededor por punto"
msgstr "Molotovs and grenades drop 1 extra mini one around them per point"

#: scripts/talentos.gd
msgid "Veterano"
msgstr "Veteran"

#: scripts/talentos.gd
msgid "Críticos del 5 % al 15 % de las veces, y cada uno hace el triple de daño"
msgstr "Crit chance goes from 5% to 15%, and each crit does triple damage"

#: scripts/talentos.gd
msgid "Corpulento"
msgstr "Burly"

#: scripts/talentos.gd
msgid "+10 % de vida máxima por punto"
msgstr "+10% max health per point"

#: scripts/talentos.gd
msgid "Ajolote"
msgstr "Axolotl"

#: scripts/talentos.gd
msgid "Regeneras 1 de vida cada 5 segundos por punto, hasta la mitad de tu vida"
msgstr "Regenerate 1 health every 5 seconds per point, up to half your max health"

#: scripts/talentos.gd
msgid "Durito"
msgstr "Tough Cookie"

#: scripts/talentos.gd
msgid "Cada golpe que recibes quita 1 menos por punto"
msgstr "Each hit you take does 1 less damage per point"

#: scripts/talentos.gd
msgid "Reflejos"
msgstr "Reflexes"

#: scripts/talentos.gd
msgid "Esquivas solo un golpe cada 10 s (1 s menos por cada punto más)"
msgstr "You automatically dodge one hit every 10 s (1 s less per extra point)"

#: scripts/talentos.gd
msgid "Sanitario"
msgstr "Medic"

#: scripts/talentos.gd
msgid "Los botiquines y las vendas curan 10 más por punto"
msgstr "Medkits and bandages heal 10 more per point"

#: scripts/talentos.gd
msgid "Acero"
msgstr "Steel"

#: scripts/talentos.gd
msgid "Cada planta, un escudo de 50 que se gasta antes que la vida"
msgstr "Each floor, a 50-point shield that's used up before your health"

#: scripts/talentos.gd
msgid "Ninja"
msgstr "Ninja"

#: scripts/talentos.gd
msgid "Al acabar una esquiva, golpe en área que mata a los zombis (como mucho cada 5 s)"
msgstr "After a dodge, an area strike kills zombies (at most every 5 s)"

#: scripts/talentos.gd
msgid "Desfibrilador"
msgstr "Defibrillator"

#: scripts/talentos.gd
msgid "Una vez por edificio, si caes, resucitas con toda la vida"
msgstr "Once per building, if you go down, you come back with full health"

#: scripts/talentos.gd
msgid "Blindaje"
msgstr "Armor Plating"

#: scripts/talentos.gd
msgid "El escudo de Acero tiene 25 más por punto"
msgstr "The Steel shield has 25 more per point"

#: scripts/talentos.gd
msgid "Sombra"
msgstr "Shadow"

#: scripts/talentos.gd
msgid "La esquiva se recarga un 15 % antes por punto"
msgstr "Your dodge recharges 15% faster per point"

#: scripts/talentos.gd
msgid "Segundo aliento"
msgstr "Second Wind"

#: scripts/talentos.gd
msgid "Una vez por planta, al bajar de un tercio de la vida, te curas 15 por punto"
msgstr "Once per floor, when you drop below a third of your health, you heal 15 per point"

#: scripts/talentos.gd
msgid "Adrenalina"
msgstr "Adrenaline"

#: scripts/talentos.gd
msgid "Por debajo de la mitad de la vida, +30 % de daño y +20 % de velocidad"
msgstr "Below half health, +30% damage and +20% speed"

#: scripts/talentos.gd
msgid "Catalizador"
msgstr "Catalyst"

#: scripts/talentos.gd
msgid "+10 % de daño de fuego, ácido, rayo y frío por punto"
msgstr "+10% fire, acid, lightning and cold damage per point"

#: scripts/talentos.gd
msgid "Guantes de goma"
msgstr "Rubber Gloves"

#: scripts/talentos.gd
msgid "Fuego, ácido, venenos y frío te hacen un 10 % menos por punto"
msgstr "Fire, acid, poisons and cold do 10% less to you per point"

#: scripts/talentos.gd
msgid "Incendiario"
msgstr "Incendiary"

#: scripts/talentos.gd
msgid "Los zombis que prendes arden 0,5 s más por punto"
msgstr "Zombies you ignite burn 0.5 s longer per point"

#: scripts/talentos.gd
msgid "Desatascador"
msgstr "Drain Cleaner"

#: scripts/talentos.gd
msgid "Con ácido encima, todo les quita un 10 % más por punto"
msgstr "Zombies with acid on them take 10% more damage from everything per point"

#: scripts/talentos.gd
msgid "Criogenia"
msgstr "Cryogenics"

#: scripts/talentos.gd
msgid "+1 congeladora por punto, y congelan 0,5 s más por punto"
msgstr "+1 freeze bomb per point, and they freeze 0.5 s longer per point"

#: scripts/talentos.gd
msgid "Reacción en cadena"
msgstr "Chain Reaction"

#: scripts/talentos.gd
msgid "Los zombis que mueren ardiendo revientan y prenden a los de al lado"
msgstr "Zombies that die burning burst and set the ones next to them on fire"

#: scripts/talentos.gd
msgid "Residuo tóxico"
msgstr "Toxic Waste"

#: scripts/talentos.gd
msgid "Los zombis que mueren con ácido dejan un charco de ácido (a ti no te hace nada)"
msgstr "Zombies that die with acid on them leave an acid puddle (it doesn't hurt you)"

#: scripts/talentos.gd
msgid "Pararrayos"
msgstr "Lightning Rod"

#: scripts/talentos.gd
msgid "Al zombi que te golpea le salta un rayo que lo aturde y pasa a otro (como mucho cada 3 s)"
msgstr "The zombie that hits you gets zapped by lightning that stuns it and jumps to another (at most every 3 s)"

#: scripts/talentos.gd
msgid "Napalm"
msgstr "Napalm"

#: scripts/talentos.gd
msgid "El fuego del molotov dura 1 s más por punto"
msgstr "Molotov fire lasts 1 s longer per point"

#: scripts/talentos.gd
msgid "Pegajoso"
msgstr "Sticky"

#: scripts/talentos.gd
msgid "Los zombis con ácido van un 10 % más lentos por punto"
msgstr "Zombies with acid on them move 10% slower per point"

#: scripts/talentos.gd
msgid "Alto voltaje"
msgstr "High Voltage"

#: scripts/talentos.gd
msgid "El rayo del lanza rayos y el de Pararrayos saltan a 1 zombi más por punto"
msgstr "The lightning gun's bolt and the Lightning Rod's bolt jump to 1 more zombie per point"

#: scripts/talentos.gd
msgid "Mezcla explosiva"
msgstr "Explosive Mix"

#: scripts/talentos.gd
msgid "Los zombis que mueren con dos efectos a la vez (fuego, ácido, rayo o frío) explotan (a ti no te hace nada)"
msgstr "Zombies that die with two effects at once (fire, acid, lightning or cold) explode (it doesn't hurt you)"

#: scripts/tutoriales.gd
msgid "Apunta y ataca con {apuntar}."
msgstr "Aim and attack with {apuntar}."

#: scripts/tutoriales.gd
msgid "Apunta con {apuntar} y ataca con {atacar}."
msgstr "Aim with {apuntar} and attack with {atacar}."

#: scripts/tutoriales.gd
msgid "Johnny apunta y ataca solo al zombi más cercano: tú preocúpate de moverte."
msgstr "Johnny aims and attacks the nearest zombie on his own: you just worry about moving."

#: scripts/tutoriales.gd
msgid "el joystick (toca y arrastra en la mitad izquierda)"
msgstr "the joystick (touch and drag on the left half)"

#: scripts/tutoriales.gd
msgid "el stick izquierdo"
msgstr "the left stick"

#: scripts/tutoriales.gd
msgid "el joystick de abajo a la derecha"
msgstr "the joystick at the bottom right"

#: scripts/tutoriales.gd
msgid "el stick derecho"
msgstr "the right stick"

#: scripts/tutoriales.gd
msgid "el ratón"
msgstr "the mouse"

#: scripts/tutoriales.gd
msgid "%s o %s"
msgstr "%s or %s"

#: scripts/tutoriales.gd
msgid "Lo básico"
msgstr "The basics"

#: scripts/tutoriales.gd scripts/ui/inventario.gd scripts/ui/menus.gd scripts/ui/opciones.gd
msgid "Armas"
msgstr "Weapons"

#: scripts/tutoriales.gd
msgid "Plantas y jefes"
msgstr "Floors and bosses"

#: scripts/tutoriales.gd
msgid "Eventos sorpresa"
msgstr "Surprise events"

#: scripts/tutoriales.gd
msgid "Sala de mantenimiento"
msgstr "Maintenance room"

#: scripts/tutoriales.gd
msgid "Más edificios"
msgstr "More buildings"

#: scripts/tutoriales.gd
msgid "Cómo se juega"
msgstr "How to play"

#: scripts/tutoriales.gd
msgid "Al empezar"
msgstr "At the start"

#: scripts/tutoriales.gd
msgid "Muévete con {moverse}."
msgstr "Move with {moverse}."

#: scripts/tutoriales.gd
msgid "{atacar_modo} El modo de atacar se cambia con {cambiar_modo}."
msgstr "{atacar_modo} Change the attack mode with {cambiar_modo}."

#: scripts/tutoriales.gd
msgid "Esquiva con {esquivar}: un acelerón corto en el que no te hacen daño."
msgstr "Dodge with {esquivar}: a short dash where nothing can hurt you."

#: scripts/tutoriales.gd
msgid "Cambia entre la fregona y la pistola con {cambiar_arma}, y pausa el juego con {pausa}."
msgstr "Swap between the mop and the pistol with {cambiar_arma}, and pause the game with {pausa}."

#: scripts/tutoriales.gd
msgid "Limpia los apartamentos"
msgstr "Clear the apartments"

#: scripts/tutoriales.gd
msgid "Al salir al pasillo"
msgstr "On stepping into the hallway"

#: scripts/tutoriales.gd
msgid "Al entrar en un apartamento, la puerta se cierra detrás de ti y no se abre hasta que no queda ni un zombi."
msgstr "Walk into an apartment and the door shuts behind you. It stays shut until not a single zombie is left."

#: scripts/tutoriales.gd
msgid "La sala del jefe de la planta está cerrada con llave: la lleva un zombi de otro apartamento y la suelta al caer."
msgstr "The floor boss's room is locked. A zombie in another apartment carries the key and drops it when it dies."

#: scripts/tutoriales.gd
msgid "Vence al jefe y se abren las escaleras a la planta siguiente."
msgstr "Beat the boss and the stairs to the next floor open up."

#: scripts/tutoriales.gd
msgid "La vida en tercios"
msgstr "Health in thirds"

#: scripts/tutoriales.gd
msgid "Al perder un tercio de vida"
msgstr "On losing a third of your health"

#: scripts/tutoriales.gd
msgid "Tu vida está partida en tres tercios. El que pierdes ya no se cura con vendas, y por cada uno andas más lento."
msgstr "Your health is split into thirds. Bandages can't heal a third you've lost, and each lost third slows you down."

#: scripts/tutoriales.gd
msgid "Solo el botiquín devuelve un tercio perdido."
msgstr "Only a medkit brings back a lost third."

#: scripts/tutoriales.gd
msgid "Si se te hace cuesta arriba, en Opciones → Ayudas está «Vida entera»."
msgstr "If it gets too hard, Options → Assists has \"Whole health\"."

#: scripts/tutoriales.gd scripts/ui/opciones.gd
msgid "Vendas y botiquín"
msgstr "Bandages and medkit"

#: scripts/tutoriales.gd
msgid "Al coger la primera cura"
msgstr "On picking up your first heal"

#: scripts/tutoriales.gd
msgid "Las vendas se usan con {usar_vendas}: curan 25, sin pasar del tercio en el que estás."
msgstr "Use bandages with {usar_vendas}: they heal 25, without going past the third you're in."

#: scripts/tutoriales.gd
msgid "El botiquín, con {usar_botiquin}: devuelve un tercio perdido y cura 50."
msgstr "Use the medkit with {usar_botiquin}: it restores a lost third and heals 50."

#: scripts/tutoriales.gd
msgid "Caben 3 vendas y 2 botiquines. Los armaritos de los baños se abren al acercarte y sueltan lo suyo."
msgstr "You can carry 3 bandages and 2 medkits. Bathroom cabinets pop open as you get close and spill what's inside."

#: scripts/tutoriales.gd
msgid "Inventario y mochila"
msgstr "Inventory and backpack"

#: scripts/tutoriales.gd
msgid "Al coger el primer objeto"
msgstr "On picking up your first item"

#: scripts/tutoriales.gd
msgid "Lo que recoges va a la mochila. El inventario se abre con {inventario}: tus armas, la munición, los lanzables y la mochila."
msgstr "Whatever you pick up goes in the backpack. Open the inventory with {inventario}: your weapons, ammo, throwables and backpack."

#: scripts/tutoriales.gd
msgid "Elige una casilla para ver su ficha y sus botones (usar, ponérmela, tirar...)."
msgstr "Pick a slot to see its card and buttons (use, equip, drop...)."

#: scripts/tutoriales.gd
msgid "Si caes, lo que llevas se pierde; si completas el edificio, pasa al baúl."
msgstr "If you die, you lose what you're carrying; complete the building and it goes to the stash."

#: scripts/tutoriales.gd
msgid "Dólares"
msgstr "Dollars"

#: scripts/tutoriales.gd
msgid "Al coger el primer billete"
msgstr "On picking up your first bill"

#: scripts/tutoriales.gd
msgid "Los zombis a veces sueltan billetes, y los jefes muchos: pasa por encima para cogerlos."
msgstr "Zombies sometimes drop bills, and bosses drop plenty: walk over them to pick them up."

#: scripts/tutoriales.gd
msgid "Se guardan al acabar la partida: todos si completas el edificio y la mitad si caes o abandonas."
msgstr "They're saved when the run ends: all of them if you complete the building, half if you die or abandon."

#: scripts/tutoriales.gd
msgid "Se gastan en el ordenador de la sala de mantenimiento."
msgstr "You spend them on the computer in the maintenance room."

#: scripts/tutoriales.gd
msgid "Armas nuevas"
msgstr "New weapons"

#: scripts/tutoriales.gd
msgid "Al llevar otra arma"
msgstr "On carrying another weapon"

#: scripts/tutoriales.gd
msgid "Llevas dos armas en la mano: una de cuerpo a cuerpo y otra a distancia. Cambias de una a otra con {cambiar_arma}."
msgstr "You hold two weapons: one melee and one ranged. Swap between them with {cambiar_arma}."

#: scripts/tutoriales.gd
msgid "Las demás van de repuesto, una de cada tipo, y se cambian en el inventario ({inventario})."
msgstr "The rest are spares, one of each type, and you swap them in the inventory ({inventario})."

#: scripts/tutoriales.gd
msgid "El color del borde es su calidad: gris Normal, verde Poco común, azul Rara y morado Épica."
msgstr "The border color shows its quality: gray Normal, green Uncommon, blue Rare and purple Epic."

#: scripts/tutoriales.gd
msgid "Munición y recarga"
msgstr "Ammo and reloading"

#: scripts/tutoriales.gd
msgid "Al recargar"
msgstr "On reloading"

#: scripts/tutoriales.gd
msgid "Recarga con {recargar}; al vaciarse el cargador, recarga solo."
msgstr "Reload with {recargar}; an empty magazine reloads by itself."

#: scripts/tutoriales.gd
msgid "Cada arma gasta la suya (balas, cartuchos...). Una caja de munición del suelo te da un cargador."
msgstr "Each weapon uses its own (bullets, shells...). An ammo box on the floor gives you one magazine."

#: scripts/tutoriales.gd
msgid "Sin munición, Johnny saca el arma de cuerpo a cuerpo."
msgstr "Out of ammo, Johnny pulls out his melee weapon."

#: scripts/tutoriales.gd
msgid "Lanzables"
msgstr "Throwables"

#: scripts/tutoriales.gd
msgid "En la primera pelea"
msgstr "In the first fight"

#: scripts/tutoriales.gd
msgid "Lanza con {lanzar}: mantén para apuntar y suelta para lanzar."
msgstr "Throw with {lanzar}: hold to aim, release to throw."

#: scripts/tutoriales.gd
msgid "Lo que lanzas se cambia con {cambiar_lanzable}: el molotov prende fuego y la granada explota. Llevas 3 a mano y hasta 8 de repuesto."
msgstr "Switch what you throw with {cambiar_lanzable}: the Molotov starts a fire and the grenade explodes. You carry 3 in hand and up to 8 spare."

#: scripts/tutoriales.gd
msgid "¡Ojo! La explosión también te hace daño a ti."
msgstr "Careful! The blast hurts you too."

#: scripts/tutoriales.gd
msgid "Piezas de mejora"
msgstr "Upgrade parts"

#: scripts/tutoriales.gd
msgid "Al coger la primera pieza"
msgstr "On picking up your first part"

#: scripts/tutoriales.gd
msgid "Con las piezas se sube la calidad de las armas y los lanzables, en el banco de trabajo de la sala de mantenimiento."
msgstr "Parts raise the quality of your weapons and throwables at the workbench in the maintenance room."

#: scripts/tutoriales.gd
msgid "Hay de cuatro familias: cuerpo a cuerpo, a distancia, especiales y arrojables. Las sueltan los zombis de vez en cuando y los jefes."
msgstr "They come in four kinds: melee, ranged, special and throwable. Zombies drop them now and then, and bosses do too."

#: scripts/tutoriales.gd
msgid "Van en la mochila: si completas el edificio, pasan al baúl."
msgstr "Backpack first; complete the building and they go to the stash."

#: scripts/tutoriales.gd
msgid "Al llegar al primer jefe"
msgstr "On reaching the first boss"

#: scripts/tutoriales.gd
msgid "Cada planta tiene su jefe, con su barra de vida arriba. A media vida se enfada y se vuelve más peligroso."
msgstr "Every floor has its boss, with a health bar at the top. At half health it gets angry and more dangerous."

#: scripts/tutoriales.gd
msgid "Antes de cada ataque marca el suelo: ¡sal de la marca o esquívala!"
msgstr "It marks the floor before every attack: step out or dodge it!"

#: scripts/tutoriales.gd
msgid "Al caer suelta dólares, munición y piezas, y se abren las escaleras."
msgstr "When it goes down it drops dollars, ammo and parts, and the stairs open."

#: scripts/tutoriales.gd scripts/ui/menus.gd
msgid "Mutaciones"
msgstr "Mutations"

#: scripts/tutoriales.gd
msgid "Antes de la primera mutación"
msgstr "Before your first mutation"

#: scripts/tutoriales.gd
msgid "Al vencer a un jefe, el virus te cambia: elige una de las dos cartas (también con 1 y 2)."
msgstr "Beat a boss and the virus changes you: pick one of the two cards (1 and 2 work too)."

#: scripts/tutoriales.gd
msgid "Cada mutación te da algo bueno y, a veces, algo malo."
msgstr "Every mutation has an upside and, sometimes, a downside."

#: scripts/tutoriales.gd
msgid "Duran hasta que acaba la partida, y llevas como mucho 4."
msgstr "They last until the run ends, and you can have 4 at most."

#: scripts/tutoriales.gd
msgid "El ascensor"
msgstr "The elevator"

#: scripts/tutoriales.gd
msgid "Al arreglar el ascensor"
msgstr "On fixing the elevator"

#: scripts/tutoriales.gd
msgid "Johnny ha arreglado el ascensor del pasillo: baja a la sala de mantenimiento y vuelve a esta misma planta."
msgstr "Johnny fixed the elevator in the hallway: it goes down to the maintenance room and back to this same floor."

#: scripts/tutoriales.gd
msgid "Úsalo para ir al ordenador, al banco de trabajo o al baúl en mitad de la partida."
msgstr "Use it to get to the computer, the workbench or the stash in the middle of a run."

#: scripts/tutoriales.gd
msgid "Al rescatar al primero"
msgstr "On rescuing the first one"

#: scripts/tutoriales.gd
msgid "Se une al equipo: te acompaña y te ayuda a su manera."
msgstr "A survivor joins the team and helps in their own way."

#: scripts/tutoriales.gd
msgid "Cada uno tiene su rescate. No te alejes de él y, si cae, quédate a su lado para levantarlo."
msgstr "Each one is rescued differently. Don't wander off, and if they go down, stay by their side to get them back up."

#: scripts/tutoriales.gd
msgid "Si completas el edificio con él, se muda a las viviendas (la puerta de la derecha de la sala de mantenimiento) y podrá acompañarte."
msgstr "Complete the building with them and they move into the living quarters (right door in the maintenance room) and can join you."

#: scripts/tutoriales.gd
msgid "En el primer apagón"
msgstr "In the first blackout"

#: scripts/tutoriales.gd
msgid "Se ha ido la luz en toda la planta: solo ves lo que alumbra tu linterna, hacia donde miras."
msgstr "The power is out on the whole floor: you only see what your flashlight lights up, where you're looking."

#: scripts/tutoriales.gd
msgid "En la sala del jefe todo sigue como siempre."
msgstr "The boss room is business as usual."

#: scripts/tutoriales.gd
msgid "Al subir a la planta siguiente, te llevas un premio en dólares."
msgstr "Go up to the next floor and you get a dollar bonus."

#: scripts/tutoriales.gd
msgid "En la primera alarma de incendios"
msgstr "In the first fire alarm"

#: scripts/tutoriales.gd
msgid "Los aspersores llenan el suelo de charcos que resbalan."
msgstr "The sprinklers cover the floor with slippery puddles."

#: scripts/tutoriales.gd
msgid "En algunos cae un cable pelado que da calambrazos a Johnny y a los zombis: ¡llévalos hasta él! Esquivando cruzas sin daño."
msgstr "In some, a bare wire falls and zaps Johnny and the zombies: lead them to it! Dodging lets you cross unharmed."

#: scripts/tutoriales.gd
msgid "En la primera horda"
msgstr "In the first horde"

#: scripts/tutoriales.gd
msgid "Una horda enorme llena el pasillo y va a por ti."
msgstr "A huge horde fills the hallway and comes for you."

#: scripts/tutoriales.gd
msgid "Si te metes en un piso, los que queden te esperan fuera. Aquí los lanzables vienen de perlas."
msgstr "If you duck into an apartment, the ones left behind wait outside. Throwables are a godsend here."

#: scripts/tutoriales.gd
msgid "Al acabar con todos, te deja dólares y una caja de munición."
msgstr "Kill them all and it pays out dollars and a box of ammo."

#: scripts/tutoriales.gd
msgid "El ordenador"
msgstr "The computer"

#: scripts/tutoriales.gd
msgid "Al encender el ordenador"
msgstr "On turning on the computer"

#: scripts/tutoriales.gd
msgid "Gasta los dólares ahorrados: puntos de talento (mejoras para siempre) y armas y lanzables para la partida."
msgstr "Spend your saved dollars on talent points (permanent upgrades) and on weapons and throwables for the run."

#: scripts/tutoriales.gd
msgid "También están los logros, que dan premio, el Dosier, las Noticias y las Colecciones."
msgstr "There are also achievements, which pay out, plus the Dossier, the News and the Collections."

#: scripts/tutoriales.gd
msgid "La taquilla"
msgstr "The locker"

#: scripts/tutoriales.gd
msgid "Al abrir la taquilla"
msgstr "On opening the locker"

#: scripts/tutoriales.gd
msgid "Aquí eliges la ropa de Johnny. Cada una tiene su ventaja."
msgstr "Pick Johnny's outfit here. Each one has its own advantage."

#: scripts/tutoriales.gd
msgid "Se consiguen venciendo a ciertos jefes: las que te faltan salen con «???» y cómo conseguirlas."
msgstr "You earn them by beating certain bosses: the ones you're missing show \"???\" and how to get them."

#: scripts/tutoriales.gd
msgid "El banco de trabajo"
msgstr "The workbench"

#: scripts/tutoriales.gd
msgid "Al usar el banco de trabajo"
msgstr "On using the workbench"

#: scripts/tutoriales.gd
msgid "Sube la calidad de tus armas y lanzables, nivel a nivel, con las piezas de su familia (las de la mochila y las del baúl)."
msgstr "Raise the quality of your weapons and throwables, level by level, with parts of their kind (backpack and stash)."

#: scripts/tutoriales.gd
msgid "Normal, Poco común, Rara y Épica: la Épica trae además un truco."
msgstr "Normal, Uncommon, Rare and Epic: Epic also comes with a perk."

#: scripts/tutoriales.gd
msgid "Elige la casilla y pulsa «Mejorar»."
msgstr "Pick the slot and hit \"Upgrade\"."

#: scripts/tutoriales.gd
msgid "El baúl"
msgstr "The stash"

#: scripts/tutoriales.gd
