# Traducción al inglés de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


#: scripts/alerta.gd
msgid "Mejora %d"
msgstr "Upgrade %d"

#: scripts/alerta.gd
msgid "Sin mejora"
msgstr "No upgrade"

#: scripts/alerta.gd
msgid "Mejora %d del compuesto VD-7"
msgstr "VD-7 compound upgrade %d"

#: scripts/alerta.gd
msgid "Enemigos +%d %%: cantidad, vida, daño, velocidad y ataque"
msgstr "Enemies +%d %%: number, health, damage, speed and attack"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "As usual"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "Behind you!"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Stay close to help them up"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "FWEEEET!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "GET BACK!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "YOU'RE UNDER ARREST!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "CLANK!"

#: scripts/armas.gd
msgid "Durabilidad: %d"
msgstr "Durability: %d"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "swing %d %% longer and wider"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "magazine %d %% bigger and reload %d %% faster"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d durmiente más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d durmientes más"
msgstr[0] "tank %d %% bigger and the discharge jumps to %d more sleeper"
msgstr[1] "tank %d %% bigger and the discharge jumps to %d more sleepers"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "tank %d %% bigger"

#: scripts/armas.gd
msgid "radio un %d %% más grande"
msgstr "radius %d %% bigger"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: damage +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Perk: every %d hits they land, one is a crit (double damage)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un durmiente y siguen."
msgstr "Perk: its bullets pierce a sleeper and keep going."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d durmientes y siguen."
msgstr "Perk: its bullets pierce %d sleepers and keep going."

#: scripts/armas.gd
msgid "Truco: los durmientes que mata revientan y pasan su efecto a los de al lado."
msgstr "Perk: sleepers it kills burst and pass their effect to the ones next to them."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Perk: when it breaks, it drops %d smaller ones around it."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Perk: when it explodes, it drops %d smaller ones around it."

