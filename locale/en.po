msgid "Resumen"
msgstr "Summary"

#: scripts/ui/archivador_logros.gd
msgid "Partida con ayudas: no da logros"
msgstr "Game with assists: no achievements"

#: scripts/ui/archivador_logros.gd
msgid "Casi lo tienes"
msgstr "Almost there"

#: scripts/ui/archivador_logros.gd
msgid "Por cobrar"
msgstr "To claim"

#: scripts/ui/archivador_logros.gd
msgid "Y %d más: búscalos por el «!» de la izquierda."
msgstr "And %d more: look for the «!» on the left."

#: scripts/ui/archivador_logros.gd
