# Traducción al inglés de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alert %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "No alert"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "As usual"

#: scripts/alerta.gd
msgid ""
"%s\n"
"+%d %% de dólares"
msgstr ""
"%s\n"
"+%d %% dollars"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de materiales"
msgstr ""
"%s%s\n"
"+%d %% dollars and materials"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (and the previous ones)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % zombies"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Zombies 10 % faster"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Bosses with +25 % health, and they get angry sooner"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Medkits, bandages and Axolotl heal half as much"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "The guard (or the key zombie) takes twice the damage and zombies hear you from farther away"

#: scripts/alerta.gd
msgid "Cada ordenador del código llama a dos escoltas y los zombis te oyen más lejos"
msgstr "Each code computer calls two bodyguards and zombies hear you from farther away"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "Behind you!"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Stay close to help them up"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Can I tag along?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "FWEEEET!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "GET BACK!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "YOU'RE UNDER ARREST!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "CLANK!"

#: scripts/armas.gd
msgid "Última partida: al acabarla, se destruye"
msgstr "Last run: it breaks when this one ends"

#: scripts/armas.gd
msgid "Le queda %d partida más después de esta"
msgid_plural "Le quedan %d partidas más después de esta"
msgstr[0] "%d more run left after this one"
msgstr[1] "%d more runs left after this one"

#: scripts/armas.gd
msgid "Le queda %d partida"
msgid_plural "Le quedan %d partidas"
msgstr[0] "%d run left"
msgstr[1] "%d runs left"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "swing %d %% longer and wider"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "magazine %d %% bigger and reload %d %% faster"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "tank %d %% bigger and the discharge jumps to %d more zombie"
msgstr[1] "tank %d %% bigger and the discharge jumps to %d more zombies"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "tank %d %% bigger"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "radius %d %% bigger and %d more fit per stack"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: damage +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Perk: every %d hits they land, one is a crit (double damage)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Perk: its bullets pierce a zombie and keep going."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Perk: its bullets pierce %d zombies and keep going."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Perk: zombies it kills burst and pass their effect to the ones next to them."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Perk: when it breaks, it drops %d smaller ones around it."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Perk: when it explodes, it drops %d smaller ones around it."

