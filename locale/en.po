msgstr "Claim $%d"

#: scripts/ui/archivador_logros.gd
msgid "Hecho"
msgstr "Done"

#: scripts/ui/aviso_luces.gd
msgid "Aviso de fotosensibilidad"
msgstr "Photosensitivity warning"

#: scripts/ui/aviso_luces.gd
msgid "Este juego contiene destellos, luces intermitentes y explosiones que pueden desencadenar ataques epilépticos en personas con epilepsia fotosensible."
msgstr "This game contains flashes, flickering lights and explosions that may trigger epileptic seizures in people with photosensitive epilepsy."

#: scripts/ui/aviso_luces.gd
msgid "Si tú o algún familiar tenéis antecedentes de ataques epilépticos, consulta a un médico antes de jugar."
msgstr "If you or anyone in your family has a history of epileptic seizures, consult a doctor before playing."

#: scripts/ui/aviso_luces.gd
msgid "Suspende el juego inmediatamente y consulta a un médico si experimentas mareos, alteraciones en la visión, tics oculares o musculares, movimientos involuntarios o desorientación."
msgstr "Stop playing immediately and consult a doctor if you experience dizziness, altered vision, eye or muscle twitching, involuntary movements or disorientation."

#: scripts/ui/aviso_luces.gd scripts/ui/relato.gd
msgid "Toca la pantalla para continuar"
msgstr "Tap the screen to continue"

#: scripts/ui/aviso_luces.gd
msgid "Pulsa cualquier botón para continuar"
msgstr "Press any button to continue"

#: scripts/ui/aviso_luces.gd
msgid "Pulsa cualquier tecla para continuar"
msgstr "Press any key to continue"

