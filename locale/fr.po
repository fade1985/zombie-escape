# Traducción al francés de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alerte %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Sans alerte"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Comme d'habitude"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"+%d %% de dollars et de pièces"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (et les précédentes)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % de zombies"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Zombies 10 % plus rapides"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Boss avec +25 % de vie, et ils s'énervent plus tôt"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Médikits, bandages et Axolotl soignent moitié moins"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "Le garde (ou le zombie à la clé) encaisse deux fois plus et les zombies t'entendent de plus loin"

#: scripts/alerta.gd
msgid "Cada ordenador del código llama a dos escoltas y los zombis te oyen más lejos"
msgstr "Chaque ordinateur du code appelle deux gardes du corps et les zombies t'entendent de plus loin"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "Derrière toi !"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Reste près de lui pour le relever"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Au secours !"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "Emmène-moi !"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Je viens avec toi ?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "PRIIIIIT !"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "RECULE !"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "TU ES ARRÊTÉ !"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "CLONG !"

#: scripts/armas.gd
msgid "Última partida: al acabarla, se destruye"
msgstr "Dernière partie : elle se détruit à la fin"

#: scripts/armas.gd
msgid "Le queda %d partida más después de esta"
msgid_plural "Le quedan %d partidas más después de esta"
msgstr[0] "Encore %d partie après celle-ci"
msgstr[1] "Encore %d parties après celle-ci"

#: scripts/armas.gd
msgid "Le queda %d partida"
msgid_plural "Le quedan %d partidas"
msgstr[0] "Il reste %d partie"
msgstr[1] "Il reste %d parties"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "coup %d %% plus long et plus large"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "chargeur %d %% plus grand et rechargement %d %% plus rapide"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "réservoir %d %% plus grand et la décharge saute sur %d zombie de plus"
msgstr[1] "réservoir %d %% plus grand et la décharge saute sur %d zombies de plus"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "réservoir %d %% plus grand"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "rayon %d %% plus grand et %d de plus par pile"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s : dégâts +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Atout : tous les %d coups portés, un est critique (dégâts doublés)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Atout : ses balles transpercent un zombie et continuent."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Atout : ses balles transpercent %d zombies et continuent."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Atout : les zombies qu'elle tue éclatent et transmettent leur effet à leurs voisins."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Atout : en se brisant, il en lâche %d plus petits autour."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Atout : à l'explosion, %d mini-charges jaillissent autour."

