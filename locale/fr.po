msgid "¡Estoy en el baño!"
msgstr "Je suis aux toilettes !"

#: scripts/supervivientes.gd
msgid "¡YA FALTA POCO!"
msgstr "PRESQUE !"

#: scripts/supervivientes.gd
msgid "¡MALDITA PUERTA!"
msgstr "MAUDITE PORTE !"

#: scripts/supervivientes.gd
msgid "¡CASI LO TENGO!"
msgstr "J'Y SUIS PRESQUE !"

#: scripts/supervivientes.gd
msgid "¡PROTÉGEME, ABRIRÉ LA PUERTA!"
msgstr "PROTÈGE-MOI, J'OUVRE LA PORTE !"

#: scripts/supervivientes.gd
msgid "¡LO CONSEGUÍ, VÁMONOS!"
msgstr "J'AI RÉUSSI, ON Y VA !"

#: scripts/supervivientes.gd
msgid "¡JOHNNY, VUELVE!"
msgstr "JOHNNY, REVIENS !"

#: scripts/supervivientes.gd
msgid "¡AYÚDAME!"
msgstr "À L'AIDE !"

