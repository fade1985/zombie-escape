#: scripts/ui/inventario.gd
msgid "%d en este hueco · llevas %d"
msgstr "%d dans cet emplacement · tu en as %d"

#: scripts/ui/inventario.gd
msgid "La gastan %s (caben %d en cada hueco). Al tirarlo, el hueco entero se queda en el suelo en una caja."
msgstr "Munitions pour %s (%d par emplacement). Si tu les jettes, tout l'emplacement reste par terre dans une caisse."

#: scripts/ui/inventario.gd
msgid "Llena %s (caben %d en cada hueco). Se tira de uno en uno."
msgstr "Recharge %s (%d par emplacement). Se jette un par un."

#: scripts/ui/inventario.gd
msgid "Arrojable · %s"
msgstr "Lançable · %s"

#: scripts/ui/inventario.gd
