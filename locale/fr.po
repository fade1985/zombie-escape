#: scripts/talentos.gd
msgid "Camorrista"
msgstr "Bagarreur"

#: scripts/talentos.gd
msgid "+10 % de daño cuerpo a cuerpo por punto"
msgstr "+10 % de dégâts au corps à corps par point"

#: scripts/talentos.gd
msgid "Tirador"
msgstr "Tireur"

#: scripts/talentos.gd
msgid "+10 % de daño con armas a distancia por punto"
msgstr "+10 % de dégâts avec les armes à distance par point"

#: scripts/talentos.gd
msgid "Artificiero"
msgstr "Artificier"

#: scripts/talentos.gd
msgid "+1 molotov y +1 granada por punto"
msgstr "+1 molotov et +1 grenade par point"

#: scripts/talentos.gd
msgid "Larguirucho"
msgstr "Échalas"

#: scripts/talentos.gd
msgid "Duplica el alcance cuerpo a cuerpo"
msgstr "Double la portée au corps à corps"

#: scripts/talentos.gd
msgid "Mirilla"
msgstr "Lunette"

#: scripts/talentos.gd
msgid "Uno de cada 3 disparos es un crítico seguro (doble daño)"
msgstr "Un tir sur 3 est un critique assuré (dégâts doublés)"

#: scripts/talentos.gd
msgid "Fabricante"
msgstr "Fabricant"

#: scripts/talentos.gd
msgid "Fuego y explosiones más grandes, y el fuego dura más"
msgstr "Feu et explosions plus grands, et le feu dure plus longtemps"

#: scripts/talentos.gd
msgid "Frenesí"
msgstr "Frénésie"

#: scripts/talentos.gd
msgid "Golpeas cuerpo a cuerpo un 10 % más rápido por punto"
msgstr "Tu frappes 10 % plus vite au corps à corps par point"

#: scripts/talentos.gd
msgid "Gatillo fácil"
msgstr "Gâchette facile"

#: scripts/talentos.gd
msgid "Disparas un 10 % más rápido y recargas un 10 % antes por punto"
msgstr "Tu tires 10 % plus vite et recharges 10 % plus tôt par point"

#: scripts/talentos.gd
msgid "Racimo"
msgstr "Grappe"

#: scripts/talentos.gd
msgid "El molotov y la granada sueltan 1 más pequeño alrededor por punto"
msgstr "Le molotov et la grenade lâchent 1 mini-charge de plus autour par point"

#: scripts/talentos.gd
msgid "Veterano"
msgstr "Vétéran"

#: scripts/talentos.gd
msgid "Críticos del 5 % al 15 % de las veces, y cada uno hace el triple de daño"
msgstr "Critiques de 5 % à 15 % du temps, et chacun fait le triple de dégâts"

#: scripts/talentos.gd
msgid "Corpulento"
msgstr "Costaud"

#: scripts/talentos.gd
msgid "+10 % de vida máxima por punto"
msgstr "+10 % de vie maximale par point"

#: scripts/talentos.gd
msgid "Ajolote"
msgstr "Axolotl"

#: scripts/talentos.gd
msgid "Regeneras 1 de vida cada 5 segundos por punto, hasta la mitad de tu vida"
msgstr "Tu régénères 1 de vie toutes les 5 secondes par point, jusqu'à la moitié de ta vie"

#: scripts/talentos.gd
msgid "Durito"
msgstr "Dur à cuire"

#: scripts/talentos.gd
msgid "Cada golpe que recibes quita 1 menos por punto"
msgstr "Chaque coup reçu enlève 1 de moins par point"

#: scripts/talentos.gd
msgid "Reflejos"
msgstr "Réflexes"

#: scripts/talentos.gd
msgid "Esquivas solo un golpe cada 10 s (1 s menos por cada punto más)"
msgstr "Tu esquives tout seul un coup toutes les 10 s (1 s de moins par point en plus)"

#: scripts/talentos.gd
msgid "Sanitario"
msgstr "Secouriste"

#: scripts/talentos.gd
msgid "Los botiquines y las vendas curan 10 más por punto"
msgstr "Les médikits et les bandages soignent 10 de plus par point"

#: scripts/talentos.gd
msgid "Acero"
msgstr "Acier"

#: scripts/talentos.gd
msgid "Cada planta, un escudo de 50 que se gasta antes que la vida"
msgstr "À chaque étage, un bouclier de 50 qui s'use avant ta vie"

#: scripts/talentos.gd
msgid "Ninja"
msgstr "Ninja"

#: scripts/talentos.gd
msgid "Al acabar una esquiva, golpe en área que mata a los zombis (como mucho cada 5 s)"
msgstr "À la fin d'une esquive, une frappe de zone tue les zombies (au plus toutes les 5 s)"

#: scripts/talentos.gd
msgid "Desfibrilador"
msgstr "Défibrillateur"

#: scripts/talentos.gd
msgid "Una vez por edificio, si caes, resucitas con toda la vida"
msgstr "Une fois par bâtiment, si tu tombes, tu ressuscites avec toute ta vie"

#: scripts/talentos.gd
msgid "Blindaje"
msgstr "Blindage"

#: scripts/talentos.gd
msgid "El escudo de Acero tiene 25 más por punto"
msgstr "Le bouclier d'Acier gagne 25 de plus par point"

#: scripts/talentos.gd
msgid "Sombra"
msgstr "Ombre"

#: scripts/talentos.gd
msgid "La esquiva se recarga un 15 % antes por punto"
msgstr "L'esquive se recharge 15 % plus tôt par point"

#: scripts/talentos.gd
msgid "Segundo aliento"
msgstr "Second souffle"

#: scripts/talentos.gd
msgid "Una vez por planta, al bajar de un tercio de la vida, te curas 15 por punto"
msgstr "Une fois par étage, quand ta vie passe sous un tiers, tu te soignes de 15 par point"

#: scripts/talentos.gd
msgid "Adrenalina"
msgstr "Adrénaline"

#: scripts/talentos.gd
msgid "Por debajo de la mitad de la vida, +30 % de daño y +20 % de velocidad"
msgstr "Sous la moitié de ta vie, +30 % de dégâts et +20 % de vitesse"

#: scripts/talentos.gd
msgid "Catalizador"
msgstr "Catalyseur"

#: scripts/talentos.gd
msgid "+10 % de daño de fuego, ácido, rayo y frío por punto"
msgstr "+10 % de dégâts de feu, d'acide, de foudre et de froid par point"

#: scripts/talentos.gd
msgid "Guantes de goma"
msgstr "Gants de ménage"

#: scripts/talentos.gd
msgid "Fuego, ácido, venenos y frío te hacen un 10 % menos por punto"
msgstr "Le feu, l'acide, les poisons et le froid te font 10 % de moins par point"

#: scripts/talentos.gd
msgid "Incendiario"
msgstr "Incendiaire"

#: scripts/talentos.gd
msgid "Los zombis que prendes arden 0,5 s más por punto"
msgstr "Les zombies que tu enflammes brûlent 0,5 s de plus par point"

#: scripts/talentos.gd
msgid "Desatascador"
msgstr "Déboucheur"

#: scripts/talentos.gd
msgid "Con ácido encima, todo les quita un 10 % más por punto"
msgstr "Sous acide, tout leur enlève 10 % de plus par point"

#: scripts/talentos.gd
msgid "Criogenia"
msgstr "Cryogénie"

#: scripts/talentos.gd
msgid "+1 congeladora por punto, y congelan 0,5 s más por punto"
msgstr "+1 bombe gel par point, et elles gèlent 0,5 s de plus par point"

#: scripts/talentos.gd
msgid "Reacción en cadena"
msgstr "Réaction en chaîne"

#: scripts/talentos.gd
msgid "Los zombis que mueren ardiendo revientan y prenden a los de al lado"
msgstr "Les zombies qui meurent en flammes éclatent et enflamment leurs voisins"

#: scripts/talentos.gd
msgid "Residuo tóxico"
msgstr "Déchet toxique"

#: scripts/talentos.gd
msgid "Los zombis que mueren con ácido dejan un charco de ácido (a ti no te hace nada)"
msgstr "Les zombies qui meurent sous acide laissent une flaque d'acide (sans effet sur toi)"

#: scripts/talentos.gd
msgid "Pararrayos"
msgstr "Paratonnerre"

#: scripts/talentos.gd
msgid "Al zombi que te golpea le salta un rayo que lo aturde y pasa a otro (como mucho cada 3 s)"
msgstr "Le zombie qui te frappe reçoit un éclair qui l'étourdit et passe à un autre (au plus toutes les 3 s)"

#: scripts/talentos.gd
msgid "Napalm"
msgstr "Napalm"

#: scripts/talentos.gd
msgid "El fuego del molotov dura 1 s más por punto"
msgstr "Le feu du molotov dure 1 s de plus par point"

#: scripts/talentos.gd
msgid "Pegajoso"
msgstr "Poisseux"

#: scripts/talentos.gd
msgid "Los zombis con ácido van un 10 % más lentos por punto"
msgstr "Les zombies sous acide sont 10 % plus lents par point"

#: scripts/talentos.gd
msgid "Alto voltaje"
msgstr "Haute tension"

#: scripts/talentos.gd
msgid "El rayo del lanza rayos y el de Pararrayos saltan a 1 zombi más por punto"
msgstr "L'éclair du lance-éclairs et celui du Paratonnerre sautent sur 1 zombie de plus par point"

#: scripts/talentos.gd
msgid "Mezcla explosiva"
msgstr "Mélange explosif"

#: scripts/talentos.gd
msgid "Los zombis que mueren con dos efectos a la vez (fuego, ácido, rayo o frío) explotan (a ti no te hace nada)"
msgstr "Les zombies qui meurent avec deux effets à la fois (feu, acide, foudre ou froid) explosent (sans effet sur toi)"

#: scripts/tornos.gd
msgid "¡Se han cerrado las puertas! Protege a la %s mientras abre los tornos"
msgstr "Les portes se sont refermées ! Protège la %s pendant qu'elle ouvre les tourniquets"

#: scripts/tornos.gd
msgid "¡Gracias! Sigo con los tornos"
msgstr "Merci ! Je reprends les tourniquets"

#: scripts/tornos.gd
msgid "¡Abiertos! Ya podemos subir"
msgstr "Ouverts ! On peut monter"

#: scripts/tornos.gd
msgid "¡La %s ha abierto los tornos!"
msgstr "La %s a ouvert les tourniquets !"

#: scripts/tornos.gd
msgid "Aguanta: la %s está abriendo los tornos"
msgstr "Tiens bon : la %s ouvre les tourniquets"

#: scripts/tornos.gd
msgid "La %s abre los tornos · %d:%02d"
msgstr "La %s ouvre les tourniquets · %d:%02d"

#: scripts/tornos.gd
msgid "¡La %s ha caído!"
msgstr "La %s est à terre !"

#: scripts/tornos.gd
msgid "Los tornos se han bloqueado. ¡Cúbreme mientras los abro!"
msgstr "Les tourniquets sont bloqués. Couvre-moi pendant que je les ouvre !"

#: scripts/tornos.gd
msgid "Tarjeta… rechazada. Otra vez"
msgstr "Carte… refusée. Encore"

#: scripts/tornos.gd
msgid "¡Mira, se atascan con los tornos!"
msgstr "Regarde, ils se coincent dans les tourniquets !"

#: scripts/tornos.gd
msgid "¡Toma, esto estaba en objetos perdidos!"
msgstr "Tiens, c'était aux objets trouvés !"

#: scripts/tornos.gd
msgid "«Acceso restringido: planta 40»… ¿qué hay ahí arriba?"
msgstr "« Accès restreint : étage 40 »… qu'est-ce qu'il y a là-haut ?"

#: scripts/tutoriales.gd
msgid "Apunta y ataca con {apuntar}."
msgstr "Vise et attaque avec {apuntar}."

#: scripts/tutoriales.gd
msgid "Apunta con {apuntar} y ataca con {atacar}."
msgstr "Vise avec {apuntar} et attaque avec {atacar}."

#: scripts/tutoriales.gd
msgid "Si prefieres que Johnny apunte solo, en Opciones → Ayudas está «Disparo asistido»."
msgstr "Si tu préfères que Johnny vise tout seul, Options → Aides propose « Tir assisté »."

#: scripts/tutoriales.gd
msgid "Johnny apunta y ataca solo al zombi más cercano: tú preocúpate de moverte."
msgstr "Johnny vise et attaque tout seul le zombie le plus proche : toi, occupe-toi de te déplacer."

#: scripts/tutoriales.gd
msgid "el joystick (toca y arrastra en la mitad izquierda)"
msgstr "le joystick (touche et glisse sur la moitié gauche)"

#: scripts/tutoriales.gd
msgid "el stick izquierdo"
msgstr "le stick gauche"

#: scripts/tutoriales.gd
msgid "el joystick de abajo a la derecha"
msgstr "le joystick en bas à droite"

#: scripts/tutoriales.gd
msgid "el stick derecho"
msgstr "le stick droit"

#: scripts/tutoriales.gd
msgid "el ratón"
msgstr "la souris"

#: scripts/tutoriales.gd
msgid "%s o %s"
msgstr "%s ou %s"

#: scripts/tutoriales.gd
msgid "Lo básico"
msgstr "Les bases"

#: scripts/tutoriales.gd scripts/ui/inventario.gd scripts/ui/menus.gd scripts/ui/opciones.gd
msgid "Armas"
msgstr "Armes"

#: scripts/tutoriales.gd
msgid "Plantas y jefes"
msgstr "Étages et boss"

#: scripts/tutoriales.gd
msgid "Eventos sorpresa"
msgstr "Événements surprise"

#: scripts/tutoriales.gd
msgid "Sala de mantenimiento"
msgstr "Salle de maintenance"

#: scripts/tutoriales.gd
msgid "Más edificios"
msgstr "Plus de bâtiments"

#: scripts/tutoriales.gd
msgid "Cómo se juega"
msgstr "Comment jouer"

#: scripts/tutoriales.gd
msgid "Al empezar"
msgstr "Au début"

#: scripts/tutoriales.gd
msgid "Muévete con {moverse}."
msgstr "Déplace-toi avec {moverse}."

#: scripts/tutoriales.gd
msgid "{atacar_modo}"
msgstr "{atacar_modo}"

#: scripts/tutoriales.gd
msgid "Esquiva con {esquivar}: un acelerón corto en el que no te hacen daño."
msgstr "Esquive avec {esquivar} : une courte accélération pendant laquelle rien ne te blesse."

#: scripts/tutoriales.gd
msgid "Cambia entre la fregona y la pistola con {cambiar_arma}, y pausa el juego con {pausa}."
msgstr "Passe de la serpillière au pistolet avec {cambiar_arma}, et mets le jeu en pause avec {pausa}."

#: scripts/tutoriales.gd
msgid "Limpia los apartamentos"
msgstr "Nettoie les appartements"

#: scripts/tutoriales.gd
msgid "Al salir al pasillo"
msgstr "En sortant dans le couloir"

#: scripts/tutoriales.gd
msgid "Al entrar en un apartamento, la puerta se cierra detrás de ti y no se abre hasta que no queda ni un zombi."
msgstr "Quand tu entres dans un appartement, la porte se referme derrière toi et ne s'ouvre plus tant qu'il reste un seul zombie."

#: scripts/tutoriales.gd
msgid "La sala del jefe de la planta está cerrada con llave: la lleva un zombi de otro apartamento y la suelta al caer."
msgstr "La salle du boss de l'étage est fermée à clé : un zombie d'un autre appartement a la clé et la lâche en tombant."

#: scripts/tutoriales.gd
msgid "Vence al jefe y se abren las escaleras a la planta siguiente."
msgstr "Bats le boss et l'escalier vers l'étage suivant s'ouvre."

#: scripts/tutoriales.gd
msgid "La vida en tercios"
msgstr "La vie en tiers"

#: scripts/tutoriales.gd
msgid "Al perder un tercio de vida"
msgstr "En perdant un tiers de vie"

#: scripts/tutoriales.gd
msgid "Tu barra de vida está partida en tres tercios por dos rayas. Cuando la vida baja de una raya, ese tercio se pierde: se oscurece y las vendas ya no lo llenan."
msgstr "Ta barre de vie est divisée en trois tiers par deux traits. Quand ta vie passe sous un trait, ce tiers est perdu : il s'assombrit et les bandages ne le remplissent plus."

#: scripts/tutoriales.gd
msgid "Por cada tercio perdido andas más lento: con dos perdidos ya no escapas de los zombis rápidos."
msgstr "Chaque tiers perdu te ralentit : avec deux tiers perdus, tu n'échappes plus aux zombies rapides."

#: scripts/tutoriales.gd
msgid "Los tercios perdidos siguen perdidos al subir de planta. Solo el botiquín devuelve uno (y el talento Segundo aliento, una vez por planta)."
msgstr "Les tiers perdus le restent quand tu montes d'étage. Seul le médikit en rend un (et le talent Second souffle, une fois par étage)."

#: scripts/tutoriales.gd
msgid "Si se te hace cuesta arriba, en Opciones → Ayudas está «Vida entera»."
msgstr "Si c'est trop dur, Options → Aides propose « Vie entière »."

#: scripts/tutoriales.gd
msgid "Al coger las primeras vendas"
msgstr "En ramassant tes premiers bandages"

#: scripts/tutoriales.gd
msgid "Las vendas se usan con {usar_vendas}: curan 25, sin pasar del tercio en el que estás."
msgstr "Les bandages s'utilisent avec {usar_vendas} : ils soignent 25, sans dépasser le tiers où tu es."

#: scripts/tutoriales.gd
msgid "Caben 3 en la mochila. Los armaritos de los baños se abren desde delante, como el ordenador, y sueltan lo suyo."
msgstr "Tu peux en porter 3 dans ton sac à dos. Les armoires à pharmacie des salles de bain s'ouvrent de face, comme l'ordinateur, et lâchent leur contenu."

#: scripts/tutoriales.gd
msgid "El botiquín"
msgstr "Le médikit"

#: scripts/tutoriales.gd
msgid "Al coger el primer botiquín"
msgstr "En ramassant ton premier médikit"

#: scripts/tutoriales.gd
msgid "Úsalo con {usar_botiquin}: cura 40 y te devuelve un tercio de vida perdido."
msgstr "Utilise-le avec {usar_botiquin} : il soigne 40 et te rend un tiers de vie perdu."

#: scripts/tutoriales.gd
msgid "Es lo único que recupera los tercios perdidos, aparte del talento Segundo aliento. Guárdalo para cuando pierdas uno."
msgstr "C'est la seule chose qui rend les tiers perdus, à part le talent Second souffle. Garde-le pour quand tu en perds un."

#: scripts/tutoriales.gd
msgid "Caben 2 en la mochila; los que sobran se quedan en el suelo o van al baúl."
msgstr "Tu peux en porter 2 dans ton sac à dos ; ceux en trop restent par terre ou vont au coffre."

#: scripts/tutoriales.gd
msgid "Inventario y mochila"
msgstr "Inventaire et sac à dos"

#: scripts/tutoriales.gd
msgid "Al coger el primer objeto"
msgstr "En ramassant le premier objet"

#: scripts/tutoriales.gd
msgid "Lo que recoges va a la mochila. El inventario se abre con {inventario}: tus armas, la munición, los lanzables y la mochila."
msgstr "Ce que tu ramasses va dans le sac à dos. L'inventaire s'ouvre avec {inventario} : tes armes, les munitions, les lançables et le sac à dos."

#: scripts/tutoriales.gd
msgid "Elige una casilla para ver su ficha y sus botones (usar, ponérmela, tirar...)."
msgstr "Choisis une case pour voir sa fiche et ses boutons (utiliser, équiper, jeter...)."

#: scripts/tutoriales.gd
msgid "Si caes, lo de la mochila se pierde; si completas el edificio, pasa al baúl. Las armas y los lanzables vuelven al baúl siempre, si les quedan partidas."
msgstr "Si tu tombes, le contenu du sac à dos est perdu ; si tu termines l'immeuble, il va au coffre. Les armes et les lançables retournent toujours au coffre s'il leur reste des parties."

#: scripts/tutoriales.gd
msgid "Dólares"
msgstr "Dollars"

#: scripts/tutoriales.gd
msgid "Al coger el primer billete"
msgstr "En ramassant le premier billet"

#: scripts/tutoriales.gd
msgid "Los zombis a veces sueltan billetes, y los jefes muchos: pasa por encima para cogerlos."
msgstr "Les zombies lâchent parfois des billets, et les boss beaucoup : passe dessus pour les ramasser."

#: scripts/tutoriales.gd
msgid "Se guardan al acabar la partida: todos si completas el edificio y la mitad si caes o abandonas."
msgstr "Ils sont gardés à la fin de la partie : tous si tu termines le bâtiment, la moitié si tu tombes ou abandonnes."

#: scripts/tutoriales.gd
msgid "Se gastan en el ordenador de la sala de mantenimiento."
msgstr "Ils se dépensent sur l'ordinateur de la salle de maintenance."

#: scripts/tutoriales.gd
msgid "Armas nuevas"
msgstr "Nouvelles armes"

#: scripts/tutoriales.gd
msgid "Al llevar otra arma"
msgstr "En prenant une autre arme"

#: scripts/tutoriales.gd
msgid "Llevas dos armas en la mano: una de cuerpo a cuerpo y otra a distancia. Cambias de una a otra con {cambiar_arma}."
msgstr "Tu as deux armes en main : une de corps à corps et une à distance. Tu passes de l'une à l'autre avec {cambiar_arma}."

#: scripts/tutoriales.gd
msgid "Las demás van de repuesto, una de cada tipo, y se cambian en el inventario ({inventario})."
msgstr "Les autres sont de rechange, une de chaque type, et se changent dans l'inventaire ({inventario})."

#: scripts/tutoriales.gd
msgid "El color del borde es su calidad: gris Normal, verde Poco común, azul Rara y morado Épica."
msgstr "La couleur du bord indique sa qualité : gris Normale, vert Peu commune, bleu Rare et violet Épique."

#: scripts/tutoriales.gd
msgid "Munición y recarga"
msgstr "Munitions et rechargement"

#: scripts/tutoriales.gd
msgid "Al recargar"
msgstr "En rechargeant"

#: scripts/tutoriales.gd
msgid "Recarga con {recargar}; al vaciarse el cargador, recarga solo."
msgstr "Recharge avec {recargar} ; quand le chargeur est vide, il se recharge tout seul."

#: scripts/tutoriales.gd
msgid "Cada arma gasta la suya (balas, cartuchos...). Una caja de munición del suelo te da un cargador."
msgstr "Chaque arme utilise les siennes (balles, cartouches...). Une caisse de munitions au sol te donne un chargeur."

#: scripts/tutoriales.gd
msgid "Sin munición, Johnny saca el arma de cuerpo a cuerpo."
msgstr "Sans munitions, Johnny sort l'arme de corps à corps."

#: scripts/tutoriales.gd
msgid "Lanzables"
msgstr "Lançables"

#: scripts/tutoriales.gd
msgid "En la primera pelea"
msgstr "Au premier combat"

#: scripts/tutoriales.gd
msgid "Lanza con {lanzar}: mantén para apuntar y suelta para lanzar."
msgstr "Lance avec {lanzar} : maintiens pour viser et relâche pour lancer."

#: scripts/tutoriales.gd
msgid "Lo que lanzas se cambia con {cambiar_lanzable}: el molotov prende fuego y la granada explota. Llevas 3 a mano y hasta 8 de repuesto."
msgstr "Ce que tu lances se change avec {cambiar_lanzable} : le molotov met le feu et la grenade explose. Tu en as 3 en main et jusqu'à 8 de rechange."

#: scripts/tutoriales.gd
msgid "¡Ojo! La explosión también te hace daño a ti."
msgstr "Attention ! L'explosion te blesse aussi."

#: scripts/tutoriales.gd
msgid "Piezas de mejora"
msgstr "Pièces d'amélioration"

#: scripts/tutoriales.gd
msgid "Al coger la primera pieza"
msgstr "En ramassant la première pièce"

#: scripts/tutoriales.gd
msgid "Con las piezas se sube la calidad de las armas y los lanzables, en el banco de trabajo de la sala de mantenimiento."
msgstr "Les pièces servent à monter la qualité des armes et des lançables, à l'établi de la salle de maintenance."

#: scripts/tutoriales.gd
msgid "Hay de cuatro familias: cuerpo a cuerpo, a distancia, especiales y arrojables. Las sueltan los zombis de vez en cuando y los jefes."
msgstr "Il y en a de quatre familles : corps à corps, à distance, spéciales et lançables. Les zombies en lâchent de temps en temps, et les boss aussi."

#: scripts/tutoriales.gd
msgid "Van en la mochila: si completas el edificio, pasan al baúl."
msgstr "Elles vont dans le sac à dos : si tu termines le bâtiment, elles passent au coffre."

#: scripts/tutoriales.gd
msgid "Al llegar al primer jefe"
msgstr "En arrivant au premier boss"

#: scripts/tutoriales.gd
msgid "Cada planta tiene su jefe, con su barra de vida arriba. A media vida se enfada y se vuelve más peligroso."
msgstr "Chaque étage a son boss, avec sa barre de vie en haut. À mi-vie, il s'énerve et devient plus dangereux."

#: scripts/tutoriales.gd
msgid "Antes de cada ataque marca el suelo: ¡sal de la marca o esquívala!"
msgstr "Avant chaque attaque, il marque le sol : sors de la marque ou esquive-la !"

#: scripts/tutoriales.gd
msgid "Al caer suelta dólares, munición y piezas, y se abren las escaleras."
msgstr "En tombant, il lâche des dollars, des munitions et des pièces, et l'escalier s'ouvre."

#: scripts/tutoriales.gd scripts/ui/menus.gd
msgid "Mutaciones"
msgstr "Mutations"

#: scripts/tutoriales.gd
msgid "Antes de la primera mutación"
msgstr "Avant la première mutation"

#: scripts/tutoriales.gd
msgid "Al vencer a un jefe, el virus te cambia: elige una de las dos cartas (también con 1 y 2)."
msgstr "Quand tu bats un boss, le virus te change : choisis l'une des deux cartes (aussi avec 1 et 2)."

#: scripts/tutoriales.gd
msgid "Cada mutación te da algo bueno y, a veces, algo malo."
msgstr "Chaque mutation a du bon et, parfois, du mauvais."

#: scripts/tutoriales.gd
msgid "Duran hasta que acaba la partida, y llevas como mucho 4."
msgstr "Elles durent jusqu'à la fin de la partie, et tu peux en avoir 4 au maximum."

#: scripts/tutoriales.gd
msgid "El ascensor"
msgstr "L'ascenseur"

#: scripts/tutoriales.gd
msgid "Al arreglar el ascensor"
msgstr "En réparant l'ascenseur"

#: scripts/tutoriales.gd
msgid "Johnny ha arreglado el ascensor del pasillo: baja a la sala de mantenimiento y vuelve a esta misma planta."
msgstr "Johnny a réparé l'ascenseur du couloir : il descend à la salle de maintenance et revient à ce même étage."

#: scripts/tutoriales.gd
msgid "Úsalo para ir al ordenador, al banco de trabajo o al baúl en mitad de la partida."
msgstr "Utilise-le pour aller à l'ordinateur, à l'établi ou au coffre en pleine partie."

#: scripts/tutoriales.gd
msgid "Al rescatar al primero"
msgstr "En sauvant le premier"

#: scripts/tutoriales.gd
msgid "Se une al equipo: te acompaña y te ayuda a su manera."
msgstr "Il rejoint l'équipe : il t'accompagne et t'aide à sa façon."

#: scripts/tutoriales.gd
msgid "Cada uno tiene su rescate. No te alejes de él y, si cae, quédate a su lado para levantarlo."
msgstr "Chacun a son sauvetage. Ne t'éloigne pas de lui et, s'il tombe, reste à côté pour le relever."

#: scripts/tutoriales.gd
msgid "Si completas el edificio con él, se muda a las viviendas (la puerta de la derecha de la sala de mantenimiento) y podrá acompañarte."
msgstr "Si tu termines le bâtiment avec lui, il s'installe dans les logements (la porte de droite de la salle de maintenance) et pourra t'accompagner."

#: scripts/tutoriales.gd
msgid "En el primer apagón"
msgstr "Au premier black-out"

#: scripts/tutoriales.gd
msgid "Se ha ido la luz en toda la planta: solo ves lo que alumbra tu linterna, hacia donde miras."
msgstr "Plus de courant à tout l'étage : tu ne vois que ce qu'éclaire ta lampe torche, là où tu regardes."

#: scripts/tutoriales.gd
msgid "En la sala del jefe todo sigue como siempre."
msgstr "Dans la salle du boss, rien ne change."

#: scripts/tutoriales.gd
msgid "Al subir a la planta siguiente, te llevas un premio en dólares."
msgstr "En montant à l'étage suivant, tu gagnes une prime en dollars."

#: scripts/tutoriales.gd
msgid "En la primera alarma de incendios"
msgstr "À la première alarme incendie"

#: scripts/tutoriales.gd
msgid "Los aspersores llenan el suelo de charcos que resbalan."
msgstr "Les sprinklers couvrent le sol de flaques glissantes."

#: scripts/tutoriales.gd
msgid "En algunos cae un cable pelado que da calambrazos a Johnny y a los zombis: ¡llévalos hasta él! Esquivando cruzas sin daño."
msgstr "Dans certaines tombe un câble dénudé qui électrocute Johnny et les zombies : attire-les dessus ! En esquivant, tu traverses sans dégâts."

#: scripts/tutoriales.gd
msgid "En la primera horda"
msgstr "À la première horde"

#: scripts/tutoriales.gd
msgid "Una horda enorme llena el pasillo y va a por ti."
msgstr "Une horde énorme remplit le couloir et fonce sur toi."

#: scripts/tutoriales.gd
msgid "Si te metes en un piso, los que queden te esperan fuera. Aquí los lanzables vienen de perlas."
msgstr "Si tu te réfugies dans un appartement, ceux qui restent t'attendent dehors. Ici, les lançables tombent à pic."

#: scripts/tutoriales.gd
msgid "Al acabar con todos, te deja dólares y una caja de munición."
msgstr "Quand tu les as tous éliminés, elle te laisse des dollars et une caisse de munitions."

#: scripts/tutoriales.gd
msgid "El ordenador"
msgstr "L'ordinateur"

#: scripts/tutoriales.gd
msgid "Al encender el ordenador"
msgstr "En allumant l'ordinateur"

#: scripts/tutoriales.gd
msgid "Gasta los dólares ahorrados: puntos de talento (mejoras para siempre) y armas y lanzables para la partida."
msgstr "Dépense les dollars économisés : points de talent (améliorations définitives) et armes et lançables pour la partie."

#: scripts/tutoriales.gd
msgid "También están los logros, que dan premio, el Dosier, las Noticias y las Colecciones."
msgstr "Il y a aussi les succès, qui rapportent des récompenses, le Dossier, les Infos et les Collections."

#: scripts/tutoriales.gd
msgid "La taquilla"
msgstr "Le casier"

#: scripts/tutoriales.gd
msgid "Al abrir la taquilla"
msgstr "En ouvrant le casier"

#: scripts/tutoriales.gd
msgid "Aquí eliges la ropa de Johnny. Cada una tiene su ventaja."
msgstr "Ici, tu choisis la tenue de Johnny. Chacune a son avantage."

#: scripts/tutoriales.gd
msgid "Se consiguen venciendo a ciertos jefes: las que te faltan salen con «???» y cómo conseguirlas."
msgstr "Tu les obtiens en battant certains boss : celles qui te manquent s'affichent avec « ??? » et comment les obtenir."

#: scripts/tutoriales.gd
msgid "El banco de trabajo"
msgstr "L'établi"

#: scripts/tutoriales.gd
msgid "Al usar el banco de trabajo"
msgstr "En utilisant l'établi"

#: scripts/tutoriales.gd
msgid "Sube la calidad de tus armas y lanzables, nivel a nivel, con las piezas de su familia (las de la mochila y las del baúl)."
msgstr "Monte la qualité de tes armes et lançables, niveau par niveau, avec les pièces de leur famille (celles du sac à dos et celles du coffre)."

#: scripts/tutoriales.gd
msgid "Normal, Poco común, Rara y Épica: la Épica trae además un truco. Cada mejora le da también una partida más de vida."
msgstr "Normale, Peu commune, Rare et Épique : l'Épique a en plus une astuce. Chaque amélioration donne aussi une partie de vie en plus."

#: scripts/tutoriales.gd
msgid "Elige la casilla y pulsa «Mejorar»."
msgstr "Choisis la case et appuie sur « Améliorer »."

#: scripts/tutoriales.gd
msgid "El baúl"
msgstr "Le coffre"

#: scripts/tutoriales.gd
msgid "Al abrir el baúl"
msgstr "En ouvrant le coffre"

#: scripts/tutoriales.gd
msgid "Las armas y los lanzables duran la partida en la que estás y tantas más como su calidad: Normal, ninguna; Poco común, una; Rara, dos; Épica, tres."
msgstr "Les armes et les lançables durent la partie en cours plus autant que leur qualité : Normale, aucune ; Peu commune, une ; Rare, deux ; Épique, trois."

#: scripts/tutoriales.gd
msgid "Sacarlos del baúl gasta una partida; si ya no les quedaba ninguna, se destruyen al acabar, aunque los vuelvas a guardar."
msgstr "Les sortir du coffre coûte une partie ; s'il ne leur en restait aucune, ils se détruisent à la fin, même si tu les ranges à nouveau."

#: scripts/tutoriales.gd
msgid "Al acabar la partida, completes el edificio o caigas, lo que llevas con partidas por delante vuelve solo al baúl. Elige una casilla o arrástrala para pasarla."
msgstr "À la fin de la partie, que tu termines l'immeuble ou que tu tombes, ce que tu portes et qui a encore des parties retourne tout seul au coffre. Choisis une case ou fais-la glisser pour la déplacer."

#: scripts/tutoriales.gd
msgid "La tienda de armas"
msgstr "La boutique d'armes"

#: scripts/tutoriales.gd
msgid "Al abrir la tienda de armas"
msgstr "En ouvrant la boutique d'armes"

#: scripts/tutoriales.gd
msgid "Se venden en calidad Normal: duran solo esta partida y, al acabarla, se destruyen. Llevas dos de cada tipo: la que tenías en la mano pasa al repuesto y la de repuesto, al baúl; si no cabe o no se puede guardar, la de la mano se queda en el suelo."
msgstr "Elles sont vendues en qualité Normale : elles ne durent que cette partie et se détruisent à la fin. Tu en portes deux de chaque type : celle que tu avais en main passe en réserve et celle de réserve, au coffre ; si elle ne rentre pas ou ne peut pas être rangée, celle de ta main reste par terre."

#: scripts/tutoriales.gd
msgid "Las de A distancia vienen llenas y con munición de reserva; las especiales, llenas, y van en el hueco de las de A distancia. Los arrojables se compran de uno en uno, mientras te quepan."
msgstr "Les armes à distance sont livrées chargées, avec des munitions de réserve ; les spéciales, pleines, et elles vont à l'emplacement à distance. Les lançables s'achètent un par un, tant qu'il reste de la place."

#: scripts/tutoriales.gd
msgid "Johnny solo empieza con la fregona: la primera pistola te la regalamos."
msgstr "Johnny ne commence qu'avec la serpillière : le premier pistolet, c'est cadeau."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Talentos"
msgstr "Talents"

#: scripts/tutoriales.gd
msgid "Al abrir Talentos"
msgstr "En ouvrant Talents"

#: scripts/tutoriales.gd
msgid "Gasta aquí los dólares ahorrados en talentos: mejoras para Johnny que duran para siempre, en todas las partidas."
msgstr "Dépense ici tes dollars économisés en talents : des améliorations pour Johnny qui durent pour toujours, à chaque partie."

#: scripts/tutoriales.gd
msgid "Hay tres ramas: Militar, Superviviente y Químico. Cada talento sube punto a punto, y para abrir los de abajo hay que llenar antes el de encima."
msgstr "Il y a trois branches : Soldat, Survivant et Chimiste. Chaque talent monte point par point, et pour débloquer ceux du dessous, il faut d'abord remplir celui du dessus."

#: scripts/tutoriales.gd
msgid "«Resetear talentos» los quita todos para repartirlos de nuevo, pero el dinero gastado se pierde."
msgstr "« Réinitialiser les talents » les retire tous pour les répartir à nouveau, mais l'argent dépensé est perdu."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Logros"
msgstr "Succès"

#: scripts/tutoriales.gd
msgid "Al abrir Logros"
msgstr "En ouvrant Succès"

#: scripts/tutoriales.gd
msgid "Aquí están los retos del juego, ordenados por temas."
msgstr "Voici les défis du jeu, classés par thème."

#: scripts/tutoriales.gd
msgid "Al conseguir uno, vuelve aquí a cobrarlo: cada logro da un premio en dólares."
msgstr "Quand tu en obtiens un, reviens ici pour l'encaisser : chaque succès rapporte une prime en dollars."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Dosier VD-7"
msgstr "Dossier VD-7"

#: scripts/tutoriales.gd
msgid "Al abrir el Dosier"
msgstr "En ouvrant le Dossier"

#: scripts/tutoriales.gd
msgid "En cada planta hay un muerto de Velaria con una página del dosier. Cógela y se queda aquí para siempre."
msgstr "À chaque étage, un mort de Velaria porte une page du dossier. Ramasse-la et elle reste ici pour toujours."

#: scripts/tutoriales.gd
msgid "Cada edificio tiene su dosier. Completarlo es una de las tres cosas que pide el edificio siguiente para abrirse."
msgstr "Chaque bâtiment a son dossier. Le compléter est l'une des trois conditions pour débloquer le bâtiment suivant."

#: scripts/tutoriales.gd
msgid "Al abrir Colecciones"
msgstr "En ouvrant Collections"

#: scripts/tutoriales.gd
msgid "Aquí se apuntan los zombis y los jefes que te encuentras, con lo que hacen y dónde salen."
msgstr "Ici sont notés les zombies et les boss que tu croises, avec ce qu'ils font et où ils apparaissent."

#: scripts/tutoriales.gd
msgid "Los que aún no has visto salen con «???»."
msgstr "Ceux que tu n'as pas encore vus s'affichent avec « ??? »."

#: scripts/tutoriales.gd scripts/ui/ordenador.gd
msgid "Vídeos"
msgstr "Vidéos"

#: scripts/tutoriales.gd
msgid "Al abrir Vídeos"
msgstr "En ouvrant Vidéos"

#: scripts/tutoriales.gd
msgid "En las plantas hay teles con las noticias de Canal 8. Las que veas se guardan aquí para volver a verlas."
msgstr "Dans les étages, des télés diffusent les infos de Canal 8. Celles que tu regardes sont gardées ici pour les revoir."

#: scripts/tutoriales.gd
msgid "Ver todos los vídeos de un edificio también cuenta para abrir el siguiente."
msgstr "Regarder toutes les vidéos d'un bâtiment compte aussi pour débloquer le suivant."

#: scripts/tutoriales.gd
msgid "Los trasteros"
msgstr "Les caves"

#: scripts/tutoriales.gd
msgid "Al entrar en los trasteros"
msgstr "En entrant dans les caves"

#: scripts/tutoriales.gd
msgid "Aquí viven los supervivientes que rescates, cada uno en su trastero."
msgstr "Ici vivent les survivants que tu sauves, chacun dans sa cave."

#: scripts/tutoriales.gd
msgid "En cada partida hay uno encerrado en alguna planta: se le oye pedir socorro y sale un «!» en el minimapa. Limpia ese piso, ve a por él y protégelo hasta sacarlo."
msgstr "À chaque partie, l'un d'eux est enfermé à un étage : on l'entend appeler au secours et un «!» apparaît sur la mini-carte. Nettoie cet appartement, va le chercher et protège-le jusqu'à la sortie."

#: scripts/tutoriales.gd
msgid "Si completas el edificio con él en el equipo, se muda aquí. Arrímate a uno de los que viven aquí y te acompañará en las partidas siguientes (solo uno a la vez)."
msgstr "Si tu termines le bâtiment avec lui dans l'équipe, il s'installe ici. Approche-toi de l'un de ceux qui vivent ici et il t'accompagnera lors des parties suivantes (un seul à la fois)."

#: scripts/tutoriales.gd
msgid "El centro comercial"
msgstr "Le centre commercial"

#: scripts/tutoriales.gd
msgid "Al llegar al centro comercial"
msgstr "En arrivant au centre commercial"

#: scripts/tutoriales.gd
msgid "La sala del jefe se abre con una tarjeta de acceso: la lleva el guardia de seguridad que hace la ronda."
msgstr "La salle du boss s'ouvre avec un badge d'accès : c'est le garde de sécurité qui fait sa ronde qui l'a."

#: scripts/tutoriales.gd
msgid "Si te ve, toca el silbato, llegan refuerzos y él huye: ¡que no se escape!"
msgstr "S'il te voit, il siffle, des renforts arrivent et il s'enfuit : ne le laisse pas filer !"

#: scripts/tutoriales.gd
msgid "Peligros de las tiendas"
msgstr "Dangers des boutiques"

#: scripts/tutoriales.gd
msgid "En la primera tienda con peligro"
msgstr "Dans la première boutique avec un danger"

#: scripts/tutoriales.gd
msgid "La cámara frigorífica congela, la cocina quema y el agua de la tienda de electrónica da calambres (su cuadro eléctrico corta la corriente)."
msgstr "La chambre froide gèle, la cuisine brûle et l'eau du magasin d'électronique électrocute (son tableau électrique coupe le courant)."

#: scripts/tutoriales.gd
msgid "También hacen daño a los zombis despiertos: ¡llévalos hasta ellos!"
msgstr "Ils blessent aussi les zombies réveillés : attire-les dessus !"

#: scripts/tutoriales.gd
msgid "Esquivando los cruzas sin daño."
msgstr "En esquivant, tu les traverses sans dégâts."

#: scripts/tutoriales.gd
msgid "Al oír su primer grito"
msgstr "Au premier cri entendu"

#: scripts/tutoriales.gd
msgid "La dependienta no viene a por ti: se aparta y grita «¡¡¡AAAHHH!!!». Su grito despierta a toda la tienda."
msgstr "La vendeuse ne vient pas vers toi : elle recule et crie « AAAHHH !!! ». Son cri réveille toute la boutique."

#: scripts/tutoriales.gd
msgid "Los zombis que la oyen se cubren con una burbuja dorada: las balas rebotan y ni los golpes, ni el fuego, ni los charcos les hacen daño."
msgstr "Les zombies qui l'entendent s'entourent d'une bulle dorée : les balles rebondissent, et ni les coups, ni le feu, ni les flaques ne leur font de mal."

#: scripts/tutoriales.gd
msgid "La burbuja no se va hasta que cae ella: ve primero a por la dependienta (si hay varias, a por todas). Es flojita, pero se escapa: acorrálala o lánzale algo."
msgstr "La bulle ne disparaît que quand elle tombe : occupe-toi d'abord de la vendeuse (s'il y en a plusieurs, de toutes). Elle est fragile, mais elle s'enfuit : coince-la ou lance-lui quelque chose."

#: scripts/tutoriales.gd
msgid "Al llegar a Torre Velaria"
msgstr "En arrivant à la Tour Velaria"

#: scripts/tutoriales.gd
msgid "La sala del jefe se abre con un código de tres cifras. Cada cifra está en un ordenador encendido de algún departamento: su pantalla brilla en verde."
msgstr "La salle du boss s'ouvre avec un code à trois chiffres. Chaque chiffre est sur un ordinateur allumé d'un service : son écran brille en vert."

#: scripts/tutoriales.gd
msgid "Plántate delante para leerla, pero salta el «control de productividad» y se despiertan todos los zombis."
msgstr "Plante-toi devant pour le lire, mais le « contrôle de productivité » se déclenche et tous les zombies se réveillent."

#: scripts/tutoriales.gd
msgid "Peligros de la torre"
msgstr "Dangers de la tour"

#: scripts/tutoriales.gd
msgid "En el primer departamento con peligro"
msgstr "Dans le premier service avec un danger"

#: scripts/tutoriales.gd
msgid "El ventanal roto de Marketing te arrastra hacia fuera: crúzalo pegado a las mesas. Los zombis que llegan al borde salen volando."
msgstr "La baie vitrée cassée du Marketing t'aspire dehors : traverse en longeant les bureaux. Les zombies qui arrivent au bord s'envolent."

#: scripts/tutoriales.gd
msgid "Si una cámara de Seguridad te ve, salta la alarma y llegan escoltas: rómpela de un tiro antes."
msgstr "Si une caméra de la Sécurité te voit, l'alarme sonne et des gardes du corps arrivent : casse-la d'un tir avant."

#: scripts/tutoriales.gd
msgid "El gas de Recursos Humanos duerme a los zombis, pero despiertan frenéticos. La válvula del archivo lo corta."
msgstr "Le gaz des Ressources humaines endort les zombies, mais ils se réveillent frénétiques. La vanne des archives le coupe."

#: scripts/tutoriales.gd
msgid "Alerta y Reto del día"
msgstr "Alerte et Défi du jour"

#: scripts/tutoriales.gd
msgid "Al completar el primer edificio"
msgstr "En terminant le premier bâtiment"

#: scripts/tutoriales.gd
msgid "Debajo de cada edificio completado eliges la alerta con < y >: más difícil, más dólares. Completarlo con la más alta abre la siguiente."
msgstr "Sous chaque bâtiment terminé, choisis l'alerte avec < et > : plus difficile, plus de dollars. La terminer au niveau le plus haut débloque la suivante."

#: scripts/tutoriales.gd
msgid "El Reto del día es el mismo edificio para todo el mundo ese día, con una regla rara. Completarlo la primera vez cada día da $10."
msgstr "Le Défi du jour, c'est le même bâtiment pour tout le monde ce jour-là, avec une règle bizarre. Le réussir la première fois chaque jour rapporte $10."

#: scripts/tutoriales.gd
msgid "el botón de esquivar"
msgstr "le bouton d'esquive"

#: scripts/tutoriales.gd
msgid "el botón de la otra arma"
msgstr "le bouton de l'autre arme"

#: scripts/tutoriales.gd
msgid "el botón del arma a distancia, con ella en la mano"
msgstr "le bouton de l'arme à distance, quand tu l'as en main"

#: scripts/tutoriales.gd
msgid "el botón de lanzar"
msgstr "le bouton de lancer"

#: scripts/tutoriales.gd
msgid "el botoncito de al lado de lanzar"
msgstr "le petit bouton à côté de lancer"

#: scripts/tutoriales.gd
msgid "el botón de las vendas, bajo el minimapa"
msgstr "le bouton des bandages, sous la mini-carte"

#: scripts/tutoriales.gd
msgid "el botón del botiquín, bajo el minimapa"
msgstr "le bouton du médikit, sous la mini-carte"

#: scripts/tutoriales.gd
msgid "el botón de la mochila, bajo el minimapa"
msgstr "le bouton du sac à dos, sous la mini-carte"

#: scripts/tutoriales.gd
msgid "el botón de pausa, bajo el minimapa"
msgstr "le bouton de pause, sous la mini-carte"

