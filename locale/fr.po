#: scripts/ui/inventario.gd
msgid "Salen hasta %d de una vez a tu munición; fuera del baúl, se pierden si caes."
msgstr "Jusqu'à %d sortent d'un coup vers tes munitions ; hors du coffre, ils sont perdus si tu tombes."

#: scripts/ui/inventario.gd
msgid "Sale de uno en uno a tu munición; fuera del baúl, se pierde si caes."
msgstr "Sort un par un vers tes munitions ; hors du coffre, il est perdu si tu tombes."

