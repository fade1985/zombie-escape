msgstr "Il t'en reste %d sur %d"

#: scripts/ui/inventario.gd
msgid "Es lo que lanzas ahora."
msgstr "C'est ce que tu lances en ce moment."

#: scripts/ui/inventario.gd
msgid "Con F lo eliges para lanzarlo."
msgstr "Avec F, tu le choisis pour le lancer."

#: scripts/ui/inventario.gd
msgid "Cuando se acabe, entra otro montón de los de repuesto."
msgstr "Quand il est épuisé, une autre pile de rechange prend le relais."

#: scripts/ui/inventario.gd
msgid "Al repuesto"
msgstr "En rechange"

#: scripts/ui/inventario.gd
msgid "Ya llevas a mano un montón lleno de estos: entrará cuando se acabe."
msgstr "Tu as déjà en main une pile pleine de ceux-ci : elle prendra le relais quand l'autre sera épuisée."

#: scripts/ui/inventario.gd
msgid "«A la mano» llena con estos el montón que llevas a mano."
msgstr "« En main » remplit avec ceux-ci la pile que tu as en main."

#: scripts/ui/inventario.gd
msgid "«A la mano» lo cambia por %s, que pasa aquí."
msgstr "« En main » l'échange contre la pile de %s, qui passe ici."

#: scripts/ui/inventario.gd
msgid "A la mano"
msgstr "En main"

#: scripts/ui/inventario.gd
msgid "Te has curado %d de vida."
msgstr "Tu t'es soigné de %d."

