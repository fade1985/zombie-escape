msgstr "le Poste de sécurité"

#: scripts/edificios.gd
msgid "el cocinero"
msgstr "le cuisinier"

#: scripts/edificios.gd
msgid "Cocina central"
msgstr "Cuisine centrale"

#: scripts/edificios.gd
