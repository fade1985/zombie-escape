msgstr "Coffre  %d / %d"

#: scripts/ui/inventario.gd
msgid "Objetos, armas y arrojables"
msgstr "Objets, armes et lançables"

#: scripts/ui/inventario.gd
msgid "Aquí no se pierde nada aunque caigas."
msgstr "Ici, rien ne se perd, même si tu tombes."

#: scripts/ui/inventario.gd
msgid "Guardar todo"
msgstr "Tout ranger"

#: scripts/ui/inventario.gd scripts/ui/taquilla.gd
msgid "Cerrar"
msgstr "Fermer"

#: scripts/ui/inventario.gd
msgid "Guardar en el baúl"
msgstr "Ranger au coffre"

#: scripts/ui/inventario.gd
msgid "La %s Normal no va al baúl: la tienes siempre."
msgstr "Version Normale (%s) : pas besoin du coffre, tu l'as toujours."

#: scripts/ui/inventario.gd
