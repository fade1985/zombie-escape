msgid "Limpiadora de noche"
msgstr "Femme de ménage de nuit"

#: scripts/supervivientes.gd
msgid "¡Cerrad el gas!"
msgstr "Coupez le gaz !"

#: scripts/supervivientes.gd
msgid "¡Las válvulas!"
msgstr "Les vannes !"

#: scripts/supervivientes.gd
msgid "¡Aquí dentro! *cof, cof*"
msgstr "Ici ! *kof, kof*"

#: scripts/supervivientes.gd
msgid "¡No puedo respirar!"
msgstr "Je ne peux plus respirer !"

#: scripts/supervivientes.gd
msgid "¡Aire! Gracias, chico. Yo también limpio este edificio de noche"
msgstr "De l'air ! Merci, petit. Moi aussi, je nettoie cet immeuble la nuit"

#: scripts/supervivientes.gd
msgid "Friega por donde pasa: quita los charcos de veneno, de ácido y los que resbalan"
msgstr "Lave le sol sur son passage : fait disparaître les flaques de poison, d'acide et celles qui glissent"

#: scripts/supervivientes.gd
msgid "Te arregla la fregona: el fregonazo barre más ancho"
msgstr "Répare ta serpillière : ses coups balaient plus large"

#: scripts/supervivientes.gd
msgid "Recepcionista"
msgstr "Réceptionniste"

#: scripts/supervivientes.gd
msgid "¡Estoy en recepción!"
msgstr "Je suis à l'accueil !"

#: scripts/supervivientes.gd
msgid "¡Detrás del mostrador!"
msgstr "Derrière le comptoir !"

#: scripts/supervivientes.gd
msgid "¡No puedo subir la persiana!"
msgstr "Je n'arrive pas à lever le rideau de fer !"

#: scripts/supervivientes.gd
msgid "¡Por fin alguien vivo! Abro los tornos y nos vamos"
msgstr "Enfin quelqu'un de vivant ! J'ouvre les tourniquets et on s'en va"

#: scripts/supervivientes.gd
msgid "Te avisa con un «¡Detrás!» cuando un zombi va a pegarte por la espalda"
msgstr "Crie « Derrière toi ! » quand un zombie va te frapper dans le dos"

