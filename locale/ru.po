# Traducción al ruso de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Тревога %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Без тревоги"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Как обычно"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"+%d %% к долларам и деталям"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (плюс предыдущие)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % зомби"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Зомби быстрее на 10 %"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "У боссов +25 % здоровья, и они раньше звереют"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Аптечки, бинты и Аксолотль лечат вдвое слабее"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "Охранник (или зомби с ключом) вдвое живучее, а зомби слышат тебя издалека"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Постой рядом, чтобы помочь подняться"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Помогите!"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "Возьми меня с собой!"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Можно с тобой?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "ФЬЮЮЮЮТЬ!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "НАЗАД!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "ЛИЦОМ В ПОЛ!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "ДЗЫНЬ!"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "удар на %d %% длиннее и шире"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "магазин больше на %d %%, перезарядка быстрее на %d %%"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "бак больше на %d %%, а разряд перескакивает еще на %d зомби"
msgstr[1] "бак больше на %d %%, а разряд перескакивает еще на %d зомби"
msgstr[2] "бак больше на %d %%, а разряд перескакивает еще на %d зомби"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "бак больше на %d %%"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "радиус больше на %d %%, а в стопку влезает на %d больше"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: урон +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Фишка: каждый %d-й удар — критический (двойной урон)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Фишка: пули прошивают одного зомби и летят дальше."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Фишка: пули прошивают %d зомби и летят дальше."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Фишка: убитые им зомби лопаются и передают свой эффект соседям."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Фишка: разбившись, раскидывает вокруг мелкие копии: %d шт."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Фишка: взорвавшись, раскидывает вокруг мелкие копии: %d шт."

