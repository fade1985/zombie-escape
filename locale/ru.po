#: scripts/ui/inventario.gd
msgid "La gastan %s (caben %d en cada hueco). Al tirarlo, el hueco entero se queda en el suelo en una caja."
msgstr "Для оружия: %s (по %d в ячейке). Если выбросить, вся ячейка останется на полу в ящике."

#: scripts/ui/inventario.gd
msgid "Llena %s (caben %d en cada hueco). Se tira de uno en uno."
msgstr "Заправляет: %s (по %d в ячейке). Выбрасывается по одному."

#: scripts/ui/inventario.gd
msgid "Arrojable · %s"
msgstr "Метательное · %s"

#: scripts/ui/inventario.gd
msgid "A mano"
msgstr "В руке"

#: scripts/ui/inventario.gd
msgid "Te quedan %d de %d · %d en total"
msgstr "Осталось %d из %d · всего %d"

#: scripts/ui/inventario.gd
msgid "Te quedan %d de %d"
msgstr "Осталось %d из %d"

#: scripts/ui/inventario.gd
msgid "Es lo que lanzas ahora."
msgstr "Это ты сейчас бросаешь."

#: scripts/ui/inventario.gd
msgid "Con F lo eliges para lanzarlo."
msgstr "Клавишей F выбираешь его для броска."

#: scripts/ui/inventario.gd
msgid "Cuando se acabe, entra otro montón de los de repuesto."
msgstr "Когда закончится, в дело пойдет стопка из запаса."

#: scripts/ui/inventario.gd
msgid "Al repuesto"
msgstr "В запас"

#: scripts/ui/inventario.gd
msgid "Ya llevas a mano un montón lleno de estos: entrará cuando se acabe."
msgstr "В руке уже полная стопка таких: эта пойдет в дело, когда та закончится."

#: scripts/ui/inventario.gd
msgid "«A la mano» llena con estos el montón que llevas a mano."
msgstr "«В руку» пополняет этими стопку в руке."

#: scripts/ui/inventario.gd
msgid "«A la mano» lo cambia por %s, que pasa aquí."
msgstr "«В руку» поменяет его местами с тем, что сейчас в руке: %s."

#: scripts/ui/inventario.gd
msgid "A la mano"
msgstr "В руку"

#: scripts/ui/inventario.gd
msgid "Te has curado %d de vida."
msgstr "Восстановлено здоровья: %d."

#: scripts/ui/inventario.gd
