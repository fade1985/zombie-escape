msgstr "Закрыть"

#: scripts/ui/inventario.gd
msgid "Guardar en el baúl"
msgstr "В сундук"

#: scripts/ui/inventario.gd
msgid "La %s Normal no va al baúl: la tienes siempre."
msgstr "Обычное оружие (%s) не кладется в сундук: оно всегда при тебе."

#: scripts/ui/inventario.gd
msgid "Depósito %d de %d s"
msgstr "Бак %d из %d с"

#: scripts/ui/inventario.gd
msgid "%s · reserva %d"
msgstr "%s · запас %d"

#: scripts/ui/inventario.gd
msgid "Arrojable · %s · %s"
msgstr "Метательное · %s · %s"

#: scripts/ui/inventario.gd
msgid "El baúl está lleno: haz sitio sacando algo."
msgstr "Сундук полон: освободи место, достав что-нибудь."

#: scripts/ui/inventario.gd
msgid "Solo caben %d más en el baúl (%d por casilla): el resto se queda contigo."
msgstr "В сундук влезет еще только %d (по %d в ячейке): остальное останется у тебя."

#: scripts/ui/inventario.gd
msgid "Se guarda el montón entero, con los que ya haya de estos, y en el baúl queda a salvo aunque caigas."
msgstr "Убирается вся стопка вместе с такими же, что уже там, и в сундуке она в сохранности, даже если падешь."

