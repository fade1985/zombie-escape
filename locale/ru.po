#: scripts/ui/menus.gd
msgid "El veneno"
msgstr "Яд"

#: scripts/ui/menus.gd
msgid "Esquiva para cruzar los charcos: así no te hacen nada."
msgstr "Пересекай лужи рывком уклонения: так они тебе ничего не сделают."

