#: scripts/ui/inventario.gd
msgid "No llevas arma a distancia que mejorar."
msgstr "Нет оружия дальнего боя, которое можно улучшить."

#: scripts/ui/inventario.gd
msgid "Ya es Épica: no se puede mejorar más."
msgstr "Уже Эпическое: улучшать больше некуда."

#: scripts/ui/inventario.gd
