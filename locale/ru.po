#: scripts/armas.gd
msgid "Durabilidad: %d"
msgstr "Прочность: %d"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "удар на %d %% длиннее и шире"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "магазин больше на %d %%, перезарядка быстрее на %d %%"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d durmiente más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d durmientes más"
msgstr[0] "бак больше на %d %%, а разряд перескакивает еще на %d спящего"
msgstr[1] "бак больше на %d %%, а разряд перескакивает еще на %d спящих"
msgstr[2] "бак больше на %d %%, а разряд перескакивает еще на %d спящих"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "бак больше на %d %%"

#: scripts/armas.gd
msgid "radio un %d %% más grande"
msgstr "радиус больше на %d %%"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: урон +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Фишка: каждый %d-й удар — критический (двойной урон)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un durmiente y siguen."
msgstr "Фишка: пули прошивают одного спящего и летят дальше."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d durmientes y siguen."
msgstr "Фишка: пули прошивают %d спящих и летят дальше."

#: scripts/armas.gd
msgid "Truco: los durmientes que mata revientan y pasan su efecto a los de al lado."
msgstr "Фишка: убитые им спящие лопаются и передают свой эффект соседям."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Фишка: разбившись, раскидывает вокруг мелкие копии: %d шт."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Фишка: взорвавшись, раскидывает вокруг мелкие копии: %d шт."

