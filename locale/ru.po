#: scripts/ui/archivador_logros.gd
msgid "Partida con ayudas: no da logros"
msgstr "Игра с помощью: без достижений"

#: scripts/ui/archivador_logros.gd
msgid "Casi lo tienes"
msgstr "Почти готово"

#: scripts/ui/archivador_logros.gd
