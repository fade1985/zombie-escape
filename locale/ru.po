msgstr "Предметы, оружие и метательное"

#: scripts/ui/inventario.gd
msgid "Aquí no se pierde nada aunque caigas."
msgstr "Здесь ничего не пропадет, даже если падешь."

#: scripts/ui/inventario.gd
msgid "Guardar todo"
msgstr "Убрать все"

#: scripts/ui/inventario.gd scripts/ui/taquilla.gd
