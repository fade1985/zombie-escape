msgstr "Магазин игрушек"

#: scripts/edificios.gd
msgid "la Juguetería"
msgstr "магазин игрушек"

#: scripts/edificios.gd
msgid "la directora de Recursos Humanos"
msgstr "директор по персоналу"

#: scripts/edificios.gd
