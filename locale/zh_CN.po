msgstr "打你的僵尸会挨一道闪电，被击晕，闪电还会跳到另一个僵尸身上（最多每3秒一次）"

#: scripts/talentos.gd
msgid "Napalm"
msgstr "凝固汽油"

#: scripts/talentos.gd
msgid "El fuego del molotov dura 1 s más por punto"
msgstr "每点使燃烧瓶的火焰多持续1秒"

#: scripts/talentos.gd
msgid "Pegajoso"
msgstr "粘糊糊"

#: scripts/talentos.gd
msgid "Los zombis con ácido van un 10 % más lentos por punto"
msgstr "每点使沾了酸液的僵尸移速 -10%"

#: scripts/talentos.gd
msgid "Alto voltaje"
msgstr "高压电"

