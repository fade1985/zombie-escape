# Traducción al chino simplificado de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"


#: scripts/alerta.gd
msgid "Mejora %d"
msgstr "强化 %d"

#: scripts/alerta.gd
msgid "Sin mejora"
msgstr "无强化"

#: scripts/alerta.gd
msgid "Mejora %d del compuesto VD-7"
msgstr "VD-7化合物强化 %d"

#: scripts/alerta.gd
msgid "Enemigos +%d %%: cantidad, vida, daño, velocidad y ataque"
msgstr "敌人 +%d %%：数量、生命、伤害、速度和攻击"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "一切照旧"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "身后！"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "待在旁边把人扶起来"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "嘘——！"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "退后！"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "你被捕了！"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "当！"

#: scripts/armas.gd
msgid "Durabilidad: %d"
msgstr "耐久：%d"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "挥击范围加长加宽 %d%%"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "弹匣扩容 %d%%，换弹加快 %d%%"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d durmiente más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d durmientes más"
msgstr[0] "储罐扩容 %d%%，电弧多跳 %d 个沉睡者"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "储罐扩容 %d%%"

#: scripts/armas.gd
msgid "radio un %d %% más grande"
msgstr "半径增大 %d %%"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s：伤害 +%d%%，%s。"

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "绝活：每命中 %d 次，必有一次暴击（双倍伤害）。"

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un durmiente y siguen."
msgstr "绝活：子弹能穿透一个沉睡者继续飞。"

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d durmientes y siguen."
msgstr "绝活：子弹能穿透 %d 个沉睡者继续飞。"

#: scripts/armas.gd
msgid "Truco: los durmientes que mata revientan y pasan su efecto a los de al lado."
msgstr "绝活：被它杀死的沉睡者会爆开，把效果传给旁边的沉睡者。"

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "绝活：摔碎时向周围散落 %d 个迷你版。"

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "绝活：爆炸时向周围散落 %d 个迷你版。"

