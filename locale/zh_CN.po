# Traducción al chino simplificado de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "警戒 %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "无警戒"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "一切照旧"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"美元和零件 +%d%%"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " （外加之前的）"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "僵尸数量 +25%"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "僵尸速度加快10%"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "首领生命 +25%，而且更快暴怒"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "急救包、绷带和美西螈的治疗量减半"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "保安（或拿钥匙的僵尸）血量翻倍，僵尸也能从更远处听见你"

#: scripts/alerta.gd
msgid "Cada ordenador del código llama a dos escoltas y los zombis te oyen más lejos"
msgstr "每台存有密码的电脑都会叫来两名保镖，僵尸也能从更远处听见你"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "身后！"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "待在旁边把人扶起来"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "救命！"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "带上我！"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "我跟你一起走？"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "嘘——！"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "退后！"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "你被捕了！"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "当！"

#: scripts/armas.gd
msgid "Última partida: al acabarla, se destruye"
msgstr "最后一局：本局结束后会损坏"

#: scripts/armas.gd
msgid "Le queda %d partida más después de esta"
msgid_plural "Le quedan %d partidas más después de esta"
msgstr[0] "本局之后还能用 %d 局"

#: scripts/armas.gd
msgid "Le queda %d partida"
msgid_plural "Le quedan %d partidas"
msgstr[0] "还能用 %d 局"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "挥击范围加长加宽 %d%%"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "弹匣扩容 %d%%，换弹加快 %d%%"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "储罐扩容 %d%%，电弧多跳 %d 个僵尸"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "储罐扩容 %d%%"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "范围扩大 %d%%，每组可多带 %d 个"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s：伤害 +%d%%，%s。"

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "绝活：每命中 %d 次，必有一次暴击（双倍伤害）。"

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "绝活：子弹能穿透一个僵尸继续飞。"

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "绝活：子弹能穿透 %d 个僵尸继续飞。"

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "绝活：被它杀死的僵尸会爆开，把效果传给旁边的僵尸。"

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "绝活：摔碎时向周围散落 %d 个迷你版。"

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "绝活：爆炸时向周围散落 %d 个迷你版。"

