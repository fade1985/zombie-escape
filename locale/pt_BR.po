# Traducción al portugués de Brasil de Johnny Rush: Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Johnny Rush: Zombie Escape\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alerta %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Sem alerta"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Como sempre"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"+%d %% de dólares e peças"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (e os anteriores)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % de zumbis"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Zumbis 10 % mais rápidos"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Chefes com +25 % de vida, e se irritam mais cedo"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Kits médicos, bandagens e Axolote curam a metade"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "O guarda (ou o zumbi da chave) aguenta o dobro e os zumbis te ouvem de mais longe"

#: scripts/alerta.gd
msgid "Cada ordenador del código llama a dos escoltas y los zombis te oyen más lejos"
msgstr "Cada computador do código chama dois guarda-costas e os zumbis te ouvem de mais longe"

#: scripts/aliado.gd scripts/tornos.gd
msgid "¡Detrás!"
msgstr "Atrás de você!"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Fique por perto para ajudar a levantar"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Socorro!"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "Me leva com você!"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Posso ir junto?"

#: scripts/antidisturbios.gd
