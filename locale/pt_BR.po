# Traducción al portugués de Brasil de Zombie Escape. El español es el idioma de origen: cada «msgid» es el texto tal como está en el
# código. Los pone al día  py tools/traducciones.py  (cómo se escribe: docs/IDIOMAS.md y docs/GLOSARIO_EN.md); lo que se
# escribe a mano es cada «msgstr». Un msgstr vacío = sin traducir (en el juego se ve el español).
msgid ""
msgstr ""
"Project-Id-Version: Zombie Escape\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"


#: scripts/alerta.gd
msgid "Alerta %d"
msgstr "Alerta %d"

#: scripts/alerta.gd
msgid "Sin alerta"
msgstr "Sem alerta"

#: scripts/alerta.gd
msgid "Como siempre"
msgstr "Como sempre"

#: scripts/alerta.gd
msgid ""
"%s%s\n"
"+%d %% de dólares y de piezas"
msgstr ""
"%s%s\n"
"+%d %% de dólares e peças"

#: scripts/alerta.gd
msgid " (y lo de antes)"
msgstr " (e os anteriores)"

#: scripts/alerta.gd
msgid "+25 % de zombis"
msgstr "+25 % de zumbis"

#: scripts/alerta.gd
msgid "Zombis un 10 % más rápidos"
msgstr "Zumbis 10 % mais rápidos"

#: scripts/alerta.gd
msgid "Jefes con +25 % de vida, y se enfadan antes"
msgstr "Chefes com +25 % de vida, e se irritam mais cedo"

#: scripts/alerta.gd
msgid "Botiquines, vendas y Ajolote curan la mitad"
msgstr "Kits médicos, bandagens e Axolote curam a metade"

#: scripts/alerta.gd
msgid "El guardia (o el zombi de la llave) aguanta el doble y los zombis te oyen más lejos"
msgstr "O guarda (ou o zumbi da chave) aguenta o dobro e os zumbis te ouvem de mais longe"

#: scripts/aliado.gd
msgid "Quédate a su lado para levantarlo"
msgstr "Fique por perto para ajudar a levantar"

#: scripts/aliado.gd scripts/supervivientes.gd
msgid "¡Socorro!"
msgstr "Socorro!"

#: scripts/aliado.gd
msgid "¡Llévame contigo!"
msgstr "Me leva com você!"

#: scripts/aliado.gd
msgid "¿Te acompaño?"
msgstr "Posso ir junto?"

#: scripts/antidisturbios.gd
msgid "¡PRIIIII!"
msgstr "PRIIIII!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "PRA TRÁS!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "VOCÊ TÁ PRESO!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "CLONC!"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "golpe %d %% mais comprido e largo"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "pente %d %% maior e recarga %d %% mais rápida"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "tanque %d %% maior e a descarga pula para mais %d zumbi"
msgstr[1] "tanque %d %% maior e a descarga pula para mais %d zumbis"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "tanque %d %% maior"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "raio %d %% maior e cabem mais %d"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: dano +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Truque: a cada %d golpes que acerta, um é crítico (dano em dobro)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Truque: as balas atravessam um zumbi e seguem em frente."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Truque: as balas atravessam %d zumbis e seguem em frente."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Truque: os zumbis que ela mata explodem e passam o efeito para os do lado."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Truque: ao quebrar, solta %d menores ao redor."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Truque: ao explodir, solta %d menores ao redor."

