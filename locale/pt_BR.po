msgstr "PRIIIII!"

#: scripts/antidisturbios.gd
msgid "¡ATRÁS!"
msgstr "PRA TRÁS!"

#: scripts/antidisturbios.gd
msgid "¡QUEDAS DETENIDO!"
msgstr "VOCÊ TÁ PRESO!"

#: scripts/antidisturbios.gd
msgid "¡CLONC!"
msgstr "CLONC!"

#: scripts/armas.gd
msgid "Última partida: al acabarla, se destruye"
msgstr "Última partida: ao terminar, ela se destrói"

#: scripts/armas.gd
msgid "Le queda %d partida más después de esta"
msgid_plural "Le quedan %d partidas más después de esta"
msgstr[0] "Resta %d partida depois desta"
msgstr[1] "Restam %d partidas depois desta"

#: scripts/armas.gd
msgid "Le queda %d partida"
msgid_plural "Le quedan %d partidas"
msgstr[0] "Resta %d partida"
msgstr[1] "Restam %d partidas"

#: scripts/armas.gd
msgid "golpe un %d %% más largo y ancho"
msgstr "golpe %d %% mais comprido e largo"

#: scripts/armas.gd
msgid "cargador un %d %% más grande y recarga un %d %% más rápida"
msgstr "pente %d %% maior e recarga %d %% mais rápida"

#: scripts/armas.gd
msgid "depósito un %d %% más grande y la descarga salta a %d zombi más"
msgid_plural "depósito un %d %% más grande y la descarga salta a %d zombis más"
msgstr[0] "tanque %d %% maior e a descarga pula para mais %d zumbi"
msgstr[1] "tanque %d %% maior e a descarga pula para mais %d zumbis"

#: scripts/armas.gd
msgid "depósito un %d %% más grande"
msgstr "tanque %d %% maior"

#: scripts/armas.gd
msgid "radio un %d %% más grande y caben %d más"
msgstr "raio %d %% maior e cabem mais %d"

#: scripts/armas.gd
msgid "%s: daño +%d %%, %s."
msgstr "%s: dano +%d %%, %s."

#: scripts/armas.gd
msgid "Truco: cada %d golpes que dan, uno es crítico (doble daño)."
msgstr "Truque: a cada %d golpes que acerta, um é crítico (dano em dobro)."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a un zombi y siguen."
msgstr "Truque: as balas atravessam um zumbi e seguem em frente."

#: scripts/armas.gd
msgid "Truco: sus balas atraviesan a %d zombis y siguen."
msgstr "Truque: as balas atravessam %d zumbis e seguem em frente."

#: scripts/armas.gd
msgid "Truco: los zombis que mata revientan y pasan su efecto a los de al lado."
msgstr "Truque: os zumbis que ela mata explodem e passam o efeito para os do lado."

#: scripts/armas.gd
msgid "Truco: al romperse suelta %d más pequeños alrededor."
msgstr "Truque: ao quebrar, solta %d menores ao redor."

#: scripts/armas.gd
msgid "Truco: al explotar suelta %d más pequeños alrededor."
msgstr "Truque: ao explodir, solta %d menores ao redor."

